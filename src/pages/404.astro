---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
---
<MarketingLayout title="404 - Page Not Found" description="This page took an early return.">
  <div class="shell" style="display: flex; align-items: center; justify-content: center; min-height: 60vh;">
    <div style="text-align: center; max-width: 560px;">
      <p style="font-size: clamp(72px, 12vw, 120px); font-weight: var(--fw-display); letter-spacing: -0.044em; line-height: 1; margin: 0 0 8px; color: var(--primary-light);">404</p>
      <h1 style="font-size: clamp(24px, 4vw, 36px); letter-spacing: -0.025em; margin: 0 0 16px;">This page took an early return.</h1>
      <p style="color: var(--text-muted); margin: 0 0 32px; font-size: 16px;">
        We may have moved or renamed it during the recent docs refresh.
        Try one of these instead:
      </p>

      <ul style="list-style: none; padding: 0; margin: 0 0 32px; display: grid; gap: 10px; text-align: left;">
        <li>
          <a href="/docs/get-started/" class="btn btn-secondary" style="width: 100%; justify-content: flex-start; min-height: 52px; border-radius: 14px; padding: 0 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span style="font-weight: var(--fw-semibold);">Get Started</span>
            <span style="font-size: 13px; font-weight: var(--fw-caption); color: var(--text-muted);">Install Suites and write your first test.</span>
          </a>
        </li>
        <li>
          <a href="/docs/get-started/quickstart" class="btn btn-secondary" style="width: 100%; justify-content: flex-start; min-height: 52px; border-radius: 14px; padding: 0 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span style="font-weight: var(--fw-semibold);">Quickstart</span>
            <span style="font-size: 13px; font-weight: var(--fw-caption); color: var(--text-muted);">A minimal end-to-end example.</span>
          </a>
        </li>
        <li>
          <a href="/docs/guides/" class="btn btn-secondary" style="width: 100%; justify-content: flex-start; min-height: 52px; border-radius: 14px; padding: 0 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span style="font-weight: var(--fw-semibold);">Guides</span>
            <span style="font-size: 13px; font-weight: var(--fw-caption); color: var(--text-muted);">Solitary, sociable, test doubles, and fundamentals.</span>
          </a>
        </li>
        <li>
          <a href="/docs/api-reference/" class="btn btn-secondary" style="width: 100%; justify-content: flex-start; min-height: 52px; border-radius: 14px; padding: 0 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span style="font-weight: var(--fw-semibold);">API Reference</span>
            <span style="font-size: 13px; font-weight: var(--fw-caption); color: var(--text-muted);">TestBed, Mock, and configuration APIs.</span>
          </a>
        </li>
        <li>
          <a href="/docs/migration-guides/from-automock" class="btn btn-secondary" style="width: 100%; justify-content: flex-start; min-height: 52px; border-radius: 14px; padding: 0 18px; display: flex; flex-direction: column; align-items: flex-start; gap: 2px;">
            <span style="font-weight: var(--fw-semibold);">Migrating from Automock</span>
            <span style="font-size: 13px; font-weight: var(--fw-caption); color: var(--text-muted);">Move an existing Automock setup to Suites.</span>
          </a>
        </li>
      </ul>

      <p style="color: var(--text-muted); font-size: 14px; margin: 0;">
        Still stuck? <a href="/" style="color: var(--text);">Go to the homepage</a> or{' '}
        <a href="https://github.com/suites-dev/suites/issues" target="_blank" rel="noopener noreferrer" style="color: var(--text);">open an issue on GitHub</a>.
      </p>
    </div>
  </div>
</MarketingLayout>

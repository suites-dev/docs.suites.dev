---
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import LovableHomepage from '@/components/home/LovableHomepage.astro';
import LovableTechnicalFigure from '@/components/home/LovableTechnicalFigure.astro';
import { Code } from 'astro-expressive-code/components';

const unitCode = `import { TestBed } from '@suites/unit';
import { OrderService } from './order.service';
import { PaymentGateway } from './payment.gateway';

const { unit, unitRef } = await TestBed
  .solitary(OrderService)
  .compile();

const payments = unitRef.get(PaymentGateway);
payments.authorize.mockResolvedValue({ approved: true });

await unit.placeOrder(order);

expect(payments.authorize).toHaveBeenCalled();`;

const unitIntegrations = ['NestJS', 'InversifyJS', 'Jest', 'Vitest', 'Sinon'];
const blackboxIntegrations = ['Playwright', 'Node.js', 'Docker', 'Postgres', 'HTTP', 'Queues'];

const projectLinks = [
  {
    label: 'Source code',
    description: 'Public Suites repositories.',
    href: 'https://github.com/suites-dev',
  },
  {
    label: 'Runnable examples',
    description: 'Working TypeScript projects.',
    href: 'https://github.com/suites-dev/examples',
  },
  {
    label: 'Unit issues',
    description: 'Bugs and improvements for Unit.',
    href: 'https://github.com/suites-dev/suites/issues',
  },
  {
    label: 'Unit discussions',
    description: 'Questions and design discussions.',
    href: 'https://github.com/suites-dev/suites/discussions',
  },
  {
    label: 'Contributing to Unit',
    description: 'Contribution workflow and requirements.',
    href: 'https://github.com/suites-dev/suites/blob/master/CONTRIBUTING.md',
  },
  {
    label: 'Apache 2.0 license',
    description: 'The license used by the project.',
    href: 'https://github.com/suites-dev/suites/blob/master/LICENSE',
  },
];
---

<MarketingLayout
  title="Homepage"
  description="Project Suites is building an open-source verification path for coding agents, from white-box checks close to the code to black-box evidence from running systems."
  showHeader={false}
>
  <LovableHomepage />

  <div class="home">
    <section id="tools" class="verification-register" aria-label="Suites verification tools">
      <div class="verification-register__labels" aria-hidden="true">
        <span></span>
        <span>Tool</span>
        <span>Boundary</span>
        <span>Evidence</span>
        <span></span>
      </div>

      <nav class="verification-register__rows" aria-label="Verification available in Suites">
        <a
          href="#unit-title"
          aria-label="Suites Unit, stable. Class and dependencies. Typed doubles and behavior assertions."
        >
          <span class="verification-register__index" aria-hidden="true">01</span>
          <span class="verification-register__package">
            <code>@suites/unit</code>
            <small><i aria-hidden="true"></i>stable</small>
          </span>
          <span class="verification-register__boundary">Class and dependencies</span>
          <span class="verification-register__evidence">Typed doubles and behavior assertions</span>
          <span class="verification-register__arrow" aria-hidden="true">→</span>
        </a>

        <a
          href="#blackbox-title"
          aria-label="Suites Blackbox, alpha. Running system. Required and forbidden runtime effects."
        >
          <span class="verification-register__index" aria-hidden="true">02</span>
          <span class="verification-register__package">
            <code>@suites/blackbox</code>
            <small class="is-alpha"><i aria-hidden="true"></i>alpha</small>
          </span>
          <span class="verification-register__boundary">Running system</span>
          <span class="verification-register__evidence">Required and forbidden runtime effects</span>
          <span class="verification-register__arrow" aria-hidden="true">→</span>
        </a>
      </nav>
    </section>

    <LovableTechnicalFigure />

    <section class="tools-section" aria-label="Suites tools">
      <article class="tool tool--unit" aria-labelledby="unit-title">
        <div class="tool-copy">
          <header class="tool-header">
            <div class="package-line">
              <code>@suites/unit</code>
              <span class="status status--stable">stable</span>
            </div>
            <h2 id="unit-title">Suites Unit</h2>
          </header>

          <p>
            <code>@suites/unit</code> creates <strong>solitary tests</strong>, where all
            dependencies are mocked, or sociable test environments for supported
            DI-based TypeScript frameworks. It provides typed doubles for Jest,
            Vitest, and Sinon.
          </p>

          <p class="install-line">
            <span>Install</span>
            <code>npm install -D @suites/unit</code>
          </p>

          <div class="compatibility">
            <span>Integrates with</span>
            <ul>
              {unitIntegrations.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <nav class="tool-links" aria-label="Suites Unit resources">
            <a href="/docs/get-started/quickstart">Quickstart <span aria-hidden="true">→</span></a>
            <a href="/docs/get-started/installation">Installation <span aria-hidden="true">→</span></a>
            <a href="/docs/api-reference/">API reference <span aria-hidden="true">→</span></a>
            <a href="https://github.com/suites-dev/examples" target="_blank" rel="noopener noreferrer">
              Examples <span aria-hidden="true">↗</span>
            </a>
          </nav>
        </div>

        <div class="artifact artifact--code" role="group" aria-labelledby="unit-example-title">
          <div class="artifact-titlebar">
            <span id="unit-example-title">order.service.spec.ts</span>
            <code>@suites/unit</code>
          </div>
          <Code code={unitCode} lang="ts" />
        </div>
      </article>

      <article class="tool tool--blackbox" aria-labelledby="blackbox-title">
        <div class="tool-copy">
          <header class="tool-header">
            <div class="package-line">
              <code>@suites/blackbox</code>
              <span class="status status--alpha">alpha</span>
            </div>
            <h2 id="blackbox-title">Suites Blackbox</h2>
          </header>

          <p>
            <code>@suites/blackbox</code> adds runtime evidence to Playwright system
            tests. It reports whether required and forbidden effects match the
            behavior approved for a flow.
          </p>

          <p class="install-line">
            <span>Install</span>
            <code>pnpm add -D @suites/blackbox @suites/blackbox-cli @playwright/test</code>
          </p>

          <p class="alpha-note">
            Blackbox is in alpha. Its public packages and APIs may change before a
            stable release.
          </p>

          <div class="compatibility">
            <span>Current scope</span>
            <ul>
              {blackboxIntegrations.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <nav class="tool-links" aria-label="Suites Blackbox resources">
            <a href="/docs/blackbox/overview/what-is-blackbox">Overview <span aria-hidden="true">→</span></a>
            <a href="/docs/blackbox/quickstart/">Quickstart <span aria-hidden="true">→</span></a>
            <a href="/docs/blackbox/overview/how-blackbox-works">How it works <span aria-hidden="true">→</span></a>
            <a href="/docs/blackbox/reference/cli">CLI reference <span aria-hidden="true">→</span></a>
          </nav>
        </div>

        <figure class="artifact artifact--finding">
          <figcaption class="sr-only">Example Suites Blackbox finding</figcaption>
          <div class="artifact-titlebar">
            <span>Example output · subscribe-user / attempt 01</span>
            <code>blackbox test</code>
          </div>
          <div class="finding-body">
            <div class="finding-summary">
              <div>
                <span>Tests</span>
                <strong class="pass">PASS</strong>
              </div>
              <div>
                <span>Integrity</span>
                <strong class="pass">PASS</strong>
              </div>
              <div>
                <span>Effects</span>
                <strong class="fail">FAIL</strong>
              </div>
            </div>

            <div class="effect-list" aria-label="Effect findings">
              <div class="effect-row">
                <span class="effect-mark pass" aria-hidden="true">+</span>
                <span>
                  <small>required effect observed</small>
                  <code>database.users.find(&lbrace; id: "ghost" &rbrace;)</code>
                </span>
              </div>
              <div class="effect-row">
                <span class="effect-mark fail" aria-hidden="true">!</span>
                <span>
                  <small>forbidden effect observed</small>
                  <code>http.payment-provider.authorize()</code>
                </span>
              </div>
            </div>

            <p class="finding-message">
              The response assertion passed, but the flow produced an effect it
              was not allowed to produce.
            </p>
          </div>
        </figure>
      </article>
    </section>

    <section class="project-section" aria-labelledby="project-title">
      <header class="project-intro">
        <h2 id="project-title">Project</h2>
        <p>Suites is developed in the open under Apache 2.0.</p>
      </header>

      <nav class="project-directory" aria-label="Suites project links">
        {projectLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer">
            <span>
              <strong>{link.label}</strong>
              <small>{link.description}</small>
            </span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </nav>
    </section>
  </div>
</MarketingLayout>

<style>
  :global(body:has([data-lovable-homepage])) {
    background: var(--background);
  }

  .home {
    width: min(100%, 1200px);
    margin: 0 auto;
    padding: 0 24px 96px;
  }

  .verification-register {
    position: relative;
    z-index: 1;
    padding: clamp(80px, 8vw, 112px) 0 96px;
  }

  .verification-register__labels,
  .verification-register__rows a {
    display: grid;
    grid-template-columns: 32px minmax(210px, 0.72fr) minmax(170px, 0.54fr) minmax(260px, 1fr) 24px;
    align-items: center;
    gap: 24px;
  }

  .verification-register__labels {
    min-height: 32px;
    padding-bottom: 10px;
    color: var(--text-soft);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-code);
    font-size: 0.58rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .verification-register__rows a {
    min-height: 88px;
    padding-block: 18px;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .verification-register__rows a:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 6px;
  }

  .verification-register__index,
  .verification-register__package,
  .verification-register__package small {
    font-family: var(--font-code);
  }

  .verification-register__index {
    color: var(--text-soft);
    font-size: 0.67rem;
  }

  .verification-register__package {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
  }

  .verification-register__package code {
    overflow: hidden;
    color: var(--text);
    font-size: 0.78rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .verification-register__package small {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 7px;
    color: var(--text-muted);
    font-size: 0.59rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .verification-register__package small i {
    width: 5px;
    height: 5px;
    background: var(--success);
    border-radius: 50%;
  }

  .verification-register__package small.is-alpha i {
    background: var(--primary);
  }

  .verification-register__boundary {
    color: var(--text);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .verification-register__evidence {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .verification-register__arrow {
    color: var(--text-soft);
    font-size: 1rem;
    transition:
      color 180ms ease-out,
      transform 180ms ease-out;
  }

  @media (hover: hover) {
    .verification-register__rows a:hover .verification-register__package code,
    .verification-register__rows a:hover .verification-register__arrow {
      color: var(--primary);
    }

    .verification-register__rows a:hover .verification-register__arrow {
      transform: translateX(3px);
    }
  }

  .tools-section {
    padding-top: 72px;
  }

  .project-intro {
    max-width: 620px;
    padding-bottom: 42px;
  }

  .project-intro h2,
  .tool-header h2 {
    margin-bottom: 10px;
    color: var(--text);
    font-size: clamp(28px, 4vw, 38px);
    font-weight: var(--fw-semibold);
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .project-intro > p:last-child,
  .tool-copy > p {
    margin-bottom: 0;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .tool {
    display: grid;
    gap: clamp(48px, 5vw, 80px);
    align-items: center;
    justify-content: space-between;
    padding: 88px 0;
  }

  .tool--unit {
    grid-template-columns: minmax(300px, 620px) minmax(400px, 720px);
  }

  .tool--blackbox {
    grid-template-columns: minmax(300px, 620px) minmax(400px, 720px);
  }

  .tool--blackbox .tool-copy {
    grid-column: 1;
  }

  .tool--blackbox .artifact {
    grid-column: 2;
    grid-row: 1;
  }

  .tool + .tool {
    border-top: 1px solid var(--border);
  }

  .tool-header {
    margin-bottom: 20px;
  }

  .package-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .package-line > code {
    color: var(--text-muted);
    font-family: var(--font-code);
    font-size: 12px;
  }

  .status {
    display: inline-flex;
    min-height: 22px;
    align-items: center;
    padding: 2px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-code);
    font-size: 9px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .status--stable {
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.035);
  }

  .status--alpha {
    color: var(--primary-light);
    background: var(--primary-soft);
    border-color: var(--primary-border);
  }

  :global(:root[data-theme='light']) .status--stable {
    background: rgba(15, 15, 18, 0.035);
  }

  :global(:root[data-theme='light']) .status--alpha {
    color: var(--primary-dark);
  }

  .tool-copy > p code {
    color: var(--code-text);
    font-family: var(--font-code);
    font-size: 0.9em;
  }

  .tool-copy strong {
    color: var(--text);
    font-weight: var(--fw-semibold);
  }

  .install-line {
    display: grid;
    gap: 8px;
    margin-top: 24px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.018);
  }

  :global(:root[data-theme='light']) .install-line {
    background: rgba(15, 15, 18, 0.018);
  }

  .install-line span,
  .compatibility > span {
    color: var(--text-soft);
    font-family: var(--font-code);
    font-size: 10px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .install-line code {
    overflow-wrap: anywhere;
    color: var(--code-text);
    font-family: var(--font-code);
    font-size: 12px;
    line-height: 1.55;
  }

  .alpha-note {
    margin-top: 16px;
    padding-left: 14px;
    border-left: 2px solid var(--primary-border);
    font-size: 13px !important;
  }

  .compatibility {
    display: grid;
    gap: 10px;
    margin-top: 24px;
  }

  .compatibility ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .compatibility li {
    color: var(--text-muted);
    font-family: var(--font-code);
    font-size: 11px;
  }

  .tool-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 32px;
    border-top: 1px solid var(--border);
  }

  .tool-links a {
    display: flex;
    min-height: 46px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    font-family: var(--font-code);
    font-size: 10px;
    letter-spacing: 0.015em;
    text-decoration: none;
    transition: color 180ms ease-out;
  }

  .tool-links a:nth-child(odd) {
    padding-right: 18px;
  }

  .tool-links a:nth-child(even) {
    padding-left: 18px;
    border-left: 1px solid var(--border);
  }

  .tool-links a span {
    color: var(--text-soft);
    transition: transform 180ms ease-out;
  }

  @media (hover: hover) {
    .tool-links a:hover {
      color: var(--text);
    }

    .tool-links a:hover span {
      transform: translateX(3px);
    }
  }

  .artifact {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    background: var(--code-bg);
  }

  .artifact-titlebar {
    display: flex;
    min-height: 40px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text-soft);
    font-family: var(--font-code);
    font-size: 10px;
  }

  .artifact-titlebar code {
    color: var(--text-muted);
    font-family: inherit;
  }

  .artifact--code :global(.expressive-code) {
    margin: 0;
  }

  .artifact--code :global(.expressive-code figure) {
    margin: 0;
    border: 0;
    border-radius: 0;
  }

  .artifact--code :global(.expressive-code .frame) {
    box-shadow: none;
  }

  .artifact--code :global(.expressive-code .header) {
    display: none;
  }

  .artifact--code :global(.expressive-code pre) {
    max-height: none;
    padding-block: 22px;
    border: 0;
    border-radius: 0;
    font-size: 12px;
  }

  .finding-body {
    padding: 18px;
    font-family: var(--font-code);
  }

  .finding-summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-bottom: 18px;
    border: 1px solid var(--border);
    border-radius: 4px;
  }

  .finding-summary > div {
    display: grid;
    gap: 7px;
    padding: 12px;
  }

  .finding-summary > div + div {
    border-left: 1px solid var(--border);
  }

  .finding-summary span,
  .effect-row small {
    color: var(--text-soft);
    font-size: 9px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .finding-summary strong {
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .pass {
    color: var(--success);
  }

  .fail {
    color: var(--error);
  }

  .effect-list {
    display: grid;
  }

  .effect-row {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 10px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }

  .effect-row > span:last-child {
    display: grid;
    min-width: 0;
    gap: 6px;
  }

  .effect-row code {
    overflow-wrap: anywhere;
    color: var(--code-text);
    font-family: inherit;
    font-size: 11px;
  }

  .effect-mark {
    font-size: 13px;
    font-weight: var(--fw-semibold);
  }

  .finding-message {
    margin: 10px 0 0;
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.6;
  }

  .project-section {
    padding: 84px 0 0;
  }

  .project-directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 48px;
    border-top: 1px solid var(--border);
  }

  .project-directory a {
    display: flex;
    min-height: 84px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
  }

  .project-directory a > span:first-child {
    display: grid;
    gap: 8px;
  }

  .project-directory strong {
    color: var(--text);
    font-size: 14px;
    font-weight: var(--fw-semibold);
  }

  .project-directory small {
    color: var(--text-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .project-directory a > span:last-child {
    color: var(--text-soft);
    font-size: 12px;
    transition:
      color 180ms ease-out,
      transform 180ms ease-out;
  }

  @media (hover: hover) {
    .project-directory a:hover strong,
    .project-directory a:hover > span:last-child {
      color: var(--primary);
    }

    .project-directory a:hover > span:last-child {
      transform: translate(2px, -2px);
    }
  }

  @media (max-width: 1050px) {
    .tools-section,
    .project-section {
      padding-top: 64px;
    }

    .tool {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 64px 0;
    }

    .tool--blackbox .tool-copy,
    .tool--blackbox .artifact {
      grid-column: 1;
    }

    .tool--blackbox .tool-copy {
      grid-row: 1;
    }

    .tool--blackbox .artifact {
      grid-row: 2;
    }

  }

  @media (max-width: 860px) {
    .verification-register__labels {
      display: none;
    }

    .verification-register__rows {
      border-top: 1px solid var(--border);
    }

    .verification-register__rows a {
      grid-template-columns: 32px minmax(210px, 0.8fr) minmax(0, 1fr) 24px;
      gap: 12px 20px;
      padding-block: 20px;
    }

    .verification-register__evidence {
      grid-column: 2 / 4;
      grid-row: 2;
    }

    .verification-register__arrow {
      grid-column: 4;
      grid-row: 1;
    }
  }

  @media (max-width: 620px) {
    .home {
      padding-bottom: 72px;
      padding-right: 16px;
      padding-left: 16px;
    }

    .verification-register {
      padding: 56px 0 72px;
    }

    .verification-register__rows a {
      min-height: 0;
      grid-template-columns: minmax(0, 1fr) 20px;
      gap: 10px 16px;
      padding-block: 22px;
    }

    .verification-register__index {
      display: none;
    }

    .verification-register__package {
      grid-column: 1;
    }

    .verification-register__boundary {
      grid-column: 1;
      grid-row: 2;
    }

    .verification-register__evidence {
      grid-column: 1 / -1;
      grid-row: 3;
    }


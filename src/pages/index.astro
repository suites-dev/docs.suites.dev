---
/** Unit-only homepage. */
import MarketingLayout from '@/layouts/MarketingLayout.astro';
import Tabs from '@/components/mdx/Tabs.astro';
import TabItem from '@/components/mdx/TabItem.astro';
import { Code } from 'astro-expressive-code/components';

const withSuites = `import { TestBed, type Mocked } from '@suites/unit';

describe('User Service', () => {
  let userService: UserService; // The unit we are testing
  let userApi: Mocked<UserApi>; // The dependencies we are mocking
  let database: Mocked<Database>;

  beforeAll(async () => {
    // Create an isolated test env for the unit
    const { unit, unitRef } = await TestBed.solitary(UserService).compile();

    userService = unit;
    // Retrieve the unit's dependency mocks - automatically generated
    userApi = unitRef.get(UserApi);
    database = unitRef.get(Database);
  });

  // \u2705 Test test test
  it('should generate a random user and save to the database', async () => {
    userApi.getRandom.mockResolvedValue({id: 1, name: 'John'} as User);
    await userService.generateRandomUser();
    expect(database.saveUser).toHaveBeenCalledWith(userFixture);
  });
});`;

const withoutSuites = `// THE MANUAL WAY
// (Similar complexity exists in NestJS, InversifyJS, etc.)

import { UserService } from './user-service';
import { UserApi } from './user-api';
import { Database } from './database';

describe('User Service', () => {
  let userService: UserService;
  let userApi: any; // \u274c Lost type safety!
  let database: any;

  beforeAll(async () => {
    // \ud83d\udd27 Manually create mocks for each dependency
    userApi = {
      getRandom: jest.fn(),
      // Missing methods? Who knows? No compile-time checks!
    };

    database = {
      saveUser: jest.fn(),
      // What other methods exist? \u00af\\_(\u30c4)_/\u00af
    };

    // Manual wiring - boilerplate for every test
    userService = new UserService(userApi, database);
  });

  it('should generate a random user and save to the database', async () => {
    userApi.getRandom.mockResolvedValue({id: 1, name: 'John'} as User);
    await userService.generateRandomUser();
    expect(database.saveUser).toHaveBeenCalledWith(userFixture);
  });
}`;

const frameworks = `// Same pattern works everywhere
// NestJS, InversifyJS, TSyringe...

TestBed.solitary(OrderService).compile();

// Or test with real dependencies
TestBed.sociable(OrderService)
  .expose(PaymentProcessor)
  .compile();`;

const intent = `// One line creates the entire test environment
const { unit, unitRef } = await TestBed
  .solitary(UserService)
  .compile();

// Just test the logic
const userApi = unitRef.get(UserApi);
userApi.getRandom.mockResolvedValue(user);
await unit.generateRandomUser();`;

const typeSafe = `// No manual mocks needed!
const { unit, unitRef } = await TestBed
  .solitary(UserService)
  .compile();

// Fully-typed mocks, automatically generated
const userApi = unitRef.get(UserApi);

userApi.get.mockResolvedValue({ name: 'John' });`;

const aiFirst = `// Manual: 40+ lines per test in AI context
// class MockUserApi { getRandom = jest.fn(); ... }
// class MockDatabase { saveUser = jest.fn(); ... }
// const userService = new UserService(mockUserApi, mockDb);

// Suites: Single canonical pattern
const { unit, unitRef } = await TestBed
  .solitary(UserService)
  .compile();

// AI agents learn the entire API from one example`;

---

<MarketingLayout
  title="Suites | Unit Testing Framework"
  description="Suites is a unit testing framework for TypeScript backends working with inversion of control and dependency injection"
>
  <div class="home workbench">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-shell">
        <h1 id="home-title" class="hero-title">Project Suites</h1>
        <p class="hero-lede">
          A unit testing framework for TypeScript backends working with
          inversion of control and dependency injection.
        </p>

        <nav class="hero-actions" aria-label="Get started with Suites">
          <a class="cta cta--primary" href="/docs/get-started/" data-track="read_the_docs">Read the Docs</a>
          <a
            class="cta cta--icon"
            href="https://github.com/suites-dev/suites"
            target="_blank"
            rel="noopener noreferrer"
            data-track="github"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
              <path
                fill="currentColor"
                d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.55v-2.02c-3.2.7-3.88-1.4-3.88-1.4-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.78 2.7 1.27 3.36.97.1-.75.4-1.27.73-1.56-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.36.78 1.06.78 2.14v3.17c0 .3.2.66.8.55A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z"
              />
            </svg>
            <span>GitHub</span>
          </a>
        </nav>
      </div>
    </section>

    <section class="compare" aria-labelledby="comparison-title">
      <div class="rule-head">
        <h2 id="comparison-title" class="rule-title">Suites compared with manual mocking</h2>
      </div>

      <div class="compare-tray">
        <Tabs groupId="suites-comparison" label="Compare Suites with manual mocking">
          <TabItem value="with-suites" label="With Suites" default>
            <Code code={withSuites} lang="ts" />
          </TabItem>
          <TabItem value="without-suites" label="Without Suites">
            <Code code={withoutSuites} lang="ts" />
          </TabItem>
        </Tabs>
      </div>
    </section>

    <div class="capabilities">

      <section class="cap" aria-labelledby="cap-standards">
        <header class="cap-heading">
          <span class="cap-index" aria-hidden="true">01</span>
          <h2 id="cap-standards">Standardized Testing Across Teams</h2>
        </header>
        <div class="cap-copy">
          <p>
            Stop relearning test patterns on every project. Suites provides a
            consistent, standardized approach that works identically across
            NestJS, InversifyJS, and any DI framework, giving teams a unified
            testing experience.
          </p>
          <a class="cap-link" href="/docs/get-started/why-suites/#3-inconsistent-patterns-across-teams">
            See framework support <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="cap-code"><Code code={frameworks} lang="ts" /></div>
      </section>

      <section class="cap" aria-labelledby="cap-intent">
        <header class="cap-heading">
          <span class="cap-index" aria-hidden="true">02</span>
          <h2 id="cap-intent">Tests That Reveal Intent, Not Boilerplate</h2>
        </header>
        <div class="cap-copy">
          <p>
            Suites' declarative API removes 90% of test setup code. No more
            scrolling through mock wiring, logic is front and center. New team
            members write tests on day one, not day ten.
          </p>
          <a class="cap-link" href="/docs/get-started/quickstart/">
            See quick start <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="cap-code"><Code code={intent} lang="ts" /></div>
      </section>

      <section class="cap" aria-labelledby="cap-types">
        <header class="cap-heading">
          <span class="cap-index" aria-hidden="true">03</span>
          <h2 id="cap-types">Type-Safe, Automatic Mocking</h2>
        </header>
        <div class="cap-copy">
          <p>
            No more debugging broken mocks. Suites automatically generates
            fully-typed mocks bound to implementation. Catch errors at compile
            time, not runtime. Refactor with confidence while mocks stay valid
            when dependencies change.
          </p>
          <a class="cap-link" href="/docs/guides/test-doubles/">
            Learn about mocking <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="cap-code"><Code code={typeSafe} lang="ts" /></div>
      </section>

      <section class="cap" aria-labelledby="cap-ai">
        <header class="cap-heading">
          <span class="cap-index" aria-hidden="true">04</span>
          <h2 id="cap-ai">Built for AI-First Development</h2>
        </header>
        <div class="cap-copy">
          <p>
            Manual mocking forces AI agents to hold 40+ lines of boilerplate per
            test in context. Suites provides one canonical pattern that reduces
            token consumption by 95%. AI coding assistants like Claude Code,
            Cursor, and GitHub Copilot generate accurate tests in a single pass
            without burning tokens on repetitive setup code.
          </p>
          <a class="cap-link" href="/docs/get-started/why-suites/#2-excessive-boilerplate-obscures-test-intent-and-confuses-llms">
            Suites and AI <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="cap-code"><Code code={aiFirst} lang="ts" /></div>
      </section>
    </div>
  </div>
</MarketingLayout>

<script>
  // The Docusaurus homepage tracked these clicks through trackButtonClick.
  // Importing the util installs its window shim; the listener keeps the
  // markup free of inline handlers.
  import { trackButtonClick } from '@/utils/analytics';

  document.querySelectorAll<HTMLElement>('[data-track]').forEach((el) => {
    el.addEventListener('click', () => {
      trackButtonClick(el.dataset.track as string, 'homepage_hero');
    });
  });
</script>

<style>
  .workbench {
    --bench-radius: 8px;
    --bench-gap: clamp(24px, 4vw, 56px);
    width: min(100%, 1200px);
    padding: 0 var(--ui-gutter) clamp(64px, 8vw, 112px);
    margin-inline: auto;
  }

  .home-hero {
    display: flex;
    align-items: center;
    padding-block: clamp(72px, 8vw, 112px);
  }

  .hero-shell {
    width: min(100%, 880px);
    padding-inline-start: clamp(24px, 4vw, 48px);
    border-inline-start: 3px solid var(--primary);
  }

  .hero-title {
    margin: 0 0 24px;
    font-family: var(--font-title);
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: var(--fw-semibold);
    line-height: 1.06;
    letter-spacing: -0.045em;
    color: var(--text);
  }

  .hero-lede {
    max-width: 760px;
    margin: 0 0 36px;
    font-size: clamp(1.25rem, 2.4vw, 1.875rem);
    line-height: 1.5;
    letter-spacing: -0.02em;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 12px 24px;
    border: 1px solid var(--control-border);
    border-radius: 6px;
    background: var(--bg);
    color: var(--text);
    font-size: 0.9375rem;
    font-weight: var(--fw-semibold);
    text-decoration: none;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .cta--primary {
    background: var(--primary);
    border-color: var(--primary);
    color: var(--on-primary);
  }

  .compare {
    border: 1px solid var(--border-strong);
    border-radius: var(--bench-radius);
    background: var(--bg-subtle);
    margin-bottom: clamp(64px, 8vw, 104px);
    min-width: 0;
  }

  .rule-head {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 26px 28px;
    border-bottom: 1px solid var(--border);
  }

  .rule-title {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1.25rem, 2.5vw, 1.875rem);
    font-weight: var(--fw-semibold);
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: balance;
  }

  .compare-tray {
    padding: 20px;
    min-width: 0;
  }

  .compare-tray :global(.tabs) {
    display: flex;
    width: fit-content;
    max-width: 100%;
    gap: 4px;
    padding: 4px;
    border-radius: 6px;
    background: var(--surface-raised);
    border: 1px solid var(--border);
  }

  .compare-tray :global(.tab) {
    min-height: 44px;
    padding: 10px 20px;
    border-radius: 4px;
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: var(--fw-medium);
    color: var(--text-muted);
    cursor: pointer;
  }

  .compare-tray :global(.tab[aria-selected='true']) {
    background: var(--bg);
    color: var(--text);
    border-color: var(--border-strong);
    box-shadow: inset 0 -2px 0 var(--primary);
  }

  .compare-tray :global(.tabs-panels) {
    margin-top: 16px;
  }

  .compare-tray :global(.expressive-code),
  .cap-code :global(.expressive-code) {
    margin: 0;
    min-width: 0;
    max-width: 100%;
  }

  .compare-tray :global(pre),
  .cap-code :global(pre) {
    max-height: none;
    font-size: 0.8125rem;
    line-height: 1.75;
    border-radius: 6px;
  }

  .capabilities {
    border-top: 1px solid var(--border-strong);
  }

  .cap {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.85fr);
    column-gap: var(--bench-gap);
    row-gap: 30px;
    padding-block: 48px 56px;
    border-bottom: 1px solid var(--border-strong);
  }

  .cap-heading {
    display: flex;
    align-items: baseline;
    gap: 20px;
    grid-column: 1 / -1;
    min-width: 0;
  }

  .cap-index {
    flex: 0 0 38px;
    color: var(--primary-light);
    font-family: var(--font-code);
    font-size: 0.8125rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .cap h2 {
    margin: 0;
    max-width: 46rem;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: var(--fw-semibold);
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--text);
    text-wrap: balance;
  }

  .cap-copy {
    grid-column: 2;
    grid-row: 2;
    min-width: 0;
    padding-top: 8px;
  }

  .cap p {
    margin: 0 0 20px;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .cap-code {
    grid-column: 1;
    grid-row: 2;
    align-self: start;
    min-width: 0;
    padding: 8px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--bench-radius);
  }

  .cap-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    max-width: 100%;
    gap: 20px;
    padding: 8px 0;
    color: var(--primary-light);
    font-size: 0.9375rem;
    font-weight: var(--fw-medium);
    text-decoration: none;
    border-bottom: 1px solid var(--primary-border);
  }

  .cap-link span {
    flex-shrink: 0;
    transition: transform 180ms ease;
  }

  .cta:focus-visible,
  .cap-link:focus-visible,
  .compare-tray :global(.tab:focus-visible) {
    outline: 2px solid var(--primary-light);
    outline-offset: 4px;
  }

  @media (hover: hover) {
    .cta:hover {
      border-color: var(--primary-light);
      background: var(--surface-hover);
    }

    .cta--primary:hover {
      background: var(--primary-hover);
      color: var(--on-primary-hover);
    }

    .cap-link:hover {
      border-color: var(--primary-light);
    }

    .cap-link:hover span {
      transform: translateX(3px);
    }
  }

  @media (max-width: 900px) {
    .cap {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 24px;
    }

    .cap-copy,
    .cap-code {
      grid-column: 1;
      grid-row: auto;
    }

    .cap-copy {
      max-width: 42rem;
      padding-top: 0;
    }
  }

  @media (max-width: 600px) {
    .home-hero {
      padding-block: 64px;
    }

    .hero-shell {
      padding-inline-start: 20px;
    }

    .hero-title {
      font-size: clamp(2rem, 8vw, 2.5rem);
    }

    .hero-lede {
      font-size: 1.25rem;
      margin-bottom: 28px;
    }

    .hero-actions {
      gap: 10px;
    }

    .cta {
      padding-inline: 16px;
    }

    .rule-head {
      padding: 20px 16px;
      align-items: flex-start;
      gap: 12px;
    }

    .compare-tray {
      padding: 12px;
    }

    .compare-tray :global(.tabs) {
      width: 100%;
    }

    .compare-tray :global(.tab) {
      flex: 1;
      padding-inline: 8px;
      font-size: 0.8125rem;
    }

    .cap {
      padding-block: 36px 40px;
    }

    .cap-heading {
      gap: 12px;
    }

    .cap-index {
      flex-basis: 24px;
    }

    .cap-code {
      padding: 4px;
    }
  }

  @media (max-width: 360px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .cap-link span {
      transition: none;
    }

    .cap-link:hover span {
      transform: none;
    }
  }
</style>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import OverviewDiagram from '@/components/blackbox/OverviewDiagram.astro';
import CodeFirstBddDiagram from '@/components/blackbox/CodeFirstBddDiagram.astro';
---

<BaseLayout
  title="Blackbox Runtime Evidence For Review"
  description="A temporary live-demo deck for Suites Blackbox: runtime-effect evidence inside a developer review workflow."
  showFooter={false}
>
  <div class="baz-page">
    <header class="deck-topbar" aria-label="Deck navigation">
      <a class="brand" href="/">
        <img src="/img/logo.svg" alt="" />
        <span>Suites</span>
      </a>
      <nav class="slide-dots" aria-label="Slides">
        <a href="#intro" class="slide-dot" data-slide-dot="1"><span>1</span> Intro</a>
        <a href="#suites" class="slide-dot" data-slide-dot="2"><span>2</span> Suites</a>
        <a href="#sdlc-problem" class="slide-dot" data-slide-dot="3"><span>3</span> SDLC</a>
        <a href="#evidence-gap" class="slide-dot" data-slide-dot="4"><span>4</span> Gap</a>
        <a href="#blackbox" class="slide-dot" data-slide-dot="5"><span>5</span> Blackbox</a>
        <a href="#demo" class="slide-dot" data-slide-dot="6"><span>6</span> Demo</a>
        <a href="#feature-files" class="slide-dot" data-slide-dot="7"><span>7</span> Feature Files</a>
        <a href="#agentic-flow" class="slide-dot" data-slide-dot="8"><span>8</span> Agentic Flow</a>
        <a href="#environments" class="slide-dot" data-slide-dot="9"><span>9</span> Environments</a>
        <a href="#test-dependency" class="slide-dot" data-slide-dot="10"><span>10</span> Constraints</a>
      </nav>
    </header>

    <div class="deck-shell">
      <main class="slides" id="main">
        <section class="slide slide-intro" id="intro" data-slide="1" aria-label="Omer introduction">
          <div class="slide-copy">
            <p class="eyebrow">Slide 1 / Intro</p>
            <h1>I build testing tools for TypeScript backend teams.</h1>
            <p class="lead">
              I am Omer Morad, creator and maintainer of Suites. This session is about the next layer I am building:
              runtime evidence for system behavior, aimed at the review and delivery loop.
            </p>
          </div>

          <div class="slide-visual suites-visual" aria-label="Suites project snapshot">
            <div class="snapshot-card snapshot-main">
              <span class="snapshot-label">Speaker</span>
              <h3>Omer Morad</h3>
              <p>Maintainer of Suites and builder of a new runtime evidence layer for backend system verification.</p>
            </div>
          </div>
        </section>

        <section class="slide" id="suites" data-slide="2" aria-label="What Suites has been until now">
          <div class="slide-copy">
            <p class="eyebrow">Slide 2 / Suites until now</p>
            <h2>Suites until now.</h2>
            <p class="lead">
              Suites made whitebox unit tests easier for TypeScript backend services. But whitebox confidence is
              collapsing as the only review signal under the throughput of generated code.
            </p>
          </div>

          <div class="slide-visual suites-visual" aria-label="Suites lean project snapshot">
            <div class="snapshot-card snapshot-main">
              <span class="snapshot-label">Open source</span>
              <h3>Suites Unit</h3>
              <p>Typed mocks and repeatable setup for dependency-injection-heavy services.</p>
            </div>
            <div class="snapshot-metrics" aria-label="Suites metrics">
              <div>
                <strong>
                  <svg class="metric-icon metric-icon-star" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.7l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.5l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.7z"></path>
                  </svg>
                  539
                </strong>
                <span class="metric-label">GitHub stars</span>
              </div>
              <div>
                <strong>
                  <svg class="metric-icon metric-icon-npm" viewBox="0 0 56 22" aria-hidden="true">
                    <rect width="56" height="22" rx="3"></rect>
                    <path d="M8 6h40v10h-6V9h-4v7h-6V9h-4v7H8V6zm6 3v4h8V9h-8z"></path>
                  </svg>
                  ~750K
                </strong>
                <span class="metric-label">monthly downloads</span>
              </div>
            </div>
          </div>
        </section>

        <section class="slide slide-intro" id="sdlc-problem" data-slide="3" aria-label="SDLC problem">
          <div class="slide-copy">
            <p class="eyebrow">Slide 3 / SDLC problem</p>
            <h1>Agentic development makes verification the critical gate.</h1>
            <p class="lead">
              Agents can implement quickly. The harder question is whether a change really preserved behavior across the
              system boundary before it reaches merge.
            </p>
          </div>

          <div class="slide-visual baz-flow" aria-label="SDLC trust bottleneck">
            <div class="flow-card">
              <span class="flow-label">1</span>
              <h3>Spec</h3>
              <p>Intent is written in a ticket, design, or planning document.</p>
            </div>
            <div class="flow-card">
              <span class="flow-label">2</span>
              <h3>Agent change</h3>
              <p>The implementation arrives quickly and may look reasonable in the diff.</p>
            </div>
            <div class="flow-card flow-proof">
              <span class="flow-label">3</span>
              <h3>Review</h3>
              <p>The reviewer still needs to know what the running system actually did.</p>
            </div>
            <div class="flow-card">
              <span class="flow-label">4</span>
              <h3>Merge gate</h3>
              <p>The delivery decision needs evidence, not only a green visible assertion.</p>
            </div>
          </div>
        </section>

        <section class="slide" id="evidence-gap" data-slide="4" aria-label="Spec drift and missing runtime evidence">
          <div class="slide-copy">
            <p class="eyebrow">Slide 4 / Spec drift</p>
            <h2>Specs describe intent. Runtime evidence keeps them honest.</h2>
            <p class="lead">
              Spec-driven development improves planning, but the spec is usually written before implementation. After
              code changes, refactors, and agent edits, the team still needs proof that the running system matches the
              intended behavior.
            </p>
          </div>

          <div class="slide-visual spec-visual" aria-label="Spec drift and runtime evidence">
            <div class="spec-flow">
              <div class="spec-card">
                <span>1</span>
                <h3>Intent</h3>
                <p>A ticket, design, SDD spec, or feature file says what should happen.</p>
              </div>
              <div class="spec-card">
                <span>2</span>
                <h3>Implementation</h3>
                <p>A human or agent changes code, often faster than reviewers can inspect deeply.</p>
              </div>
              <div class="spec-card spec-card-accent">
                <span>3</span>
                <h3>Drift</h3>
                <p>The spec can stay readable while the running system has moved away from it.</p>
              </div>
              <div class="spec-card spec-card-good">
                <span>4</span>
                <h3>The gap</h3>
                <p>There is no shared runtime artifact tying intent, executable checks, and actual system behavior together.</p>
              </div>
            </div>
          </div>
        </section>

        <section class="slide" id="blackbox" data-slide="5" aria-label="What Suites Blackbox is">
          <div class="slide-copy">
            <p class="eyebrow">Slide 5 / What Blackbox is</p>
            <h2>Blackbox adds runtime-effect evidence to controlled system flows.</h2>
            <p class="lead">
              The goal is simple: when a test drives a real flow, Blackbox records configured effects, compares them to a
              reviewable behavior catalog, and returns evidence the reviewer can inspect.
            </p>
          </div>

          <div class="slide-visual deck-diagram">
            <OverviewDiagram kind="workflow" />
          </div>
        </section>

        <section class="slide demo-break-slide" id="demo" data-slide="6" aria-label="Demo time">
          <div class="demo-break-copy">
            <p class="eyebrow">Slide 6 / Demo time</p>
            <h1>Now let's watch a short demo.</h1>
          </div>
        </section>

        <section class="slide" id="feature-files" data-slide="7" aria-label="Feature files from executed behavior">
          <div class="slide-copy">
            <p class="eyebrow">Slide 7 / Feature files</p>
            <h2>Feature files come from executed behavior, not the other way around.</h2>
            <p class="lead">
              This is the reverse of classic feature-file-first BDD. The executable test and runtime evidence can emit a
              readable behavior file, so the spec-like artifact stays tied to code that actually runs.
            </p>
          </div>

          <div class="slide-visual deck-diagram" aria-label="System tests effects and feature files triangle">
            <CodeFirstBddDiagram kind="triangle" />
          </div>
        </section>

        <section class="slide slide-wide" id="agentic-flow" data-slide="8" aria-label="Agentic workflow">
          <div class="slide-copy">
            <p class="eyebrow">Slide 8 / Agentic workflow</p>
            <h2>In an agentic loop, evidence has to be readable by humans and agents.</h2>
          </div>

          <div class="slide-visual agent-loop-visual" aria-label="Agentic verification loop">
            <div class="agent-loop-frame">
              <svg viewBox="0 0 1260 540" role="img" aria-labelledby="agentLoopTitle agentLoopDesc">
                <title id="agentLoopTitle">Agentic implementation loop with Blackbox evidence</title>
                <desc id="agentLoopDesc">A product spec is planned and implemented, deployed to an instrumented sandbox, exercised by E2E, converted into Blackbox evidence, and reviewed for merge or another fix loop.</desc>
                <defs>
                  <marker id="agentLoopArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"></path>
                  </marker>
                  <marker id="agentLoopReturnArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#60a5fa"></path>
                  </marker>
                </defs>

                <rect class="agent-loop-surface" x="34" y="46" width="1192" height="390" rx="28"></rect>
                <rect class="agent-loop-runtime-band" x="486" y="96" width="562" height="266" rx="22"></rect>
                <text class="agent-loop-label" x="68" y="86">developer / agent work</text>
                <text class="agent-loop-label" x="512" y="130">instrumented runtime</text>

                <path class="agent-loop-arrow" d="M228 220 H268"></path>
                <path class="agent-loop-arrow" d="M452 220 H506"></path>
                <path class="agent-loop-arrow" d="M724 220 H768"></path>
                <path class="agent-loop-arrow" d="M1028 220 H1068"></path>
                <path class="agent-loop-return" d="M1142 300 C1142 456 360 456 360 312"></path>
                <text class="agent-loop-return-label" x="728" y="462" text-anchor="middle">if evidence fails, fix and run again</text>

                <g class="agent-loop-node">
                  <rect x="70" y="162" width="158" height="116" rx="14"></rect>
                  <text class="agent-loop-title" x="149" y="207" text-anchor="middle">Product spec</text>
                  <text class="agent-loop-sub" x="149" y="234" text-anchor="middle">intent and acceptance</text>
                </g>

                <g class="agent-loop-node">
                  <rect x="268" y="142" width="184" height="156" rx="14"></rect>
                  <text class="agent-loop-title" x="360" y="186" text-anchor="middle">Plan</text>
                  <text class="agent-loop-sub" x="360" y="213" text-anchor="middle">choose the change</text>
                  <line class="agent-loop-divider" x1="296" y1="232" x2="424" y2="232"></line>
                  <text class="agent-loop-title" x="360" y="266" text-anchor="middle">Implement</text>
                </g>

                <g class="agent-loop-node agent-loop-runtime-node">
                  <rect x="506" y="142" width="218" height="156" rx="14"></rect>
                  <text class="agent-loop-title" x="615" y="184" text-anchor="middle">Sandbox deploy</text>
                  <text class="agent-loop-sub" x="615" y="211" text-anchor="middle">SUT with OTEL instrumentation</text>
                  <line class="agent-loop-divider" x1="534" y1="232" x2="696" y2="232"></line>
                  <text class="agent-loop-title" x="615" y="266" text-anchor="middle">E2E run</text>
                </g>

                <g class="agent-loop-node agent-loop-evidence-node">
                  <rect x="768" y="116" width="260" height="208" rx="18"></rect>
                  <text class="agent-loop-title agent-loop-evidence-title" x="898" y="164" text-anchor="middle">Blackbox evidence</text>
                  <text class="agent-loop-sub" x="898" y="192" text-anchor="middle">runtime facts the reviewer can read</text>
                  <rect class="agent-loop-chip" x="808" y="222" width="84" height="30" rx="8"></rect>
                  <text class="agent-loop-chip-text" x="850" y="242" text-anchor="middle">effects</text>
                  <rect class="agent-loop-chip" x="904" y="222" width="84" height="30" rx="8"></rect>
                  <text class="agent-loop-chip-text" x="946" y="242" text-anchor="middle">catalog</text>
                  <rect class="agent-loop-chip" x="808" y="264" width="84" height="30" rx="8"></rect>
                  <text class="agent-loop-chip-text" x="850" y="284" text-anchor="middle">coverage</text>
                  <rect class="agent-loop-chip" x="904" y="264" width="84" height="30" rx="8"></rect>
                  <text class="agent-loop-chip-text" x="946" y="284" text-anchor="middle">feature file</text>
                </g>

                <g class="agent-loop-node">
                  <rect x="1068" y="162" width="136" height="116" rx="14"></rect>
                  <text class="agent-loop-title" x="1136" y="207" text-anchor="middle">Review</text>
                  <text class="agent-loop-sub" x="1136" y="234" text-anchor="middle">merge or fix</text>
                </g>
              </svg>
              <div class="agent-loop-caption">
                The loop can be automated, but the handoff stays concrete: a reviewer sees what ran, which effects were
                observed, and whether the change is ready to merge.
              </div>
            </div>
          </div>
        </section>

        <section class="slide" id="environments" data-slide="9" aria-label="Ephemeral environments and mocks">
          <div class="slide-copy">
            <p class="eyebrow">Slide 9 / Ephemeral environments</p>
            <h2>Ephemeral environments are the natural place to run this.</h2>
            <p class="lead">
              The run can be short-lived and controlled. Mocks can be useful, as long as the report makes the boundary
              clear: what was real, what was simulated, and what unmanaged dependencies were intentionally omitted.
            </p>
          </div>

          <div class="slide-visual baz-flow">
            <div class="flow-card flow-proof">
              <span class="flow-label">1</span>
              <h3>Controlled SUT</h3>
              <p>The system under test runs in a shape the workflow can create and tear down.</p>
            </div>
            <div class="flow-card">
              <span class="flow-label">2</span>
              <h3>Managed dependencies</h3>
              <p>Databases, queues, caches, and internal services can be part of the evidence boundary.</p>
            </div>
            <div class="flow-card">
              <span class="flow-label">3</span>
              <h3>Mocks</h3>
              <p>Mocks are acceptable when they are explicit and the report does not pretend they are external truth.</p>
            </div>
            <div class="flow-card">
              <span class="flow-label">4</span>
              <h3>Unmanaged dependencies</h3>
              <p>Auth providers, email, payment, and remote systems need clear policy before they enter the run.</p>
            </div>
          </div>
        </section>

        <section class="slide" id="test-dependency" data-slide="10" aria-label="Dependency on executable tests">
          <div class="slide-copy">
            <p class="eyebrow">Slide 10 / What to consider</p>
            <h2>Blackbox depends on flows that actually exercise behavior.</h2>
            <p class="lead">
              This is not magic observation of the whole system. If the flow does not run, Blackbox cannot observe it.
              Scenario quality, instrumentation boundaries, and catalog review still matter.
            </p>
          </div>

          <div class="slide-visual deck-diagram">
            <OverviewDiagram kind="fit" />
          </div>
        </section>

      </main>
    </div>

    <div class="deck-progress" aria-hidden="true"><span></span></div>

    <script>
      const slides = Array.from(document.querySelectorAll('.slide'));
      const dots = Array.from(document.querySelectorAll('.slide-dot'));
      const progress = document.querySelector('.deck-progress span');

      const scrollToSlide = (slide, updateHash = false) => {
        if (!slide) return;

        const rect = slide.getBoundingClientRect();
        const topbar = document.querySelector('.deck-topbar');
        const topbarOffset = topbar ? topbar.getBoundingClientRect().height / 2 : 0;
        const targetTop = window.scrollY + rect.top + (rect.height - window.innerHeight) / 2 + topbarOffset;

        window.scrollTo({
          top: Math.max(0, targetTop),
          behavior: 'smooth',
        });

        if (updateHash && slide.id) {
          window.history.replaceState(null, '', `#${slide.id}`);
        }
      };

      const setActive = (index) => {
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
        if (progress) progress.style.width = `${((index + 1) / slides.length) * 100}%`;
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          const index = slides.indexOf(visible.target);
          if (index >= 0) setActive(index);
        },
        { threshold: [0.45, 0.65, 0.85] },
      );

      slides.forEach((slide) => observer.observe(slide));
      setActive(0);

      dots.forEach((dot) => {
        dot.addEventListener('click', (event) => {
          const id = dot.getAttribute('href')?.slice(1);
          const slide = id ? document.getElementById(id) : null;
          if (!slide) return;

          event.preventDefault();
          scrollToSlide(slide, true);
        });
      });

      window.addEventListener('keydown', (event) => {
        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
        const active = dots.findIndex((dot) => dot.classList.contains('is-active'));
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight' || event.key === 'PageDown') {
          event.preventDefault();
          scrollToSlide(slides[Math.min(active + 1, slides.length - 1)]);
        }
        if (event.key === 'ArrowUp' || event.key === 'ArrowLeft' || event.key === 'PageUp') {
          event.preventDefault();
          scrollToSlide(slides[Math.max(active - 1, 0)]);
        }
      });
    </script>
  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-snap-type: y proximity;
  }

  .baz-page {
    margin: 0;
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(239, 71, 121, 0.08), transparent 28rem),
      var(--bg);
    color: var(--text);
    font-family: var(--font-body);
  }

  .deck-shell {
    min-height: 100vh;
    display: block;
  }

  .deck-topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    min-height: 56px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(15, 15, 18, 0.86);
    backdrop-filter: blur(18px);
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: var(--fw-bold);
    color: var(--text);
  }

  .brand img {
    width: 26px;
    height: 26px;
  }

  .slide-dots {
    min-width: 0;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .slide-dots::-webkit-scrollbar {
    display: none;
  }

  .slide-dot {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 6px 9px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: var(--fw-medium);
    white-space: nowrap;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .slide-dot span {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-soft);
    font-family: var(--font-code);
    font-size: 11px;
  }

  .slide-dot.is-active,
  .slide-dot:hover {
    color: var(--text);
    background: var(--surface);
    border-color: var(--border);
  }

  .slide-dot.is-active span {
    background: var(--primary-soft);
    color: var(--primary-light);
  }

  .slides {
    min-width: 0;
  }

  .slide {
    min-height: 100vh;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: minmax(360px, 0.92fr) minmax(420px, 1.08fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
    padding: calc(clamp(42px, 7vw, 96px) + 48px) clamp(42px, 7vw, 96px) clamp(42px, 7vw, 96px);
    border-bottom: 1px solid var(--border);
  }

  .slide-wide {
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-content: center;
  }

  .slide-wide .slide-copy {
    max-width: 960px;
    justify-self: center;
    text-align: center;
  }

  .slide-wide .slide-copy h2 {
    max-width: 24ch;
    margin-inline: auto;
  }

  .slide-wide .slide-visual {
    width: min(1160px, 100%);
    justify-self: center;
  }

  .slide-copy {
    max-width: 680px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--primary-light);
    font-size: 12px;
    line-height: 1;
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1,
  h2 {
    margin: 0;
    color: var(--text);
    letter-spacing: 0;
    line-height: 1.06;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(40px, 4.8vw, 64px);
    font-weight: var(--fw-display);
  }

  h2 {
    font-size: clamp(34px, 4vw, 54px);
    font-weight: var(--fw-display);
  }

  h3 {
    margin: 0 0 10px;
    color: var(--text);
    font-size: 16px;
    font-weight: var(--fw-bold);
  }

  .lead {
    margin: 24px 0 0;
    color: var(--text-muted);
    font-size: clamp(18px, 1.6vw, 23px);
    line-height: 1.45;
    max-width: 62ch;
  }

  .lead-compact {
    margin-top: 14px;
    color: var(--text);
    font-size: clamp(16px, 1.2vw, 18px);
  }

  code,
  pre {
    font-family: var(--font-code);
  }

  .lead code,
  .demo-steps code {
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--code-text);
    font-size: 0.86em;
  }

  .slide-visual {
    min-width: 0;
  }

  .suites-proof-points,
  .blackbox-definition {
    display: grid;
    gap: 10px;
    margin-top: 30px;
  }

  .suites-proof-points div,
  .blackbox-definition div {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.45;
  }

  .suites-proof-points span,
  .blackbox-definition span {
    display: block;
    margin-bottom: 4px;
    color: var(--text);
    font-weight: var(--fw-bold);
  }

  .suites-visual {
    display: grid;
    gap: 12px;
  }

  .snapshot-card,
  .snapshot-metrics div,

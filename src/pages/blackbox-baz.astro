---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InputOutputGapDiagram from '@/components/blackbox/InputOutputGapDiagram.astro';
import OverviewDiagram from '@/components/blackbox/OverviewDiagram.astro';
import CodeFirstBddDiagram from '@/components/blackbox/CodeFirstBddDiagram.astro';
---

<BaseLayout
  title="Blackbox Runtime Evidence For Review"
  description="A temporary live-demo deck for Suites Blackbox: runtime-effect evidence inside a developer review workflow."
  showFooter={false}
>
  <div class="baz-page">
    <header class="deck-topbar" aria-label="Deck navigation">
      <a class="brand" href="/">
        <img src="/img/logo.svg" alt="" />
        <span>Suites</span>
      </a>
      <nav class="slide-dots" aria-label="Slides">
        <a href="#suites" class="slide-dot" data-slide-dot="1"><span>1</span> Suites</a>
        <a href="#blackbox" class="slide-dot" data-slide-dot="2"><span>2</span> Blackbox</a>
        <a href="#category" class="slide-dot" data-slide-dot="3"><span>3</span> Review Gap</a>
        <a href="#architecture" class="slide-dot" data-slide-dot="4"><span>4</span> Run Path</a>
        <a href="#demo" class="slide-dot" data-slide-dot="5"><span>5</span> Demo Setup</a>
        <a href="#behavior-specs" class="slide-dot" data-slide-dot="6"><span>6</span> Behavior Specs</a>
        <a href="#lifecycle" class="slide-dot" data-slide-dot="7"><span>7</span> Report Flow</a>
        <a href="#baz" class="slide-dot" data-slide-dot="8"><span>8</span> Summary</a>
      </nav>
    </header>

    <div class="deck-shell">
      <main class="slides" id="main">
        <section class="slide slide-intro" id="suites" data-slide="1" aria-label="Suites and Omer">
          <div class="slide-copy">
            <p class="eyebrow">Slide 1 / Context</p>
            <h1>Suites is my testing work for TypeScript backend teams.</h1>
            <p class="lead">
              I am Omer Morad, creator and maintainer of Suites. Suites started by making dependency-injection-heavy
              unit tests easier to write, type-safe, and consistent. Blackbox continues the same direction at the
              system-behavior layer.
            </p>
            <div class="suites-proof-points" aria-label="Suites credibility points">
              <div><span>Started with unit testing</span> Automatic mocks, typed dependency access, and a single repeatable pattern for NestJS, InversifyJS, Jest, Vitest, and Sinon.</div>
              <div><span>Predictable test shape</span> Small APIs and consistent structure reduce how much scaffolding humans and coding agents need to infer.</div>
              <div><span>System behavior</span> From isolated units to controlled system runs: checking what changed at service boundaries.</div>
            </div>
          </div>

          <div class="slide-visual suites-visual" aria-label="Suites project snapshot">
            <div class="snapshot-card snapshot-main">
              <span class="snapshot-label">Open source project</span>
              <h3>Suites</h3>
              <p>A TypeScript backend testing toolkit focused on dependency injection, consistency, and lower setup cost.</p>
            </div>
            <div class="snapshot-metrics" aria-label="Suites metrics">
              <div>
                <strong>
                  <svg class="metric-icon metric-icon-star" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 2.7l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.5l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9L12 2.7z"></path>
                  </svg>
                  539
                </strong>
                <span class="metric-label">GitHub stars</span>
              </div>
              <div>
                <strong>
                  <svg class="metric-icon metric-icon-npm" viewBox="0 0 56 22" aria-hidden="true">
                    <rect width="56" height="22" rx="3"></rect>
                    <path d="M8 6h40v10h-6V9h-4v7h-6V9h-4v7H8V6zm6 3v4h8V9h-8z"></path>
                  </svg>
                  ~750K
                </strong>
                <span class="metric-label">monthly downloads</span>
              </div>
            </div>
            <div class="snapshot-ladder">
              <div><span>Suites Unit</span> Check one class in isolation.</div>
              <div><span>Suites Blackbox</span> Check a system change at runtime.</div>
            </div>
          </div>
        </section>

        <section class="slide" id="blackbox" data-slide="2" aria-label="What Blackbox adds to system and E2E flows">
          <div class="slide-copy">
            <p class="eyebrow">Slide 2 / What Blackbox adds</p>
            <h2>Blackbox checks the backend effects behind a system or E2E flow.</h2>
            <p class="lead">
              Today, E2E drives the visible flow. Blackbox instruments the controlled run, records configured
              runtime effects, matches them against a reviewable behavior catalog, and returns an effect report for that run.
            </p>
            <div class="blackbox-definition">
              <div><span>Visible check</span> The UI or API assertion says the flow completed.</div>
              <div><span>Runtime effects</span> DB writes, queue publishes, cache changes, and outbound calls are recorded.</div>
              <div><span>Effect report</span> Observed, missing required, forbidden, and covered effects are attached to the run.</div>
            </div>
          </div>

          <div class="slide-visual deck-diagram" aria-label="Input output gap and captured runtime effects">
            <InputOutputGapDiagram />
          </div>
        </section>

        <section class="slide slide-intro" id="category" data-slide="3" aria-label="Review gap and integration boundary">
          <div class="slide-copy">
            <p class="eyebrow">Slide 3 / Review gap and boundary</p>
            <h1>Verifier agents infer. Blackbox records runtime facts.</h1>
            <p class="lead">
              When agents produce code quickly, review still slows down if the system behavior behind a requirement is
              not visible. A verifier workflow can select the requirement and run the flow. Blackbox adds deterministic
              checks over configured runtime evidence from that same controlled run.
            </p>
            <p class="lead lead-compact">
              <strong>The verifier owns intent and execution. Blackbox owns the runtime-effect evidence.</strong>
            </p>
            <div class="sensor-outcomes">
              <div><span>Verifier input</span> Requirement, branch preview, base behavior, and the flow to exercise.</div>
              <div><span>Blackbox input</span> Run identity, configured instrumentation, and the reviewed behavior catalog.</div>
              <div><span>Blackbox output</span> Observed, missing required, forbidden, and covered effects for the run.</div>
            </div>
          </div>

          <div class="slide-visual sensor-visual" aria-label="Spec review and Blackbox cooperation">
            <div class="sensor-card sensor-baz">
              <div class="sensor-label">Requirement review layer</div>
              <h3>Verifier agents</h3>
              <p>Turns specs into verification work and runs requirement-focused agents against preview environments.</p>
              <ul>
                <li>Extracts requirements and failure cases.</li>
                <li>Splits verification across agents.</li>
                <li>Grounds review in base code and scope.</li>
              </ul>
            </div>
            <div class="sensor-plus">+</div>
            <div class="sensor-card sensor-blackbox">
              <div class="sensor-label">Runtime evidence layer</div>
              <h3>Suites Blackbox</h3>
              <p>Observes the same controlled run and returns cataloged evidence for backend and system effects.</p>
              <ul>
                <li>Observed effects.</li>
                <li>Missing required effects.</li>
                <li>Forbidden effects and coverage.</li>
              </ul>
            </div>
            <div class="sensor-result">
              <strong>Shared handoff</strong>
              <span>The verifier checks the requirement. Blackbox returns the effects produced by the run.</span>
            </div>
          </div>
        </section>

        <section class="slide" id="architecture" data-slide="4" aria-label="Architecture and constraints">
          <div class="slide-copy">
            <p class="eyebrow">Slide 4 / Run path</p>
            <h2>The verifier runs the flow. Blackbox records the effects.</h2>
            <p class="lead">
              For a requirement-scoped run, Blackbox returns a trace-scoped effect report from the configured
              instrumentation boundary: observed effects, missing required effects, forbidden effects, and coverage.
            </p>
            <div class="constraint-row">
              <span>Requirement scoped</span>
              <span>Branch scoped</span>
              <span>Effect report</span>
              <span>Reviewable catalog</span>
            </div>
          </div>

          <div class="slide-visual deck-diagram">
            <OverviewDiagram kind="workflow" />
          </div>
        </section>

        <section class="slide demo-break-slide" id="demo" data-slide="5" aria-label="Demo setup">
          <div class="demo-break-copy">
            <p class="eyebrow">Slide 5 / Demo setup</p>
            <h1>Demo: one requirement run produces one effect report.</h1>
            <div class="demo-watch-list" aria-label="What to watch in the demo">
              <span>requirement result</span>
              <span>observed effects</span>
              <span>missing required</span>
              <span>forbidden effects</span>
              <span>coverage state</span>
            </div>
          </div>
        </section>

        <section class="slide" id="behavior-specs" data-slide="6" aria-label="Behavior specs and stale specifications">
          <div class="slide-copy">
            <p class="eyebrow">Slide 6 / Behavior specs</p>
            <h2>Feature files are complementary to spec-driven development.</h2>
            <p class="lead">
              Specs describe intended behavior before implementation. After implementation and over time, they can drift
              from what the system actually does. Blackbox can emit feature files from executable runs, so readable
              behavior specs stay connected to tests and runtime evidence.
            </p>
            <div class="lifecycle-points">
              <div><span>Before code</span> A ticket, design, or SDD spec describes the intended behavior.</div>
              <div><span>After code</span> A Playwright run exercises the branch and Blackbox records configured effects.</div>
              <div><span>Readable artifact</span> A generated `.feature` file is optional; it gives humans and agents a compact behavior view.</div>
              <div><span>Drift check</span> When tests, effects, and feature files separate, the change needs review.</div>
            </div>
          </div>

          <div class="slide-visual deck-diagram" aria-label="System tests effects and feature files triangle">
            <CodeFirstBddDiagram kind="triangle" />
          </div>
        </section>

        <section class="slide" id="lifecycle" data-slide="7" aria-label="Lifecycle">
          <div class="slide-copy">
            <p class="eyebrow">Slide 7 / Report flow</p>
            <h2>Where the effect report travels.</h2>
            <p class="lead">
              The lifecycle matters because the report is not just terminal output. It becomes review input: what was
              observed, what was required but missing, what was forbidden, and what catalog or coverage state changed.
            </p>
            <div class="lifecycle-points">
              <div><span>Observed</span> Effects recorded from the configured system boundary during the run.</div>
              <div><span>Missing</span> Required catalog entries that did not appear for the checked flow.</div>
              <div><span>Forbidden</span> Effects that appeared even though the catalog says they should not.</div>
              <div><span>Decision</span> Implementation fix, catalog review, rerun, or gate-ready evidence.</div>
            </div>
          </div>

          <div class="slide-visual lifecycle-visual" aria-label="Blackbox and verifier lifecycle">
            <div class="lifecycle-frame" data-life-step="0">
              <svg viewBox="0 0 980 560" role="img" aria-labelledby="lifeTitle lifeDesc">
                <title id="lifeTitle">Spec review and Blackbox lifecycle</title>
                <desc id="lifeDesc">A planner prepares requirement verification, runs a sandbox, Blackbox observes system effects, and a reviewer agent reads runtime evidence.</desc>
                <defs>
                  <marker id="lifeArrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                    <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8"></path>
                  </marker>
                </defs>

                <path class="life-lane" d="M140 118 H348"></path>
                <path class="life-lane" d="M502 118 H710"></path>
                <path class="life-lane" d="M795 186 V304"></path>
                <path class="life-lane" d="M710 373 H502"></path>
                <path class="life-lane" d="M348 373 H140"></path>

                <g class="life-node life-node-1">
                  <rect x="30" y="62" width="150" height="112" rx="10"></rect>
                  <text class="life-title" x="105" y="102" text-anchor="middle">Specs + base</text>
                  <text class="life-sub" x="105" y="130" text-anchor="middle">intent</text>
                  <text class="life-sub" x="105" y="152" text-anchor="middle">known behavior</text>
                </g>

                <g class="life-node life-node-2">
                  <rect x="332" y="42" width="190" height="152" rx="10"></rect>
                  <text class="life-title" x="427" y="82" text-anchor="middle">Planner agent</text>
                  <text class="life-sub" x="427" y="112" text-anchor="middle">requirement plan</text>
                  <text class="life-sub" x="427" y="134" text-anchor="middle">failure cases</text>
                  <text class="life-chip" x="427" y="164" text-anchor="middle">scoped</text>
                </g>

                <g class="life-node life-node-3">
                  <rect x="698" y="42" width="194" height="152" rx="10"></rect>
                  <text class="life-title" x="795" y="82" text-anchor="middle">Sandbox</text>
                  <text class="life-sub" x="795" y="112" text-anchor="middle">branch preview</text>
                  <text class="life-sub" x="795" y="134" text-anchor="middle">isolated execution</text>
                  <text class="life-chip" x="795" y="164" text-anchor="middle">ephemeral</text>
                </g>

                <g class="life-node life-node-4">
                  <rect x="698" y="298" width="194" height="150" rx="10"></rect>
                  <text class="life-title" x="795" y="338" text-anchor="middle">Verifier flow</text>
                  <text class="life-sub" x="795" y="368" text-anchor="middle">critical path</text>
                  <text class="life-sub" x="795" y="390" text-anchor="middle">UI or API driver</text>
                  <text class="life-chip" x="795" y="420" text-anchor="middle">repeatable</text>
                </g>

                <g class="life-node life-node-5">
                  <rect x="332" y="298" width="190" height="150" rx="10"></rect>
                  <text class="life-title" x="427" y="338" text-anchor="middle">Effect report</text>
                  <text class="life-sub" x="427" y="368" text-anchor="middle">effects + coverage</text>
                  <text class="life-sub" x="427" y="390" text-anchor="middle">catalog match</text>
                  <text class="life-chip good" x="427" y="420" text-anchor="middle">observed facts</text>
                </g>

                <g class="life-node life-node-6">
                  <rect x="30" y="298" width="150" height="150" rx="10"></rect>
                  <text class="life-title" x="105" y="338" text-anchor="middle">Reviewer agent</text>
                  <text class="life-sub" x="105" y="368" text-anchor="middle">review evidence</text>
                  <text class="life-sub" x="105" y="390" text-anchor="middle">fix or review</text>
                  <text class="life-chip good" x="105" y="420" text-anchor="middle">review input</text>
                </g>

                <g class="life-contract">
                  <rect x="378" y="212" width="98" height="56" rx="28"></rect>
                  <text x="427" y="236" text-anchor="middle">catalog</text>
                  <text x="427" y="254" text-anchor="middle">reviewed</text>
                </g>

                <path class="life-contract-line" d="M427 268 V298"></path>

                <g class="life-tail">
                  <rect x="248" y="492" width="150" height="42" rx="8"></rect>
                  <text x="323" y="518" text-anchor="middle">fix/rerun</text>
                  <rect x="416" y="492" width="150" height="42" rx="8"></rect>
                  <text x="491" y="518" text-anchor="middle">PR evidence</text>
                  <rect x="584" y="492" width="150" height="42" rx="8"></rect>
                  <text x="659" y="518" text-anchor="middle">feature file</text>
                </g>

                <path class="life-tail-line" d="M105 448 C105 514 210 514 248 514"></path>
                <path class="life-tail-line" d="M398 514 H416"></path>
                <path class="life-tail-line" d="M566 514 H584"></path>
              </svg>
              <div class="lifecycle-caption">
                <strong>Report path:</strong> the run is short-lived, the report is reusable, and catalog changes are
                reviewed because they redefine expected behavior.
              </div>
            </div>
          </div>
        </section>

        <section class="slide slide-final" id="baz" data-slide="8" aria-label="Summary">
          <div class="slide-copy">
            <p class="eyebrow">Slide 8 / Summary</p>
            <h2>What the review gets back.</h2>
            <p class="lead">
              After the run, the reviewer has the requirement result, the effect report, and the catalog/coverage state
              for the same branch.
            </p>
            <div class="constraint-row">
              <span>Requirement result</span>
              <span>Effect report</span>
              <span>Catalog coverage</span>
              <span>Branch evidence</span>
            </div>
          </div>

          <div class="slide-visual baz-flow">
            <div class="flow-card">
              <span class="flow-label">1</span>
              <h3>Requirement selected</h3>
              <p>The planner extracts requirements and failure cases from specs, designs, base code, and review scope.</p>
            </div>
            <div class="flow-card">
              <span class="flow-label">2</span>
              <h3>Branch exercised</h3>
              <p>Verifier agents exercise the relevant flow in an ephemeral preview or sandbox environment.</p>
            </div>
            <div class="flow-card flow-proof">
              <span class="flow-label">3</span>
              <h3>Effects recorded</h3>
              <p>Blackbox reports required effects, forbidden effects, missing effects, and coverage for that run.</p>
            </div>
            <div class="flow-card">
              <span class="flow-label">4</span>
              <h3>Evidence attached</h3>
              <p>The reviewer can cite runtime facts, request an implementation fix, or pass the report into a PR gate.</p>
            </div>
          </div>

        </section>
      </main>
    </div>

    <div class="deck-progress" aria-hidden="true"><span></span></div>

    <script>
      const slides = Array.from(document.querySelectorAll('.slide'));
      const dots = Array.from(document.querySelectorAll('.slide-dot'));
      const progress = document.querySelector('.deck-progress span');

      const scrollToSlide = (slide, updateHash = false) => {
        if (!slide) return;

        const rect = slide.getBoundingClientRect();
        const topbar = document.querySelector('.deck-topbar');
        const topbarOffset = topbar ? topbar.getBoundingClientRect().height / 2 : 0;
        const targetTop = window.scrollY + rect.top + (rect.height - window.innerHeight) / 2 + topbarOffset;

        window.scrollTo({
          top: Math.max(0, targetTop),
          behavior: 'smooth',
        });

        if (updateHash && slide.id) {
          window.history.replaceState(null, '', `#${slide.id}`);
        }
      };

      const setActive = (index) => {
        dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
        if (progress) progress.style.width = `${((index + 1) / slides.length) * 100}%`;
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (!visible) return;
          const index = slides.indexOf(visible.target);
          if (index >= 0) setActive(index);
        },
        { threshold: [0.45, 0.65, 0.85] },
      );

      slides.forEach((slide) => observer.observe(slide));
      setActive(0);

      dots.forEach((dot) => {
        dot.addEventListener('click', (event) => {
          const id = dot.getAttribute('href')?.slice(1);
          const slide = id ? document.getElementById(id) : null;
          if (!slide) return;

          event.preventDefault();
          scrollToSlide(slide, true);
        });
      });

      window.addEventListener('keydown', (event) => {
        if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey) return;
        const active = dots.findIndex((dot) => dot.classList.contains('is-active'));
        if (event.key === 'ArrowDown' || event.key === 'ArrowRight' || event.key === 'PageDown') {
          event.preventDefault();
          scrollToSlide(slides[Math.min(active + 1, slides.length - 1)]);
        }
        if (event.key === 'ArrowUp' || event.key === 'ArrowLeft' || event.key === 'PageUp') {
          event.preventDefault();
          scrollToSlide(slides[Math.max(active - 1, 0)]);
        }
      });
    </script>
  </div>
</BaseLayout>

<style>
  :global(html) {
    scroll-snap-type: y proximity;
  }

  .baz-page {
    margin: 0;
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(239, 71, 121, 0.08), transparent 28rem),
      var(--bg);
    color: var(--text);
    font-family: var(--font-body);
  }

  .deck-shell {
    min-height: 100vh;
    display: block;
  }

  .deck-topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 30;
    min-height: 56px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border);
    background: rgba(15, 15, 18, 0.86);
    backdrop-filter: blur(18px);
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: var(--fw-bold);
    color: var(--text);
  }

  .brand img {
    width: 26px;
    height: 26px;
  }

  .slide-dots {
    min-width: 0;
    display: flex;
    gap: 6px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .slide-dots::-webkit-scrollbar {
    display: none;
  }

  .slide-dot {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 34px;
    padding: 6px 9px;
    border: 1px solid transparent;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: var(--fw-medium);
    white-space: nowrap;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }

  .slide-dot span {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    color: var(--text-soft);
    font-family: var(--font-code);
    font-size: 11px;
  }

  .slide-dot.is-active,
  .slide-dot:hover {
    color: var(--text);
    background: var(--surface);
    border-color: var(--border);
  }

  .slide-dot.is-active span {
    background: var(--primary-soft);
    color: var(--primary-light);
  }

  .slides {
    min-width: 0;
  }

  .slide {
    min-height: 100vh;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: minmax(360px, 0.92fr) minmax(420px, 1.08fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
    padding: calc(clamp(42px, 7vw, 96px) + 48px) clamp(42px, 7vw, 96px) clamp(42px, 7vw, 96px);
    border-bottom: 1px solid var(--border);
  }

  .slide-copy {
    max-width: 680px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--primary-light);
    font-size: 12px;
    line-height: 1;
    font-weight: var(--fw-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1,
  h2 {
    margin: 0;
    color: var(--text);
    letter-spacing: 0;
    line-height: 1.06;
    text-wrap: balance;
  }

  h1 {
    font-size: clamp(40px, 4.8vw, 64px);
    font-weight: var(--fw-display);
  }

  h2 {
    font-size: clamp(34px, 4vw, 54px);
    font-weight: var(--fw-display);
  }

  h3 {
    margin: 0 0 10px;
    color: var(--text);
    font-size: 16px;
    font-weight: var(--fw-bold);
  }

  .lead {
    margin: 24px 0 0;
    color: var(--text-muted);
    font-size: clamp(18px, 1.6vw, 23px);
    line-height: 1.45;
    max-width: 62ch;
  }

  .lead-compact {
    margin-top: 14px;
    color: var(--text);
    font-size: clamp(16px, 1.2vw, 18px);
  }

  code,
  pre {
    font-family: var(--font-code);
  }

  .lead code,
  .demo-steps code {
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--code-text);
    font-size: 0.86em;
  }

  .slide-visual {
    min-width: 0;
  }


---
import { Code } from 'astro-expressive-code/components';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/primitives/Button.astro';
import CodePanel from '@/components/ui/primitives/CodePanel.astro';
import Container from '@/components/ui/primitives/Container.astro';
import GridBackdrop from '@/components/ui/primitives/GridBackdrop.astro';
import Panel from '@/components/ui/primitives/Panel.astro';
import Section from '@/components/ui/primitives/Section.astro';
import StatusBadge from '@/components/ui/primitives/StatusBadge.astro';
import TechnicalFigure from '@/components/ui/primitives/TechnicalFigure.astro';
import TextLink from '@/components/ui/primitives/TextLink.astro';

const longCommand =
  'pnpm exec suites test --project packages/payments-service --config ./tooling/testing/suites.integration.config.ts --reporter verbose';

const expressiveExample = `import { TestBed } from '@suites/unit';
import { PaymentService } from './payment.service';

const { unit } = await TestBed.solitary(PaymentService).compile();

await unit.authorize({ amount: 4200, currency: 'USD' });`;

const primitiveRows = [
  ['Container', 'width: wide | focused | text', 'default'],
  ['Section', 'spacing, align', 'heading, description, aside, content'],
  ['Panel', 'surface, tag, href, interactive', 'default'],
  ['Button', 'variant, href, disabled, loading, loadingLabel', 'default'],
  ['TextLink', 'href, external, indicator', 'default'],
  ['StatusBadge', 'state: stable | alpha | planned', 'default'],
  ['CodePanel', 'title, filename, meta, ariaLabel', 'title, meta, default, footer'],
  ['TechnicalFigure', 'index, label, caption, decorative, visualLabel', 'visual, caption'],
  ['GridBackdrop', 'mode, origin, fade', 'none'],
];
---

<BaseLayout
  title="Design System Sandbox"
  description="Development catalog for the Suites Astro UI primitives."
  noIndex={true}
  showFooter={false}
>
  <div class="design-system-catalog">
    <header class="catalog-hero" aria-labelledby="catalog-title">
      <GridBackdrop mode="contained" origin="top-left" fade="down" />
      <Container width="focused" class="catalog-hero__content">
        <p class="catalog-meta">Internal catalog · Astro primitives</p>
        <h1 id="catalog-title">A precise foundation for developer-facing interfaces.</h1>
        <p class="catalog-lead">
          This page exercises the additive primitive layer across layout, technical surfaces,
          interaction states, responsive behavior, and the active color theme.
        </p>
        <div class="catalog-actions">
          <Button href="#catalog-components">Browse components</Button>
          <Button href="#catalog-api" variant="secondary">Review the API</Button>
          <TextLink href="/docs/get-started/">Open the documentation</TextLink>
        </div>
        <p class="catalog-theme-note">
          Use the theme control in the header to verify every specimen in dark and light modes.
        </p>
      </Container>
    </header>

    <Container width="wide">
      <Section spacing="compact" align="start" aria-labelledby="typography-title">
        <h2 slot="heading" id="typography-title">Typography and text color</h2>
        <p slot="description">
          Hanken Grotesk carries interface content. JetBrains Mono identifies code and technical metadata.
        </p>
        <StatusBadge slot="aside" state="stable">Theme-aware</StatusBadge>

        <div slot="content" class="type-specimen-grid">
          <Panel class="type-specimen type-specimen--hierarchy">
            <p class="type-label">Display · 56 / 1.04</p>
            <p class="type-display">Systems you can reason about.</p>
            <p class="type-label">Heading · 32 / 1.12</p>
            <h3 class="type-heading">Build focused test environments</h3>
            <p class="type-body">
              Primary body copy stays at 16px or larger and uses a relaxed line height for technical explanations.
            </p>
          </Panel>

          <Panel class="type-specimen type-specimen--colors" surface="technical">
            <dl class="color-list">
              <div><dt>Primary</dt><dd class="text-primary">Dependencies resolve automatically.</dd></div>
              <div><dt>Muted</dt><dd class="text-muted">Supporting context and descriptions.</dd></div>
              <div><dt>Soft</dt><dd class="text-soft">Metadata and secondary annotations.</dd></div>
              <div><dt>Technical</dt><dd class="text-technical">graph.node / dependency:mocked</dd></div>
            </dl>
          </Panel>
        </div>
      </Section>
    </Container>

    <section class="layout-catalog" aria-labelledby="layout-title">
      <Container width="wide">
        <div class="catalog-section-heading">
          <h2 id="layout-title">Container widths</h2>
          <p>Each wrapper keeps responsive gutters and remains a plain <code>div</code>.</p>
        </div>
      </Container>

      <div class="container-specimens">
        <Container width="wide" class="container-specimen">
          <span>wide</span><code>1152px</code>
        </Container>
        <Container width="focused" class="container-specimen">
          <span>focused</span><code>1024px</code>
        </Container>
        <Container width="text" class="container-specimen">
          <span>text</span><code>720px</code>
        </Container>
      </div>
    </section>

    <Container width="wide">
      <div class="spacing-catalog" aria-labelledby="spacing-title">
        <div class="catalog-section-heading">
          <h2 id="spacing-title">Section rhythm</h2>
          <p>The three specimens use the real vertical-spacing variants.</p>
        </div>

        <div class="spacing-specimens">
          <Section spacing="compact" class="spacing-specimen">
            <h3 slot="heading">Compact</h3>
            <p slot="description">Related content within a continuous narrative.</p>
            <Panel slot="content"><code>40–56px</code></Panel>
          </Section>
          <Section spacing="default" class="spacing-specimen">
            <h3 slot="heading">Default</h3>
            <p slot="description">The standard separation between catalog groups.</p>
            <Panel slot="content"><code>56–88px</code></Panel>
          </Section>
          <Section spacing="spacious" class="spacing-specimen">
            <h3 slot="heading">Spacious</h3>
            <p slot="description">A deliberate break between major page ideas.</p>
            <Panel slot="content"><code>64–96px</code></Panel>
          </Section>
        </div>
      </div>

      <Section id="catalog-components" spacing="compact" align="center" aria-labelledby="buttons-title">
        <h2 slot="heading" id="buttons-title">Buttons, links, and lifecycle states</h2>
        <p slot="description">
          Every primary control is at least 44px high. Disabled and loading states remain explicit in markup.
        </p>

        <div slot="content" class="control-grid">
          <Panel>
            <h3>Button variants</h3>
            <div class="control-row">
              <Button>Primary action</Button>
              <Button variant="secondary">Secondary action</Button>
              <Button variant="ghost">Ghost action</Button>
              <Button href="#catalog-api" variant="secondary">Link button</Button>
            </div>
          </Panel>

          <Panel>
            <h3>Button states</h3>
            <div class="control-row">
              <Button disabled>Disabled</Button>
              <Button variant="secondary" loading loadingLabel="Saving changes">Saving</Button>
              <Button href="#catalog-api" variant="ghost" disabled>Disabled link</Button>
            </div>
          </Panel>

          <Panel>
            <h3>Text links</h3>
            <div class="control-column">
              <TextLink href="/docs/get-started/">Internal documentation</TextLink>
              <TextLink
                href="https://github.com/suites-dev"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Suites on GitHub (external link, opens in a new tab)"
              >
                Suites on GitHub
              </TextLink>
              <TextLink href="#catalog-api" indicator="none">Link without an indicator</TextLink>
            </div>
          </Panel>

          <Panel>
            <h3>Lifecycle badges</h3>
            <div class="control-row">
              <StatusBadge state="stable" />
              <StatusBadge state="alpha" />
              <StatusBadge state="planned" />
            </div>
          </Panel>
        </div>
      </Section>

      <Section spacing="compact" aria-labelledby="panels-title">
        <h2 slot="heading" id="panels-title">Panel surfaces</h2>
        <p slot="description">
          Border and surface changes communicate hierarchy. Only the linked specimen opts into interactive feedback.
        </p>
        <TextLink slot="aside" href="#catalog-api">Panel API</TextLink>

        <div slot="content" class="panel-grid">
          <Panel tag="article">
            <p class="panel-index">01 / default</p>
            <h3>Neutral content surface</h3>
            <p>Use this panel for grouped content that needs a quiet boundary.</p>
          </Panel>
          <Panel tag="article" surface="code">
            <p class="panel-index">02 / code</p>
            <h3>Code-adjacent surface</h3>
            <p><code>unitRef.get(PaymentGateway)</code></p>
          </Panel>
          <Panel tag="article" surface="technical">
            <p class="panel-index">03 / technical</p>
            <h3>System context</h3>
            <p>Use the gentle grid for architecture and runtime evidence.</p>
          </Panel>
          <Panel href="#catalog-api" interactive aria-label="Read the Panel primitive API">
            <p class="panel-index">04 / interactive</p>
            <h3>Explicit interaction</h3>
            <p>The border responds without lifting or shifting the layout.</p>
          </Panel>
        </div>
      </Section>

      <Section spacing="compact" aria-labelledby="code-title">
        <h2 slot="heading" id="code-title">Code panels</h2>
        <p slot="description">
          Long commands scroll inside their surface. Expressive Code keeps its own frame instead of receiving duplicate chrome.
        </p>

        <div slot="content" class="code-grid">
          <div class="code-specimen">
            <p class="specimen-label">Native code content</p>
            <CodePanel filename="scripts/test-unit.sh" meta="bash · local">
              <pre><code>{longCommand}</code></pre>
              <span slot="footer">Scroll horizontally at narrow widths</span>
            </CodePanel>
          </div>

          <div class="code-specimen">
            <p class="specimen-label">astro-expressive-code</p>
            <CodePanel>
              <Code code={expressiveExample} lang="ts" title="payment.service.spec.ts" />
            </CodePanel>
          </div>
        </div>
      </Section>

      <Section spacing="compact" aria-labelledby="figure-title">
        <h2 slot="heading" id="figure-title">Technical figure</h2>
        <p slot="description">
          The frame supplies the 14px grid, caption semantics, and optional layer separation. The SVG owns its system meaning.
        </p>

        <TechnicalFigure
          slot="content"
          index="01"
          label="isolated unit · mocked boundary"
          caption="dependency graph"
        >
          <svg slot="visual" viewBox="0 0 520 320" aria-hidden="true">
            <g data-figure-layer="rear" stroke-width="0.7" stroke-linejoin="round">
              <polygon data-figure-plane="left" points="92,150 260,247 260,270 92,173" />
              <polygon data-figure-plane="right" points="428,150 260,247 260,270 428,173" />
              <polygon data-figure-plane="top" points="260,53 428,150 260,247 92,150" />
              <polygon data-figure-construction points="260,73 393,150 260,227 127,150" />
            </g>

            <g data-figure-layer="rear" stroke-width="0.7" stroke-linejoin="round">
              <polygon data-figure-plane="left" points="144,126 194,155 194,196 144,167" />
              <polygon data-figure-plane="right" points="244,126 194,155 194,196 244,167" />
              <polygon data-figure-plane="top" points="194,97 244,126 194,155 144,126" />
              <line data-figure-outline x1="155" y1="144" x2="185" y2="161" />
              <line data-figure-outline x1="155" y1="153" x2="178" y2="166" />
              <circle cx="157" cy="165" r="2" fill="var(--ui-figure-fill-high)" stroke="var(--ui-figure-outline)" stroke-width="0.6" />
            </g>

            <g data-figure-layer="rear" stroke-width="0.7" stroke-linejoin="round">
              <polygon data-figure-plane="left" points="280,116 319,139 319,171 280,148" />
              <polygon data-figure-plane="right" points="358,116 319,139 319,171 358,148" />
              <polygon data-figure-plane="top" points="319,94 358,116 319,139 280,116" />
              <line data-figure-outline x1="290" y1="132" x2="311" y2="144" />
              <line data-figure-outline x1="290" y1="140" x2="304" y2="148" />
            </g>

            <path
              data-figure-path
              d="M213 177 C245 194 273 194 307 174"
              stroke-width="0.8"
              stroke-dasharray="3 4"
            />
            <path data-figure-outline d="M333 169 C351 181 365 185 384 180" stroke-width="0.7" stroke-dasharray="2 3" />

            <g data-figure-layer="active" stroke-width="0.8" stroke-linejoin="round">
              <polygon data-figure-active points="303,175 329,190 329,208 303,193" />
              <polygon data-figure-active points="355,175 329,190 329,208 355,193" opacity="0.76" />
              <polygon data-figure-active points="329,160 355,175 329,190 303,175" />
              <circle cx="329" cy="176" r="27" fill="none" stroke="var(--primary)" stroke-width="0.6" stroke-dasharray="2 4" />
            </g>

            <g fill="var(--text-muted)" font-family="var(--font-technical)" font-size="9" letter-spacing="1.2">
              <text x="134" y="213">UNIT</text>
              <text x="350" y="222">MOCK</text>
            </g>
          </svg>
        </TechnicalFigure>
      </Section>

      <Section spacing="compact" aria-labelledby="backdrop-title">
        <h2 slot="heading" id="backdrop-title">Grid backdrops</h2>
        <p slot="description">
          Origins control the halo and grid construction point. Masks dissolve the pattern before it dominates the page.
        </p>

        <div slot="content" class="backdrop-grid">
          <div class="backdrop-specimen">
            <GridBackdrop mode="full" origin="top-left" fade="down" />
            <span>top-left · down</span>
          </div>
          <div class="backdrop-specimen">
            <GridBackdrop mode="full" origin="top-right" fade="left" />
            <span>top-right · left</span>
          </div>
          <div class="backdrop-specimen">
            <GridBackdrop mode="full" origin="bottom-left" fade="up" />
            <span>bottom-left · up</span>
          </div>
          <div class="backdrop-specimen">
            <GridBackdrop mode="contained" origin="center" fade="radial" />
            <span>center · radial · contained</span>
          </div>
        </div>
      </Section>

      <Section spacing="compact" aria-labelledby="responsive-title">
        <h2 slot="heading" id="responsive-title">Narrow-screen stacking</h2>
        <p slot="description">
          This asymmetric split collapses to one column without changing reading order or creating horizontal page overflow.
        </p>

        <div slot="content" class="responsive-specimen">
          <Panel>
            <p class="panel-index">01 / explanation</p>
            <h3>Start with the unit</h3>
            <p>Keep the narrative first in the DOM so the stacked layout remains logical.</p>
          </Panel>
          <TechnicalFigure index="02" label="responsive proof">
            <svg slot="visual" viewBox="0 0 360 230" aria-hidden="true">
              <g data-figure-layer="rear" stroke-width="0.8" stroke-linejoin="round">
                <polygon data-figure-plane="left" points="70,116 180,180 180,196 70,132" />
                <polygon data-figure-plane="right" points="290,116 180,180 180,196 290,132" />
                <polygon data-figure-plane="top" points="180,52 290,116 180,180 70,116" />
                <polygon data-figure-construction points="180,69 261,116 180,163 99,116" />
              </g>
              <g data-figure-layer="active" stroke-width="0.8" stroke-linejoin="round">
                <polygon data-figure-active points="151,106 180,123 180,145 151,128" />
                <polygon data-figure-active points="209,106 180,123 180,145 209,128" opacity="0.76" />
                <polygon data-figure-active points="180,89 209,106 180,123 151,106" />
              </g>
            </svg>
          </TechnicalFigure>
        </div>
      </Section>

      <Section id="catalog-api" spacing="compact" aria-labelledby="api-title">
        <h2 slot="heading" id="api-title">Primitive API quick reference</h2>
        <p slot="description">
          Components forward their remaining HTML attributes. Each file also documents its props and slots at the component boundary.
        </p>

        <div slot="content" class="api-table-wrap" tabindex="0" role="region" aria-label="Scrollable primitive API table">
          <table>
            <thead>
              <tr><th>Component</th><th>Primary props</th><th>Slots</th></tr>
            </thead>
            <tbody>
              {primitiveRows.map(([component, props, slots]) => (
                <tr><th scope="row"><code>{component}</code></th><td><code>{props}</code></td><td><code>{slots}</code></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </Section>
    </Container>
  </div>
</BaseLayout>

<style>
  :global(body:has(.design-system-catalog)) {
    background: var(--bg);
  }

  .design-system-catalog {
    color: var(--text);
    background: var(--bg);
    font-family: var(--font-interface);
  }

  .design-system-catalog h1,
  .design-system-catalog h2,
  .design-system-catalog h3,
  .design-system-catalog p,
  .design-system-catalog dl,
  .design-system-catalog dd {
    margin-block-start: 0;
  }

  .design-system-catalog h2 {
    margin-block-end: 12px;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .design-system-catalog h3 {
    margin-block-end: 10px;
    font-size: 1.125rem;
    line-height: 1.25;
  }

  .design-system-catalog p {
    color: var(--text-muted);
    line-height: 1.65;
  }

  .design-system-catalog code {
    font-family: var(--font-technical);
  }

  .catalog-hero {
    position: relative;
    display: grid;
    min-height: min(720px, calc(100svh - var(--ui-header-h)));
    align-items: center;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .catalog-hero__content {
    position: relative;
    z-index: 1;
    padding-block: clamp(72px, 12vw, 128px);
    text-align: center;
  }

  .catalog-meta,
  .specimen-label,
  .type-label,
  .panel-index {
    color: var(--text-soft);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .catalog-hero h1 {
    max-width: 880px;
    margin: 0 auto 24px;
    font-family: var(--font-interface);
    font-size: clamp(2.75rem, 7vw, 5.75rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .catalog-lead {
    max-width: 680px;
    margin: 0 auto 32px;
    font-size: clamp(1rem, 2vw, 1.1875rem);
  }

  .catalog-actions,
  .control-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .catalog-actions {
    justify-content: center;
  }

  .catalog-theme-note {
    margin: 24px auto 0;
    font-family: var(--font-technical);
    font-size: 0.75rem;
  }

  .type-specimen-grid,
  .control-grid,
  .panel-grid,
  .code-grid,
  .backdrop-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--ui-grid-gap);
  }

  .type-specimen {
    min-height: 100%;
  }

  .type-label {
    margin-block-end: 9px;
  }

  .type-label:not(:first-child) {
    margin-block-start: 32px;
  }

  .type-display {
    margin-block-end: 36px;
    color: var(--text) !important;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.04 !important;
  }

  .type-heading {
    font-size: clamp(1.5rem, 3vw, 2rem) !important;
  }

  .type-body {
    max-width: 58ch;
    margin-block-end: 0;
    font-size: 1rem;
  }

  .color-list {
    display: grid;
    gap: 22px;
    margin-block-end: 0;
  }

  .color-list div {
    display: grid;
    gap: 5px;
  }

  .color-list dt {
    color: var(--text-soft);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .color-list dd {
    margin-inline-start: 0;
    font-size: 1rem;
  }

  .text-primary { color: var(--text); }
  .text-muted { color: var(--text-muted); }
  .text-soft { color: var(--text-soft); }
  .text-technical { color: var(--text); font-family: var(--font-technical); font-size: 0.8125rem !important; }

  .layout-catalog,
  .spacing-catalog {
    padding-block: var(--ui-section-compact);
  }

  .layout-catalog {
    background: var(--bg-subtle);
    border-block: 1px solid var(--border);
  }

  .catalog-section-heading {
    margin-block-end: 32px;
  }

  .catalog-section-heading p {
    max-width: 64ch;
    margin-block-end: 0;
  }

  .container-specimens {
    display: grid;
    gap: 12px;
  }

  .container-specimen {
    display: flex;
    min-height: 58px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--ui-radius-control);
    font-weight: 600;
  }

  .container-specimen code {
    color: var(--text-soft);
    font-size: 0.6875rem;
    font-weight: 400;
  }

  .spacing-specimens {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--ui-grid-gap);
    align-items: start;
  }

  .spacing-specimen {
    padding-inline: 16px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--ui-radius-panel);
  }

  .spacing-specimen h3 {
    margin-block-end: 6px;
  }

  .spacing-specimen :global(.primitive-section__header) {
    margin-block-end: 20px;
  }

  .spacing-specimen :global(.primitive-panel) {
    padding: 14px;
    text-align: center;
  }

  .control-grid > :global(.primitive-panel) {
    min-height: 200px;
  }

  .control-column {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
    gap: 14px;
  }

  .panel-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .panel-grid :global(.primitive-panel) {
    min-height: 230px;
  }

  .panel-grid h3,
  .control-grid h3 {
    margin-block-start: 0;
  }

  .panel-grid p:last-child,
  .control-grid p:last-child {
    margin-block-end: 0;
  }

  .panel-index {
    margin-block-end: 28px;
  }

  .code-specimen {
    min-width: 0;
  }

  .specimen-label {
    margin-block-end: 10px;
  }

  .backdrop-specimen {
    position: relative;
    display: grid;
    min-height: 220px;
    place-items: end start;
    overflow: hidden;
    padding: 20px;
    background: var(--ui-technical-surface);
    border: 1px solid var(--border);
    border-radius: var(--ui-radius-panel);
  }

  .backdrop-specimen span {
    position: relative;
    z-index: 1;
    color: var(--text-muted);
    font-family: var(--font-technical);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .responsive-specimen {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--ui-grid-gap);
    align-items: stretch;
  }

  .responsive-specimen > :global(*) {
    min-width: 0;
  }

  .api-table-wrap {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--ui-radius-panel);
  }

  .api-table-wrap:focus-visible {
    outline: 2px solid var(--ui-focus-ring);
    outline-offset: 3px;
  }

  table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;

---
import DocsHeader from '@/components/site/Header.astro';
import MarketingHeader from '@/components/site/MarketingHeader.astro';
import Footer from '@/components/site/Footer.astro';
import GoogleAnalytics from '@/components/islands/GoogleAnalytics.astro';
import '@/styles/globals.css';
import { DEFAULT_SOCIAL_IMAGE, SITE_DESCRIPTION, SITE_NAME, SITE_URL, pageTitle } from '@/config/seo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  keywords?: string[];
  canonicalUrl?: string | false;
  noIndex?: boolean;
  pageType?: 'WebPage' | 'TechArticle';
  modifiedTime?: string;
  structuredData?: Record<string, unknown>[];
  /* Routes can opt out of the shared branded footer when they provide their
     own page ending. Documentation and marketing surfaces render it by default. */
  showFooter?: boolean;
  /* Full-page replicas can provide their own exact header while every other
     route keeps the normal Suites header. */
  showHeader?: boolean;
  /* "docs" renders the compact docs header with DocSearch and active product
     context. "marketing" renders the homepage project header. Defaults to marketing
     so non-docs surfaces don't need to opt in. */
  header?: 'docs' | 'marketing';
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  ogImage = DEFAULT_SOCIAL_IMAGE.path,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  ogImageType,
  keywords = [
    'auto mocking',
    'unit testing framework',
    'jest',
    'vitest',
    'dependency injection',
    'inversion of control',
    'nestjs',
    'inversifyjs',
    'injectionjs',
    'unit testing',
    'test doubles',
    'typescript testing',
  ],
  // Astro.url.pathname comes through without the trailing slash even under
  // trailingSlash: 'always', and a canonical that redirects to another URL
  // is a canonical pointing away from itself.
  canonicalUrl = new URL(
    Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`,
    Astro.site ?? Astro.url.origin,
  ).toString(),
  noIndex = false,
  pageType = 'WebPage',
  modifiedTime,
  structuredData = [],
  showFooter = true,
  showHeader = true,
  header = 'marketing',
} = Astro.props;

const site = Astro.site ?? new URL(SITE_URL);
const fullTitle = pageTitle(title);
const imageUrl = new URL(ogImage, site).href;
const isDefaultImage = imageUrl === new URL(DEFAULT_SOCIAL_IMAGE.path, site).href;
const imageAlt = ogImageAlt ?? (isDefaultImage ? DEFAULT_SOCIAL_IMAGE.alt : title);
const imageWidth = ogImageWidth ?? (isDefaultImage ? DEFAULT_SOCIAL_IMAGE.width : undefined);
const imageHeight = ogImageHeight ?? (isDefaultImage ? DEFAULT_SOCIAL_IMAGE.height : undefined);
const imageType = ogImageType ?? (isDefaultImage ? DEFAULT_SOCIAL_IMAGE.type : undefined);
const previewBuild = ['deploy-preview', 'branch-deploy'].includes(process.env.CONTEXT ?? '');
const preventIndexing = noIndex || previewBuild;
const robots = preventIndexing
  ? 'noindex, follow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
const dateModified = modifiedTime && !Number.isNaN(Date.parse(modifiedTime))
  ? new Date(modifiedTime).toISOString()
  : undefined;
const organizationId = new URL('/#organization', site).href;
const websiteId = new URL('/#website', site).href;
const graph = canonicalUrl && !preventIndexing ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': organizationId,
      name: SITE_NAME,
      url: site.href,
      logo: new URL('/img/branding/Suites_LogoMark_FullColor.png', site).href,
      sameAs: ['https://github.com/suites-dev'],
    },
    {
      '@type': 'WebSite',
      '@id': websiteId,
      name: SITE_NAME,
      url: site.href,
      description: SITE_DESCRIPTION,
      inLanguage: 'en',
      publisher: { '@id': organizationId },
    },
    {
      '@type': pageType,
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: fullTitle,
      ...(pageType === 'TechArticle' ? { headline: title, author: { '@id': organizationId } } : {}),
      description,
      inLanguage: 'en',
      isPartOf: { '@id': websiteId },
      publisher: { '@id': organizationId },
      dateModified,
      primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl, width: imageWidth, height: imageHeight, caption: imageAlt },
    },
    ...structuredData,
  ],
} : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/img/favicon.svg?v=20260823" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon.png?v=20260823" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png?v=20260823" />
    <link rel="shortcut icon" href="/img/favicon.ico?v=20260823" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png?v=20260823" />

    <!-- Fonts are served locally. -->
    {header === 'docs' && (
      <>
        <link
          rel="preload"
          href="/fonts/onest-variable.ttf"
          as="font"
          type="font/ttf"
          crossorigin="anonymous"
        />
      </>
    )}

    <!-- SEO -->
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta name="author" content="Suites" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:secure_url" content={imageUrl} />
    {imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageType && <meta property="og:image:type" content={imageType} />}
    <meta property="og:image:alt" content={imageAlt} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:type" content={pageType === 'TechArticle' ? 'article' : 'website'} />
    {pageType === 'TechArticle' && dateModified && <meta property="article:modified_time" content={dateModified} />}
    <meta property="og:site_name" content="Suites" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {graph && <script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />}

    <!-- Additional SEO -->
    <meta name="theme-color" content="#0F0F12" />
    <meta name="application-name" content="Suites" />
    <meta name="apple-mobile-web-app-title" content="Suites" />

    {/* Theme resolver: runs before first paint to avoid a flash.
        Order of precedence: explicit user choice in localStorage,
        otherwise OS preference, otherwise dark (our default). */}
    <script is:inline>
      (function () {
        function applyTheme(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          var themeColor = document.querySelector('meta[name="theme-color"]');
          if (themeColor) themeColor.setAttribute('content', theme === 'light' ? '#FFFFFF' : '#0F0F12');
        }

        try {
          var stored = localStorage.getItem('suites-theme');
          var prefersLight = window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches;
          var theme = stored || (prefersLight ? 'light' : 'dark');
          applyTheme(theme);
        } catch (e) {
          applyTheme('dark');
        }
      })();
    </script>

    <GoogleAnalytics />
  </head>
  <body class:list={{ 'docs-page': header === 'docs' }}>
    <a href="#main" class="skip-link">Skip to main content</a>
    {showHeader && (header === 'docs' ? <DocsHeader /> : <MarketingHeader />)}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>

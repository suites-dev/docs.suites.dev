---
import sidebar, { productFromPath } from '@/config/sidebar';

interface Props {
  slug: string;
}
const { slug } = Astro.props;

const currentHref = `/docs/${slug}`.replace(/\/$/, '');
const product = productFromPath(`${currentHref}/`);
const groups = sidebar[product];
const allItems = groups.flatMap((group) => group.items);
const group = groups.find((group) => group.items.some((item) => item.href.replace(/\/$/, '') === currentHref));
const items = group?.items ?? [];

const idx = items.findIndex((item) => item.href.replace(/\/$/, '') === currentHref);

const current = items[idx];
const sequential = group?.sequential !== false;
const prev = current?.previous !== undefined
  ? allItems.find((item) => item.href === current.previous)
  : sequential && idx > 0 ? items[idx - 1] : null;
const next = current?.next !== undefined
  ? allItems.find((item) => item.href === current.next)
  : sequential && idx >= 0 && idx < items.length - 1 ? items[idx + 1] : null;
---
{(prev || next) && (
  <nav class="doc-pager" aria-label="Previous and next page">
    {prev ? (
      <a class="doc-pager-prev" href={prev.href} rel="prev">
        <span class="doc-pager-eyebrow">
          <span aria-hidden="true" class="doc-pager-arrow">&larr;</span>
          Previous
        </span>
        <span class="doc-pager-label">{prev.label}</span>
      </a>
    ) : <span class="doc-pager-spacer" aria-hidden="true" />}
    {next ? (
      <a class="doc-pager-next" href={next.href} rel="next">
        <span class="doc-pager-eyebrow">
          Next
          <span aria-hidden="true" class="doc-pager-arrow">&rarr;</span>
        </span>
        <span class="doc-pager-label">{next.label}</span>
      </a>
    ) : <span class="doc-pager-spacer" aria-hidden="true" />}
  </nav>
)}

---
import Topbar from '@/components/ui/Topbar.astro';
import DocSearch from '@/components/islands/DocSearch';
import ThemeToggle from '@/components/site/ThemeToggle.astro';
import { headerNavLinks } from '@/config/headerNav';
import { productFromPath } from '@/config/sidebar';

const pathname = Astro.url.pathname;
const isDocsLanding = pathname === '/docs' || pathname === '/docs/';
const activeProduct = isDocsLanding ? undefined : productFromPath(pathname);
const productLinks = headerNavLinks.filter((link) => link.product !== undefined);
const resourceLinks = headerNavLinks.filter((link) => link.product === undefined);
const desktopResourceLinks = resourceLinks.filter((link) => link.label !== 'GitHub');
const docsHeaderContext = isDocsLanding ? 'docs-landing' : 'docs-article';
---
<Topbar variant="docs" context={docsHeaderContext}>
  <a href="/" class="brand brand-symbol marketing-brand docs-brand" aria-label="Suites home">
    <img
      class="brand-logo"
      src="/img/branding/Suites_LogoMark_FullColor.svg"
      width="18"
      height="22"
      alt=""
    />
  </a>

  <a
    href="/docs/"
    class:list={['docs-home-link', { active: isDocsLanding }]}
    aria-current={isDocsLanding ? 'page' : undefined}
  >
    Docs
  </a>

  <div class="docs-product-switcher" role="group" aria-label="Documentation products">
    {productLinks.map((link) => {
      const isActive = link.product !== undefined && link.product === activeProduct;
      const label = link.product === 'blackbox' ? 'Blackbox' : 'Unit';
      return (
        <a
          class:list={['docs-product-link', { active: isActive }]}
          href={link.href}
          aria-current={isActive ? 'page' : undefined}
        >
          <span>{label}</span>
          {link.product === 'blackbox' && <small>Alpha</small>}
        </a>
      );
    })}
  </div>

  <div class="nav-search">
    <DocSearch client:only="react" />
  </div>

  {isDocsLanding && (
    <div class="docs-header-utilities">
      {desktopResourceLinks.map((link) => (
        <a
          class="docs-resource-link"
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{link.label}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  )}

  <div class="nav-cluster">
    <ThemeToggle />
    <a
      href="https://github.com/suites-dev/suites"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Suites on GitHub (opens in a new tab)"
      class="icon-link docs-github-link"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
      </svg>
    </a>

    <details class="marketing-mobile-menu docs-mobile-menu" data-docs-mobile-menu>
      <summary class="icon-link marketing-mobile-toggle" aria-label="Open navigation menu" data-docs-mobile-toggle>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
      </summary>
      <div class="marketing-mobile-panel">
        <div class="marketing-mobile-section">
          <p class="marketing-mobile-label">Documentation</p>
          <a
            class="marketing-mobile-link"
            href="/docs/"
            aria-current={isDocsLanding ? 'page' : undefined}
          >
            <span>Docs home</span>
            <small>
              {isDocsLanding
                ? 'Choose the verification boundary you need.'
                : 'Return to the documentation home.'}
            </small>
          </a>
          {productLinks.map((link) => {
            const isActive = link.product !== undefined && link.product === activeProduct;
            const isBlackbox = link.product === 'blackbox';
            return (
              <a
                class="marketing-mobile-link"
                href={link.href}
                aria-current={isActive ? 'page' : undefined}
              >
                <span>{isBlackbox ? 'Blackbox' : 'Unit'}</span>
                <small>
                  {isBlackbox
                    ? 'Alpha · Verify approved behavior against runtime evidence.'
                    : 'Test classes with typed, controlled dependencies.'}
                </small>
              </a>
            );
          })}
        </div>

        <div class="marketing-mobile-section">
          <p class="marketing-mobile-label">Resources</p>
          {resourceLinks.map((link) => (
            <a
              class="marketing-mobile-link"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="marketing-mobile-link-row">
                {link.label}
                <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</Topbar>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-docs-mobile-menu]');
  const mobileToggle = mobileMenu?.querySelector<HTMLElement>('[data-docs-mobile-toggle]');
  const mobileViewport = window.matchMedia('(max-width: 980px)');
  const backgroundRegions = [document.querySelector('main'), document.querySelector('footer')]
    .filter((node): node is HTMLElement => node instanceof HTMLElement);

  const syncMobileMenu = () => {
    if (!mobileMenu || !mobileToggle) return;
    const isOpen = mobileMenu.open && mobileViewport.matches;

    mobileToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
    mobileToggle.setAttribute('aria-expanded', String(isOpen));
    document.documentElement.classList.toggle('docs-menu-open', isOpen);

    for (const region of backgroundRegions) {
      if (isOpen) region.setAttribute('inert', '');
      else region.removeAttribute('inert');
    }
  };

  const closeMobileMenu = (restoreFocus = false) => {
    if (!mobileMenu?.open) return;
    mobileMenu.open = false;
    syncMobileMenu();
    if (restoreFocus) mobileToggle?.focus();
  };

  mobileMenu?.addEventListener('toggle', syncMobileMenu);
  mobileMenu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) closeMobileMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.open) closeMobileMenu(true);
  });

  document.addEventListener('pointerdown', (event) => {
    if (mobileMenu?.open && event.target instanceof Node && !mobileMenu.contains(event.target)) {
      closeMobileMenu();
    }
  });

  mobileViewport.addEventListener('change', () => {
    if (!mobileViewport.matches) closeMobileMenu();
    else syncMobileMenu();
  });

  syncMobileMenu();
</script>

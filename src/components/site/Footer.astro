---
/*
 * Site footer.
 *
 * Structure mirrors prisma.io/docs footer:
 * (1) Brand column on the left (mark, name, socials)
 * (2) Four-column link grid on the right (Tools, Docs, Community, Project)
 * (3) Hairline divider
 * (4) Bottom row: license + copyright + author
 *
 * Column labels are OSS-realistic: "Tools" replaces Prisma's "Product" slot
 * because we ship libraries, not paid SKUs. Every link resolves to a real
 * page in the docs collection or an existing repo / sponsor / license URL.
 */

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Tools',
    items: [
      { label: 'Unit',     href: '/docs/get-started/' },
      { label: 'Blackbox', href: '/docs/blackbox/overview/what-is-blackbox', badge: 'alpha' },
    ],
  },
  {
    title: 'Docs',
    items: [
      { label: 'Unit Quickstart',     href: '/docs/get-started/quickstart' },
      { label: 'Unit Guides',         href: '/docs/guides/' },
      { label: 'Unit API Reference',  href: '/docs/api-reference/' },
      { label: 'Blackbox Install',    href: '/docs/blackbox/quickstart/install' },
      { label: 'Blackbox CLI',        href: '/docs/blackbox/reference/cli' },
    ],
  },
  {
    title: 'Community',
    items: [
      { label: 'GitHub',       href: 'https://github.com/suites-dev/suites', external: true },
      { label: 'Discussions',  href: 'https://github.com/suites-dev/suites/discussions', external: true },
      { label: 'Issues',       href: 'https://github.com/suites-dev/suites/issues', external: true },
    ],
  },
  {
    title: 'Project',
    items: [
      { label: 'Changelog',             href: '/docs/changelog' },
      { label: 'Examples',              href: 'https://github.com/suites-dev/examples', external: true },
      { label: 'Blackbox Alpha Status', href: '/docs/blackbox/overview/alpha-status-and-limits' },
      { label: 'License',               href: 'https://github.com/suites-dev/suites/blob/master/LICENSE', external: true },
    ],
  },
];
---
<footer class="site-footer" role="contentinfo">
  <div class="site-footer-inner">
    <div class="site-footer-top">
      {/* Brand column */}
      <div class="site-footer-brand">
        <a href="/" class="brand" aria-label="Suites home">
          <span class="mark" aria-hidden="true"></span>
          <span>Suites</span>
        </a>
        <p class="site-footer-tagline">
          A unit testing framework for TypeScript backends working with
          inversion of control and dependency injection.
        </p>
        <div class="site-footer-socials">
          <a
            href="https://github.com/suites-dev/suites"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Suites on GitHub (opens in a new tab)"
            class="icon-link"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
            </svg>
          </a>
          <a
            href="https://buymeacoffee.com/omermoradd"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Sponsor Suites (opens in a new tab)"
            class="icon-link"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
            </svg>
          </a>
        </div>
      </div>

      {/* Link grid */}
      <nav class="site-footer-grid" aria-label="Footer">
        {columns.map((col) => (
          <div class="site-footer-col">
            <h2 class="site-footer-col-title">{col.title}</h2>
            <ul class="site-footer-col-list">
              {col.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {item.label}
                    {item.badge && <span class="site-footer-badge">{item.badge}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="site-footer-divider" aria-hidden="true"></div>

    <div class="site-footer-bottom">
      <p class="site-footer-meta">
        Released under the MIT License.
      </p>
      <p class="site-footer-meta">
        Copyright &copy; {year} &middot;
        <a class="site-footer-link site-footer-link--inline" href="https://omermorad.me/" target="_blank" rel="noopener noreferrer">Omer Morad</a>
      </p>
    </div>
  </div>
</footer>

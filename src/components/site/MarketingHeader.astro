---
/*
 * Marketing header.
 *
 * Used on every non-docs surface (homepage, 404, future blog/about pages).
 * Differs from the docs Header.astro on three counts:
 *  - Brand is bare "Suites", no "/ docs" suffix.
 *  - No DocSearch trigger and no product-tab row.
 *  - Direct project links without product or community dropdowns.
 *
 * The mobile menu keeps the same links in a compact drawer.
 */

import Topbar from '@/components/ui/Topbar.astro';
import ThemeToggle from '@/components/site/ThemeToggle.astro';

const marketingNavLinks = [
  { label: 'Documentation', href: '/docs/get-started/' },
  { label: 'Quick start', href: '/docs/get-started/quickstart/' },
  {
    label: 'Examples',
    href: 'https://github.com/suites-dev/examples',
    external: true,
  },
];

const marketingMobileResources = [
  marketingNavLinks[2],
  {
    label: 'GitHub',
    href: 'https://github.com/suites-dev/suites',
    external: true,
  },
];
---
<Topbar variant="marketing" context="homepage">
  <a href="/" class="brand marketing-brand marketing-logomark" aria-label="Suites home">
    <img class="marketing-logo theme-logo-dark" src="/img/branding/Suites_LogoMark_White.svg" width="36" height="40" alt="" />
    <img class="marketing-logo theme-logo-light" src="/img/branding/Suites_LogoMark_Black.svg" width="36" height="40" alt="" />
  </a>

  <div class="marketing-navlinks">
    {marketingNavLinks.map((link) => (
      <a
        class="marketing-nav-link"
        href={link.href}
        {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        <span>{link.label}</span>
      </a>
    ))}
  </div>

  <div class="nav-cluster">
    <ThemeToggle />
    <a
      href="https://github.com/suites-dev/suites"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Suites on GitHub (opens in a new tab)"
      class="icon-link marketing-github"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
      </svg>
    </a>

    <details class="marketing-mobile-menu" data-marketing-mobile-menu>
      <summary class="icon-link marketing-mobile-toggle" aria-controls="marketing-navigation" aria-label="Open navigation menu" data-marketing-mobile-toggle>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
        <span>Menu</span>
      </summary>
      <div class="marketing-mobile-panel" id="marketing-navigation">
        <div class="marketing-mobile-section">
          <p class="marketing-mobile-label">Explore Suites</p>
          {marketingNavLinks.filter((link) => !link.external).map((link) => (
            <a
              class="marketing-mobile-link"
              href={link.href}
            >
              <span>{link.label}</span>
              <small>
                {link.label === 'Documentation'
                  ? 'Get started with Suites.'
                  : 'Write your first test with Suites.'}
              </small>
            </a>
          ))}
        </div>

        <div class="marketing-mobile-section">
          <p class="marketing-mobile-label">Resources</p>
          {marketingMobileResources.map((link) => (
            <a
              class="marketing-mobile-link"
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="marketing-mobile-link-row">
                {link.label}
                <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</Topbar>

<script>
  const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-marketing-mobile-menu]');
  const mobileToggle = mobileMenu?.querySelector<HTMLElement>('[data-marketing-mobile-toggle]');
  const mobileViewport = window.matchMedia('(max-width: 767px)');
  const backgroundRegions = [document.querySelector('main'), document.querySelector('footer')]
    .filter((node): node is HTMLElement => node instanceof HTMLElement);

  const syncMobileMenu = () => {
    if (!mobileMenu || !mobileToggle) return;
    const isOpen = mobileMenu.open && mobileViewport.matches;

    mobileToggle.setAttribute('aria-label', isOpen ? 'Close navigation menu' : 'Open navigation menu');
    mobileToggle.setAttribute('aria-expanded', String(isOpen));
    document.documentElement.classList.toggle('marketing-menu-open', isOpen);

    for (const region of backgroundRegions) {
      if (isOpen) region.setAttribute('inert', '');
      else region.removeAttribute('inert');
    }
  };

  const closeMobileMenu = (restoreFocus = false) => {
    if (!mobileMenu?.open) return;
    mobileMenu.open = false;
    syncMobileMenu();
    if (restoreFocus) mobileToggle?.focus();
  };

  mobileMenu?.addEventListener('toggle', syncMobileMenu);
  mobileMenu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) closeMobileMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && mobileMenu?.open) closeMobileMenu(true);
  });

  document.addEventListener('pointerdown', (event) => {
    if (mobileMenu?.open && event.target instanceof Node && !mobileMenu.contains(event.target)) {
      closeMobileMenu();
    }
  });

  mobileViewport.addEventListener('change', () => {
    if (!mobileViewport.matches) closeMobileMenu();
    else syncMobileMenu();
  });

  syncMobileMenu();
</script>

---
/*
 * Marketing header.
 *
 * Used on every non-docs surface (homepage, 404, future blog/about pages).
 * Differs from the docs Header.astro on three counts:
 *  - Brand is bare "Suites", no "/ docs" suffix.
 *  - No DocSearch trigger and no product-tab row.
 *  - First-class nav: Tools dropdown (Unit, Blackbox), direct links to Docs /
 *    Guides / Examples, Community dropdown.
 *
 * Implementation uses native <details>/<summary> for dropdowns so no JS island
 * is required. The mobile menu uses the same pattern.
 */

import Topbar from '@/components/ui/Topbar.astro';
import ThemeToggle from '@/components/site/ThemeToggle.astro';

const tools = [
  {
    label: 'Unit',
    badge: 'stable',
    href: '/docs/get-started/',
    description: 'Unit testing for DI-based TypeScript backends.',
  },
  {
    label: 'Blackbox',
    badge: 'alpha',
    href: '/docs/blackbox/overview/what-is-blackbox',
    description: 'Effect coverage from Playwright runs and OTEL spans.',
  },
];

const directLinks = [
  { label: 'Docs', href: '/docs/get-started/' },
  { label: 'Guides', href: '/docs/guides/' },
  { label: 'Examples', href: 'https://github.com/suites-dev/examples', external: true },
];

const community = [
  { label: 'GitHub',      href: 'https://github.com/suites-dev/suites',             external: true },
  { label: 'Discussions', href: 'https://github.com/suites-dev/suites/discussions', external: true },
  { label: 'Issues',      href: 'https://github.com/suites-dev/suites/issues',      external: true },
];
---
<Topbar>
  <a href="/" class="brand" aria-label="Suites home">
    <span class="mark" aria-hidden="true"></span>
    <span>Suites</span>
  </a>

  <nav class="marketing-navlinks" aria-label="Primary">
    <details class="marketing-dropdown">
      <summary class="marketing-nav-link marketing-dropdown-trigger">
        <span>Tools</span>
        <svg class="marketing-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M3.5 4.5L6 7L8.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
      </summary>
      <div class="marketing-dropdown-panel">
        {tools.map((item) => (
          <a class="marketing-dropdown-item" href={item.href}>
            <span class="marketing-dropdown-title">
              {item.label}
              <span class="marketing-badge" data-variant={item.badge}>{item.badge}</span>
            </span>
            <span class="marketing-dropdown-desc">{item.description}</span>
          </a>
        ))}
      </div>
    </details>

    {directLinks.map((link) => (
      <a
        class="marketing-nav-link"
        href={link.href}
        {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {link.label}
      </a>
    ))}

    <details class="marketing-dropdown">
      <summary class="marketing-nav-link marketing-dropdown-trigger">
        <span>Community</span>
        <svg class="marketing-caret" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
          <path d="M3.5 4.5L6 7L8.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
        </svg>
      </summary>
      <div class="marketing-dropdown-panel marketing-dropdown-panel--compact">
        {community.map((item) => (
          <a
            class="marketing-dropdown-item marketing-dropdown-item--compact"
            href={item.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="marketing-dropdown-title">{item.label}</span>
          </a>
        ))}
      </div>
    </details>
  </nav>

  <div class="nav-cluster">
    <ThemeToggle />
    <a
      href="https://github.com/suites-dev/suites"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Suites on GitHub (opens in a new tab)"
      class="icon-link"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" />
      </svg>
    </a>

    <details class="marketing-mobile-menu">
      <summary class="icon-link marketing-mobile-toggle" aria-label="Open navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16" />
          <path d="M4 12h16" />
          <path d="M4 17h16" />
        </svg>
      </summary>
      <div class="marketing-mobile-panel">
        <div class="marketing-mobile-section">
          <p class="marketing-mobile-label">Tools</p>
          {tools.map((item) => (
            <a class="marketing-mobile-link" href={item.href}>
              <span class="marketing-mobile-link-row">
                {item.label}
                <span class="marketing-badge" data-variant={item.badge}>{item.badge}</span>
              </span>
              <small>{item.description}</small>
            </a>
          ))}
        </div>
        <div class="marketing-mobile-section">
          {directLinks.map((link) => (
            <a
              class="marketing-mobile-link"
              href={link.href}
              {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span>{link.label}</span>
            </a>
          ))}
        </div>
        <div class="marketing-mobile-section">
          <p class="marketing-mobile-label">Community</p>
          {community.map((item) => (
            <a
              class="marketing-mobile-link"
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{item.label}</span>
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</Topbar>

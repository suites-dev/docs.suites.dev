---
/**
 * Understated documentation-style link with a non-color indicator.
 *
 * Props: `href`, optional `external` override, and `indicator`. Remaining
 * anchor attributes are forwarded. The default slot supplies link text.
 */
interface Props {
  href: string;
  external?: boolean;
  indicator?: 'auto' | 'internal' | 'external' | 'none';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  external,
  indicator = 'auto',
  class: className,
  ...attrs
} = Astro.props;

const inferredExternal = /^(https?:)?\/\//.test(href);
const indicatorType =
  indicator === 'auto'
    ? (external ?? inferredExternal ? 'external' : 'internal')
    : indicator;
const opensNewTab = attrs.target === '_blank';
const externalAnnouncement = opensNewTab
  ? ' (external link, opens in a new tab)'
  : ' (external link)';
---

<a
  {...attrs}
  class:list={['primitive-text-link', className]}
  href={href}
  data-indicator={indicatorType}
>
  <span class="primitive-text-link__label"><slot /></span>
  {indicatorType === 'internal' && (
    <span class="primitive-text-link__arrow" aria-hidden="true">→</span>
  )}
  {indicatorType === 'external' && (
    <>
      <span class="primitive-text-link__sr-only">{externalAnnouncement}</span>
      <svg
        class="primitive-text-link__icon"
        width="14"
        height="14"
        viewBox="0 0 14 14"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 10 10 4M5 4h5v5" />
      </svg>
    </>
  )}
</a>

<style>
  .primitive-text-link {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
    gap: 6px;
    max-width: 100%;
    color: var(--text-muted);
    font-family: var(--font-interface);
    font-weight: 500;
    line-height: 1.45;
    text-decoration-line: underline;
    text-decoration-color: var(--border-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    touch-action: manipulation;
    transition:
      color var(--ui-transition-duration) var(--ui-transition-ease),
      text-decoration-color var(--ui-transition-duration) var(--ui-transition-ease);
  }

  .primitive-text-link:hover {
    color: var(--text);
    text-decoration-color: var(--primary);
  }

  .primitive-text-link:focus-visible {
    outline: 2px solid var(--ui-focus-ring);
    outline-offset: 3px;
  }

  .primitive-text-link__label {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .primitive-text-link__arrow,
  .primitive-text-link__icon {
    flex: 0 0 auto;
    color: var(--primary);
    transition: transform var(--ui-transition-duration) var(--ui-transition-ease);
  }

  .primitive-text-link__icon path {
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .primitive-text-link:hover .primitive-text-link__arrow {
    transform: translateX(2px);
  }

  .primitive-text-link:hover .primitive-text-link__icon {
    transform: translate(1px, -1px);
  }

  .primitive-text-link__sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

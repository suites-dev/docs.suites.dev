---
/**
 * Figure frame for fine-stroked isometric technical illustrations.
 *
 * Props: optional `index`, `label`, `caption`, and visual accessibility
 * controls. Slots: `visual` and `caption`. Decorative visuals are hidden from
 * assistive technology by default; set `decorative={false}` for meaningful
 * SVGs that provide their own accessible text, or pass `visualLabel`.
 */
interface Props {
  index?: string | number;
  label?: string;
  caption?: string;
  decorative?: boolean;
  visualLabel?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  index,
  label,
  caption,
  decorative = true,
  visualLabel,
  class: className,
  ...attrs
} = Astro.props;
const hasCaption =
  Boolean(index) || Boolean(label) || Boolean(caption) || Astro.slots.has('caption');
---

<figure {...attrs} class:list={['primitive-technical-figure', className]}>
  <div
    class="primitive-technical-figure__visual"
    aria-hidden={decorative ? 'true' : undefined}
    role={!decorative && visualLabel ? 'img' : undefined}
    aria-label={!decorative ? visualLabel : undefined}
  >
    <slot name="visual" />
  </div>

  {hasCaption && (
    <figcaption class="primitive-technical-figure__caption">
      {index && <span class="primitive-technical-figure__index">{index}</span>}
      {(caption || Astro.slots.has('caption')) && (
        <span class="primitive-technical-figure__caption-text">
          {Astro.slots.has('caption') ? <slot name="caption" /> : caption}
        </span>
      )}
      {label && <span class="primitive-technical-figure__label">{label}</span>}
    </figcaption>
  )}
</figure>

<style>
  .primitive-technical-figure {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    color: var(--ui-foreground);
    background: var(--ui-technical-surface);
    border: 1px solid var(--ui-border);
    border-radius: var(--ui-radius-panel);
    font-family: var(--font-interface);
  }

  .primitive-technical-figure__visual {
    display: grid;
    min-height: 220px;
    aspect-ratio: 16 / 10;
    place-items: center;
    overflow: hidden;
    background-image:
      linear-gradient(to right, var(--ui-grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--ui-grid-line) 1px, transparent 1px);
    background-size: 14px 14px, 14px 14px;
  }

  .primitive-technical-figure__visual :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .primitive-technical-figure__visual :global([data-figure-layer]) {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 300ms var(--ui-transition-ease),
      transform 300ms var(--ui-transition-ease);
  }

  .primitive-technical-figure:hover
    .primitive-technical-figure__visual
    :global([data-figure-layer='rear']) {
    transform: translateY(-2px);
  }

  .primitive-technical-figure:hover
    .primitive-technical-figure__visual
    :global([data-figure-layer='active']) {
    transform: translateY(-4px);
  }

  .primitive-technical-figure__visual :global([data-figure-plane='top']) {
    fill: var(--ui-figure-fill-high);
    stroke: var(--ui-figure-outline);
  }

  .primitive-technical-figure__visual :global([data-figure-plane='left']) {
    fill: var(--ui-figure-fill-low);
    stroke: var(--ui-figure-outline);
  }

  .primitive-technical-figure__visual :global([data-figure-plane='right']) {
    fill: var(--ui-figure-fill-mid);
    stroke: var(--ui-figure-outline);
  }

  .primitive-technical-figure__visual :global([data-figure-outline]) {
    fill: none;
    stroke: var(--ui-figure-outline);
  }

  .primitive-technical-figure__visual :global([data-figure-construction]) {
    fill: none;
    stroke: var(--ui-figure-outline);
    stroke-dasharray: 2 3;
  }

  .primitive-technical-figure__visual :global([data-figure-active]) {
    fill: var(--ui-primary);
    stroke: var(--ui-brand-mid);
  }

  .primitive-technical-figure__visual :global([data-figure-path]) {
    fill: none;
    stroke: var(--ui-primary);
  }

  .primitive-technical-figure__caption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 38px;
    padding: 9px 14px;
    color: var(--ui-muted-foreground);
    border-top: 1px solid var(--ui-border);
    font-family: var(--font-technical);
    font-size: 0.625rem;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .primitive-technical-figure__caption-text {
    min-width: 0;
    overflow-wrap: anywhere;
    text-align: center;
  }

  .primitive-technical-figure__label {
    min-width: 0;
    overflow-wrap: anywhere;
    text-align: end;
  }

  @media (max-width: 420px) {
    .primitive-technical-figure__caption {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .primitive-technical-figure__caption-text {
      text-align: end;
    }

    .primitive-technical-figure__label {
      grid-column: 1 / -1;
      text-align: start;
    }
  }
</style>

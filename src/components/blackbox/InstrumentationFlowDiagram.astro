<figure class="bb-instrumentation-flow-diagram" aria-label="Blackbox test-time instrumentation flow">
  <svg viewBox="0 0 1140 320" role="img" aria-labelledby="blackbox-instrumentation-flow-title blackbox-instrumentation-flow-desc">
    <title id="blackbox-instrumentation-flow-title">Blackbox test-time instrumentation flow</title>
    <desc id="blackbox-instrumentation-flow-desc">Blackbox writes a Docker Compose overlay, shadows the Node binary with node-wrap, preloads bootstrap.cjs, and drains spans from the SUT debug endpoint back to the Playwright runner.</desc>
    <defs>
      <marker id="bb-instrumentation-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" fill="#94a3b8"></path>
      </marker>
      <filter id="bb-instrumentation-card-shadow" x="-10%" y="-20%" width="120%" height="150%">
        <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#000000" flood-opacity="0.18"></feDropShadow>
      </filter>
    </defs>

    <rect x="8" y="8" width="1124" height="304" rx="18" fill="#111827" stroke="#374151"></rect>
    <text x="36" y="44" fill="#f8fafc" font-size="19" font-weight="700">How Blackbox instruments a Node SUT during a test run</text>
    <text x="36" y="70" fill="#cbd5e1" font-size="13">The testbed injects observability at startup, then the runner reads runtime evidence without changing service source.</text>

    <g filter="url(#bb-instrumentation-card-shadow)">
      <rect x="42" y="118" width="220" height="106" rx="14" fill="#172554" stroke="#60a5fa"></rect>
      <text x="152" y="154" text-anchor="middle" fill="#eff6ff" font-size="14" font-weight="700">Compose overlay generated</text>
      <text x="152" y="190" text-anchor="middle" fill="#bfdbfe" font-size="12">bind-mounts bootstrap</text>
      <text x="152" y="208" text-anchor="middle" fill="#93c5fd" font-size="12">into Node SUT containers</text>
    </g>

    <line x1="274" y1="171" x2="300" y2="171" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-instrumentation-arrow)"></line>

    <g filter="url(#bb-instrumentation-card-shadow)">
      <rect x="312" y="118" width="220" height="106" rx="14" fill="#581c87" stroke="#c084fc"></rect>
      <text x="422" y="148" text-anchor="middle" fill="#faf5ff" font-size="14" font-weight="700">node-wrap shadows</text>
      <text x="422" y="168" text-anchor="middle" fill="#faf5ff" font-size="14" font-weight="700">the Node binary</text>
      <text x="422" y="194" text-anchor="middle" fill="#e9d5ff" font-size="12">service entrypoint</text>
      <text x="422" y="212" text-anchor="middle" fill="#d8b4fe" font-size="12">runs through wrapper</text>
    </g>

    <line x1="544" y1="171" x2="570" y2="171" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-instrumentation-arrow)"></line>

    <g filter="url(#bb-instrumentation-card-shadow)">
      <rect x="582" y="118" width="220" height="106" rx="14" fill="#14532d" stroke="#86efac"></rect>
      <text x="692" y="148" text-anchor="middle" fill="#f0fdf4" font-size="14" font-weight="700">bootstrap.cjs preloads</text>
      <text x="692" y="168" text-anchor="middle" fill="#f0fdf4" font-size="14" font-weight="700">OTEL SDK</text>
      <text x="692" y="194" text-anchor="middle" fill="#bbf7d0" font-size="12">loads before</text>
      <text x="692" y="212" text-anchor="middle" fill="#86efac" font-size="12">application code</text>
    </g>

    <line x1="814" y1="171" x2="840" y2="171" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-instrumentation-arrow)"></line>

    <g filter="url(#bb-instrumentation-card-shadow)">
      <rect x="852" y="118" width="220" height="106" rx="14" fill="#78350f" stroke="#fbbf24"></rect>
      <text x="962" y="148" text-anchor="middle" fill="#fef3c7" font-size="14" font-weight="700">Spans drain to</text>
      <text x="962" y="168" text-anchor="middle" fill="#fef3c7" font-size="14" font-weight="700">runner debug endpoint</text>
      <text x="962" y="194" text-anchor="middle" fill="#fde68a" font-size="12">Playwright reads spans</text>
      <text x="962" y="212" text-anchor="middle" fill="#fde68a" font-size="12">from SUT debug port</text>
    </g>

    <rect x="156" y="256" width="828" height="34" rx="17" fill="#0f172a" stroke="#475569"></rect>
    <text x="570" y="278" text-anchor="middle" fill="#e2e8f0" font-size="12" font-weight="700">Docker overlay and preload create spans, Playwright reads them from the SUT debug port</text>
  </svg>
  <figcaption>This diagram shows how Blackbox injects test-time instrumentation into Node SUT containers and drains spans back to the Playwright runner.</figcaption>
</figure>

<style>
  .bb-instrumentation-flow-diagram {
    margin: 24px 0;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    overflow-x: auto;
  }

  .bb-instrumentation-flow-diagram svg {
    display: block;
    width: 100%;
    min-width: 680px;
    height: auto;
  }

  .bb-instrumentation-flow-diagram figcaption {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 760px) {
    .bb-instrumentation-flow-diagram {
      padding: 12px;
    }
  }
</style>

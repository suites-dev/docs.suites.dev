          <div class="bb-agent-terminal__line bb-agent-terminal__line--tool-output bb-agent-terminal__transient" data-from="32100"><b aria-hidden="true">⎿</b><span>evidence <strong class="is-pass">SUFFICIENT</strong> <small>this attempt</small></span></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--result bb-agent-terminal__transient" data-from="33000"><span>finding</span><b class="is-fail">VIOLATED</b><small>expected ≤ 1 · observed 2</small></div>

          <div class="bb-agent-terminal__line bb-agent-terminal__line--agent bb-agent-terminal__line--phase-start bb-agent-terminal__transient" data-checkpoint-anchor="repair" data-from="34000">
            <b aria-hidden="true">⏺</b><span data-terminal-type data-terminal-speed="9">Blackbox found the duplicate charge. I’ll repair the implementation without changing the behavioral contract.</span>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--skill bb-agent-terminal__transient" data-from="35200">
            <b aria-hidden="true">⏺</b><span><strong>Repair implementation</strong></span>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--agent bb-agent-terminal__transient" data-from="36200">
            <b aria-hidden="true">⏺</b><strong>Editing</strong><span>src/checkout/checkout.service.ts</span>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--edited bb-agent-terminal__transient" data-from="37800">
            <b aria-hidden="true">⏺</b><strong>Edited</strong><span>src/checkout/checkout.service.ts</span>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--diff bb-agent-terminal__transient" data-from="38200">
            <span>4</span><i> </i><code>await payments.charge(order);</code>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--diff bb-agent-terminal__line--diff-remove bb-agent-terminal__transient" data-from="38600">
            <span>5</span><i>−</i><code>await payments.charge(order);</code>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--success bb-agent-terminal__transient" data-from="39700">
            <b aria-hidden="true">⏺</b><strong>Edited</strong><span>Removed duplicate charge · behavioral contract unchanged</span>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--agent bb-agent-terminal__line--phase-start bb-agent-terminal__transient" data-from="40400">
            <b aria-hidden="true">⏺</b><span data-terminal-type data-terminal-speed="6">I’m running the same behavioral contract again with fresh evidence.</span>
          </div>

          <div class="bb-agent-terminal__line bb-agent-terminal__line--command" data-from="41000">
            <b aria-hidden="true">⏺</b><span><strong>Conceptual</strong>(<code data-command data-text="&lt;run checkout-completion with Blackbox&gt;">&lt;run checkout-completion with Blackbox&gt;</code>)</span>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--tool-output" data-from="43200"><b aria-hidden="true">⎿</b><span><strong>FLOW</strong> checkout-completion</span></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--result" data-from="44000"><span>tests</span><b class="is-pass">PASS</b><small>201 Created</small></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--result" data-from="44800"><span>integrity</span><b class="is-pass">PASS</b><small>evidence sealed</small></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--result" data-from="45600"><span>effects</span><b class="is-pass">SATISFIED</b></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--observation" data-from="46400"><span>HTTP POST /payments/charges</span><b class="is-pass">observed 1</b></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--success bb-agent-terminal__line--phase-start" data-from="47500">
            <b aria-hidden="true">⏺</b><span data-terminal-type>The fresh attempt observed one charge request. The behavioral contract is satisfied for this attempt.</span>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--duration" data-from="48200">
            <b aria-hidden="true">✻</b><span>Baked for 42s</span>
          </div>

          <div class="bb-agent-terminal__idle" data-idle-prompt>
            <b>❯</b><span aria-hidden="true"></span>
          </div>
        </div>
      </section>
      </div>
    </div>
  </div>
</figure>

<script>
  const stages = [
    { start: 0, label: 'Review the requirement' },
    { start: 610, label: 'Developer request' },
    { start: 2800, label: 'Use the Blackbox Skill' },
    { start: 3400, label: 'Draft behavioral contract' },
    { start: 4200, label: 'Propose Gherkin contract' },
    { start: 8900, label: 'Validate proposed Gherkin' },
    { start: 11300, label: 'Approve behavioral contract' },
    { start: 13000, label: 'Prepare system test' },
    { start: 17000, label: 'Implement checkout' },
    { start: 23000, label: 'Run Blackbox' },
    { start: 30000, label: 'Analyze runtime evidence' },
    { start: 35000, label: 'Repair implementation' },
    { start: 41000, label: 'Verify the repair' },
  ] as const;

  const casts = document.querySelectorAll<HTMLElement>('[data-agent-cast]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  casts.forEach((cast) => {
    const storyDuration = 49000;
    const duration = Number(cast.dataset.duration) || 99500;
    const storyHolds = [
      { at: 600, duration: 2500 },
      { at: 1900, duration: 1200 },
      { at: 4000, duration: 500 },
      { at: 4050, duration: 2500 },
      { at: 8850, duration: 1100 },
      { at: 9350, duration: 900 },
      { at: 11552, duration: 1000 },
      { at: 12100, duration: 1500 },
      { at: 12850, duration: 1300 },
      { at: 13480, duration: 1000 },
      { at: 15000, duration: 1100 },
      { at: 22550, duration: 1100 },
      { at: 22920, duration: 900 },
      { at: 29950, duration: 900 },
      { at: 35100, duration: 800 },
      { at: 39500, duration: 700 },
      { at: 40970, duration: 1000 },
    ] as const;
    const heldPlaybackTime = storyHolds.reduce((total, hold) => total + hold.duration, 0);
    const activePlaybackTime = Math.max(1, duration - heldPlaybackTime);
    const playbackMsPerStoryMs = activePlaybackTime / storyDuration;
    const getStoryTime = (playbackTime: number) => {
      let elapsedHolds = 0;

      for (const hold of storyHolds) {
        const holdStartsAt = hold.at * playbackMsPerStoryMs + elapsedHolds;
        if (playbackTime < holdStartsAt) break;
        if (playbackTime < holdStartsAt + hold.duration) return hold.at;
        elapsedHolds += hold.duration;
      }

      return Math.min(storyDuration, (playbackTime - elapsedHolds) / playbackMsPerStoryMs);
    };
    const getPlaybackTime = (storyTime: number) => {
      const elapsedHolds = storyHolds.reduce(
        (total, hold) => total + (hold.at < storyTime ? hold.duration : 0),
        0,
      );

      return Math.min(duration, storyTime * playbackMsPerStoryMs + elapsedHolds);
    };
    const playButton = cast.querySelector<HTMLButtonElement>('[data-agent-play]');
    const playLabel = cast.querySelector<HTMLElement>('[data-agent-play-label]');
    const status = cast.querySelector<HTMLElement>('[data-agent-status]');
    const progress = cast.querySelector<HTMLElement>('[data-agent-progress]');
    const stageLabel = cast.querySelector<HTMLElement>('[data-agent-stage]');
    const stepLabel = cast.querySelector<HTMLElement>('[data-agent-step]');
    const workspace = cast.querySelector<HTMLElement>('.bb-agent-workspace');
    const workspaceState = cast.querySelector<HTMLElement>('[data-workspace-state]');
    const workspaceMain = cast.querySelector<HTMLElement>('[data-workspace-main]');
    const terminalBody = cast.querySelector<HTMLElement>('[data-terminal-body]');
    const frames = Array.from(cast.querySelectorAll<HTMLElement>('[data-editor-frame]'));
    const tabs = Array.from(cast.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const checkpoints = Array.from(
      cast.querySelectorAll<HTMLElement>('[data-agent-checkpoint]'),
    );
    const checkpointAnchors = Array.from(
      cast.querySelectorAll<HTMLElement>('[data-checkpoint-anchor]'),
    );
    const timedElements = Array.from(cast.querySelectorAll<HTMLElement>('[data-from]'));
    const commands = Array.from(cast.querySelectorAll<HTMLElement>('[data-command]'));
    const terminalMessages = Array.from(
      cast.querySelectorAll<HTMLElement>('[data-terminal-type]'),
    ).map((element) => ({
      element,
      text: element.textContent ?? '',
      html: element.innerHTML,
      from: Number(element.closest<HTMLElement>('[data-from]')?.dataset.from) || 0,
      speed: Number(element.dataset.terminalSpeed) || 12,
    }));
    const typedCode = Array.from(cast.querySelectorAll<HTMLElement>('[data-type]')).map(
      (element) => ({
        element,
        text: element.textContent ?? '',
        html: element.innerHTML,
        from: Number(element.dataset.from) || 0,
        speed: Number(element.dataset.typeSpeed) || 24,
      }),
    );
    const idlePrompt = cast.querySelector<HTMLElement>('[data-idle-prompt]');
    const approvalChoices = cast.querySelector<HTMLElement>('[data-approval-choices]');
    const suspectLine = cast.querySelector<HTMLElement>('[data-suspect-line]');
    const implementationState = cast.querySelector<HTMLElement>('[data-implementation-state]');
    const introRequirement = cast.querySelector<HTMLElement>('[data-intro-requirement]');

    if (!playButton || !playLabel || !status || !progress || !stageLabel || !stepLabel) return;

    const checkpointTimeline = checkpoints.map((element) => {
      const id = element.dataset.checkpointId ?? '';
      const matchingAnchors = checkpointAnchors.filter(
        (anchor) => anchor.dataset.checkpointAnchor === id,
      );
      const anchor = matchingAnchors[0];
      const at = Number(anchor?.dataset.from ?? anchor?.dataset.start);

      return {
        element,
        id,
        at,
        playbackAt: getPlaybackTime(at),
        anchorCount: matchingAnchors.length,
      };
    });
    const checkpointTimelineIsValid =
      checkpointTimeline.length > 1 &&
      checkpointTimeline.every((checkpoint, index) => {
        const previous = checkpointTimeline[index - 1];
        return (
          checkpoint.id.length > 0 &&
          checkpoint.anchorCount === 1 &&
          Number.isFinite(checkpoint.at) &&
          Number.isFinite(checkpoint.playbackAt) &&
          (!previous || checkpoint.at > previous.at)
        );
      });

    if (!checkpointTimelineIsValid) {
      console.error(
        'Blackbox replay checkpoints must each have one ordered data-checkpoint-anchor.',
        checkpointTimeline,
      );
      return;
    }

    let state: 'idle' | 'starting' | 'playing' | 'paused' | 'complete' = 'idle';
    let elapsed = 0;
    let startedAt = 0;
    let animationFrame = 0;
    let isVisible = false;
    let isAutoSuspended = false;

    const setControls = () => {
      cast.dataset.playerState = state;
      const canBrowseFiles = state === 'complete';
      playButton.disabled = state === 'starting';
      workspace?.setAttribute('aria-hidden', String(!canBrowseFiles));
      tabs.forEach((tab) => {
        tab.disabled = !canBrowseFiles;
        tab.setAttribute('aria-pressed', String(tab.classList.contains('is-active')));
      });

      if (state === 'starting') {
        playLabel.textContent = 'Starting session…';
        status.textContent = 'Positioning agent session';
      } else if (state === 'playing') {
        playLabel.textContent = 'Pause session';
        status.textContent = 'Agent session playing';
      } else if (state === 'paused') {
        playLabel.textContent = 'Resume session';
        status.textContent = 'Agent session paused';
      } else if (state === 'complete') {
        playLabel.textContent = 'Replay session';
        status.textContent = 'Agent session complete';
      } else {
        playLabel.textContent = 'See the behavioral verification loop';
        status.textContent = 'Session ready';
      }
    };

    const render = (playbackTime: number) => {
      const time = getStoryTime(playbackTime);
      let stageIndex = 0;
      stages.forEach((stage, index) => {
        if (time >= stage.start) stageIndex = index;
      });
      const currentStage = stages[stageIndex] ?? stages[0];
      stageLabel.textContent = currentStage.label;

      let checkpointIndex = 0;
      checkpointTimeline.forEach((checkpoint, index) => {
        if (time >= checkpoint.at) checkpointIndex = index;
      });
      stepLabel.textContent = `${checkpointIndex + 1} / ${checkpointTimeline.length}`;
      checkpointTimeline.forEach((checkpoint, index) => {
        const reached = time >= checkpoint.at;
        const complete = time >= storyDuration || reached;
        const active = time < storyDuration && index === checkpointIndex;
        checkpoint.element.classList.toggle('is-complete', complete);
        checkpoint.element.classList.toggle('is-active', active);
        if (active) checkpoint.element.setAttribute('aria-current', 'step');
        else checkpoint.element.removeAttribute('aria-current');
      });

      const currentCheckpoint = checkpointTimeline[checkpointIndex];
      if (!currentCheckpoint) return;
      const nextCheckpoint = checkpointTimeline[checkpointIndex + 1];
      const segmentProgress = nextCheckpoint
        ? Math.min(
            1,
            Math.max(
              0,
              (playbackTime - currentCheckpoint.playbackAt) /
                (nextCheckpoint.playbackAt - currentCheckpoint.playbackAt),
            ),
          )
        : 0;
      const checkpointProgress =
        checkpointTimeline.length > 1
          ? (checkpointIndex + segmentProgress) / (checkpointTimeline.length - 1)
          : 1;
      progress.style.transform = `scaleX(${checkpointProgress})`;

      const activeFrame =
        frames.find((frame) => {
          const start = Number(frame.dataset.start) || 0;
          const end = Number(frame.dataset.end) || storyDuration + 1;
          return time >= start && time < end;
        }) ?? frames[frames.length - 1];

      frames.forEach((frame) => {
        const active = frame === activeFrame;
        frame.hidden = !active;
        frame.classList.toggle('is-active', active);
      });

      if (introRequirement) {
        const introProgress = Math.min(1, Math.max(0, time / 600));
        const easedIntroProgress = 1 - Math.pow(1 - introProgress, 3);
        introRequirement.style.opacity = String(easedIntroProgress);
      }

      const activeFile = activeFrame?.dataset.fileName ?? '';
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === activeFile;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-pressed', String(active));
      });

      timedElements.forEach((element) => {
        const from = Number(element.dataset.from) || 0;
        const until = Number(element.dataset.until);
        const beforeEnd = !Number.isFinite(until) || time < until;
        element.classList.toggle('is-visible', time >= from && beforeEnd);
      });

      typedCode.forEach((target) => {
        const characters = Math.max(0, Math.floor((time - target.from) / target.speed));
        const isTyping = time >= target.from && characters < target.text.length;

        if (time < target.from) {
          target.element.textContent = '';
        } else if (isTyping) {
          target.element.textContent = target.text.slice(0, characters);
        } else if (target.element.innerHTML !== target.html) {
          target.element.innerHTML = target.html;
        }

        target.element.classList.toggle('is-typing', isTyping);
      });

      commands.forEach((command) => {
        const line = command.closest<HTMLElement>('[data-from]');
        const from = Number(line?.dataset.from) || 0;
        const text = command.dataset.text ?? '';
        const characters = Math.max(0, Math.floor((time - from) / 24));
        command.textContent = text.slice(0, characters);
        command.classList.toggle('is-typing', time >= from && characters < text.length);
      });

      terminalMessages.forEach((message) => {
        const characters = Math.max(0, Math.floor((time - message.from) / message.speed));
        const isTyping = time >= message.from && characters < message.text.length;

        if (isTyping) {
          message.element.textContent = message.text.slice(0, characters);
        } else if (message.element.innerHTML !== message.html) {
          message.element.innerHTML = message.html;
        }

        message.element.classList.toggle('is-typing', isTyping);
      });

      const terminalIsIdle =
        (time >= 4500 && time < 8850) ||
        (time >= 15400 && time < 22600) ||
        (time >= 36200 && time < 37800) ||
        time >= 48200;
      idlePrompt?.classList.toggle('is-visible', terminalIsIdle);

      const approved = time >= 12900;
      approvalChoices?.classList.toggle('is-approved', approved);

      const findingVisible = time >= 27500;
      suspectLine?.classList.toggle('is-suspect', findingVisible);
      if (implementationState) {
        implementationState.textContent = findingVisible ? 'finding points here' : 'implementation';
        implementationState.classList.toggle('is-finding', findingVisible);
      }

      if (workspaceState) {
        workspaceState.textContent = time < 8900
          ? 'agent working'
          : time < 11300
            ? 'validating Gherkin'
            : time < 12900
            ? 'review required'
            : time < 15400
              ? 'preparing system test'
              : time < 27500
                ? 'contract approved'
              : time < 41000
                ? 'repairing'
                : 'satisfied';
      }

      const introductionFocus = time < 610;
      const fileIsBeingWritten =
        (time >= 4200 && time < 8900) ||
        (time >= 36200 && time < 37800);
      const paneFocus =
        time >= 48500 ? 'both' : introductionFocus || fileIsBeingWritten ? 'editor' : 'terminal';
      if (workspaceMain) workspaceMain.dataset.focus = paneFocus;

      if (terminalBody && state === 'playing' && paneFocus === 'terminal') {
        terminalBody.scrollTop = terminalBody.scrollHeight;
      }
    };

    const finish = () => {
      elapsed = duration;
      render(elapsed);
      state = 'complete';
      animationFrame = 0;
      setControls();
    };

    const tick = (now: number) => {
      if (state !== 'playing') return;
      elapsed = Math.min(duration, now - startedAt);
      render(elapsed);

      if (elapsed >= duration) {
        finish();
        return;
      }

      animationFrame = window.requestAnimationFrame(tick);
    };

    const startFrameLoop = () => {
      if (!isVisible || document.hidden) {
        isAutoSuspended = true;
        return;
      }

      isAutoSuspended = false;
      startedAt = performance.now() - elapsed;
      animationFrame = window.requestAnimationFrame(tick);
    };

    const play = (restart = false) => {
      if (restart) elapsed = 0;
      state = 'playing';
      render(elapsed);
      setControls();
      startFrameLoop();
    };

    const waitForScrollToSettle = () =>
      new Promise<void>((resolve) => {
        const started = performance.now();
        let previousY = window.scrollY;
        let stableFrames = 0;

        const check = (now: number) => {
          const currentY = window.scrollY;
          stableFrames = Math.abs(currentY - previousY) < 0.5 ? stableFrames + 1 : 0;
          previousY = currentY;

          if ((now - started >= 160 && stableFrames >= 4) || now - started >= 1200) {
            resolve();
            return;
          }

          window.requestAnimationFrame(check);
        };

        window.requestAnimationFrame(check);
      });

    const startFromPlayer = async () => {
      elapsed = 0;
      state = 'starting';
      render(elapsed);
      setControls();

      await new Promise<void>((resolve) => window.requestAnimationFrame(() => resolve()));
      const player = cast.querySelector<HTMLElement>('.bb-agent-player');
      player?.scrollIntoView({
        behavior: prefersReducedMotion ? 'auto' : 'smooth',
        block: 'start',
      });
      if (!prefersReducedMotion) await waitForScrollToSettle();

      if (state === 'starting') play();
    };

    const pause = () => {
      if (state !== 'playing') return;
      elapsed = Math.min(duration, performance.now() - startedAt);
      window.cancelAnimationFrame(animationFrame);
      animationFrame = 0;
      isAutoSuspended = false;
      state = 'paused';
      render(elapsed);
      setControls();
    };

    const suspendAutomatically = () => {
      if (state !== 'playing' || isAutoSuspended) return;
      elapsed = Math.min(duration, performance.now() - startedAt);
      window.cancelAnimationFrame(animationFrame);
      animationFrame = 0;
      isAutoSuspended = true;
      render(elapsed);
    };

    const resumeAutomatically = () => {
      if (state !== 'playing' || !isAutoSuspended || !isVisible || document.hidden) return;
      startFrameLoop();
    };

    const selectCompletedFile = (fileName: string) => {
      if (state !== 'complete') return;

      const selectedFrame = frames
        .filter((frame) => frame.dataset.fileName === fileName)
        .sort((first, second) => Number(second.dataset.start) - Number(first.dataset.start))[0];

      if (!selectedFrame) return;

      frames.forEach((frame) => {
        const active = frame === selectedFrame;
        frame.hidden = !active;
        frame.classList.toggle('is-active', active);
      });
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === fileName;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-pressed', String(active));
      });
      if (workspaceMain) workspaceMain.dataset.focus = 'both';
      status.textContent = `Opened ${fileName}`;
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => selectCompletedFile(tab.dataset.tab ?? ''));
    });

    cast.classList.add('is-enhanced');

    if (prefersReducedMotion) {
      elapsed = duration;
      state = 'complete';
      render(elapsed);
      setControls();
      if (terminalBody) terminalBody.scrollTop = terminalBody.scrollHeight;
      return;
    }

    render(0);
    setControls();

    playButton.addEventListener('click', () => {
      if (state === 'playing') pause();
      else if (state === 'idle' || state === 'complete') void startFromPlayer();
      else if (state === 'paused') play();
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        isVisible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.45);

        if (isVisible) resumeAutomatically();
        else suspendAutomatically();
      },
      { threshold: [0, 0.45] },
    );

    observer.observe(cast);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) suspendAutomatically();
      else resumeAutomatically();
    });
  });
</script>


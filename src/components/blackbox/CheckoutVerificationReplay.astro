    min-width: 0;
    margin: 8px 0 30px;
  }

  .bb-agent-player {
    display: none;
    gap: 18px;
    margin-bottom: 16px;
    padding: 14px 16px;
    border: 1px solid color-mix(in oklab, var(--border) 44%, transparent);

    display: inline-flex;
  }

  .bb-agent-cast.is-enhanced[data-player-state='starting'] .bb-agent-player,
  .bb-agent-cast.is-enhanced[data-player-state='playing'] .bb-agent-player,
  .bb-agent-cast.is-enhanced[data-player-state='paused'] .bb-agent-player,
  .bb-agent-cast.is-enhanced[data-player-state='complete'] .bb-agent-player {
    display: grid;
    animation: bb-agent-player-enter 520ms var(--ui-transition-ease) both;
  }

  @keyframes bb-agent-player-enter {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .bb-agent-shell {
    display: flex;
    overflow: hidden;
    flex-direction: column;
    border: 1px solid var(--cast-line-light);
    border-radius: 10px;
    background: var(--cast-bg);
    box-shadow: 0 16px 44px rgb(0 0 0 / 20%);
  }

  .bb-agent-control {
    position: relative;
    display: inline-flex;
    min-height: 24px;
    align-items: center;
    gap: 5px;
    padding: 0 2px;
    border: 0;
    border-radius: 4px;
    color: var(--primary-light);
    background: transparent;
    box-shadow: none;
    font-family: var(--font-interface);
    font-size: 0.76rem;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--primary-border);
    text-underline-offset: 3px;
    cursor: pointer;
    transition:
      transform 180ms var(--ui-transition-ease),
      background-color 180ms var(--ui-transition-ease),
      box-shadow 180ms var(--ui-transition-ease);
  }

  .bb-agent-control::before {
    position: absolute;
    inset: -10px -6px;
    content: '';
  }

  .bb-agent-cast[data-player-state='idle'] .bb-agent-control {
    animation: bb-agent-invitation 2.8s ease-in-out 2;
  }

  .bb-agent-control:hover {
    color: var(--primary-light);
    background: var(--primary-soft);
    box-shadow: none;
    transform: none;
  }

  .bb-agent-control:disabled {
    opacity: 0.72;
    cursor: wait;
  }

  .bb-agent-control:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }

  .bb-agent-control svg {
    width: 11px;
    height: 11px;
    fill: currentColor;
  }

  .bb-agent-control__pause {
    display: none;
  }

  .bb-agent-cast[data-player-state='playing'] .bb-agent-control__play {
    display: none;
  }

  .bb-agent-cast[data-player-state='playing'] .bb-agent-control__pause {
    display: block;
  }

  .bb-agent-checkpoints {
    position: relative;
    min-width: 0;
  }

  .bb-agent-checkpoints__rail {
    position: absolute;
    z-index: 0;
    top: 8px;
    right: calc(100% / 12);
    left: calc(100% / 12);
    height: 2px;
    overflow: hidden;
    background: var(--border-strong);
  }

  .bb-agent-checkpoints__rail span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }

  .bb-agent-checkpoints ol {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bb-agent-checkpoints li {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 7px;
    color: var(--text-muted);
    font-family: var(--font-interface);
    font-size: 0.68rem;
    font-weight: 650;
    text-align: center;
    outline: none;
    transition: color 180ms var(--ui-transition-ease);
  }

  .bb-agent-checkpoints li i {
    position: relative;
    display: grid;
    width: 18px;
    height: 18px;
    box-sizing: border-box;
    place-items: center;
    border: 2px solid var(--border-strong);
    border-radius: 50%;
    background: var(--surface);
    transition:
      border-color 180ms var(--ui-transition-ease),
      background-color 180ms var(--ui-transition-ease),
      box-shadow 180ms var(--ui-transition-ease);
  }

  .bb-agent-checkpoints li:focus-visible i {
    outline: 2px solid var(--primary);
    outline-offset: 4px;
  }

  .bb-agent-checkpoints li small {
    position: absolute;
    z-index: 10;
    bottom: calc(100% + 10px);
    left: 50%;
    width: max-content;
    max-width: 220px;
    padding: 7px 9px;
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    color: var(--text);
    background: var(--surface);
    box-shadow: 0 8px 22px rgb(0 0 0 / 12%);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.35;
    text-align: left;
    white-space: normal;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, 4px);
    transition:
      opacity 160ms var(--ui-transition-ease),
      transform 160ms var(--ui-transition-ease),
      visibility 160ms var(--ui-transition-ease);
  }

  .bb-agent-checkpoints li:first-child small {
    left: 0;
    transform: translateY(4px);
  }

  .bb-agent-checkpoints li:last-child small {
    right: 0;
    left: auto;
    transform: translateY(4px);
  }

  .bb-agent-checkpoints li:hover small,
  .bb-agent-checkpoints li:focus-visible small {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .bb-agent-checkpoints li:first-child:hover small,
  .bb-agent-checkpoints li:first-child:focus-visible small,
  .bb-agent-checkpoints li:last-child:hover small,
  .bb-agent-checkpoints li:last-child:focus-visible small {
    transform: translateY(0);
  }

  .bb-agent-checkpoints li.is-active {
    color: var(--text);
  }

  .bb-agent-checkpoints li.is-active i {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px var(--primary-soft);
  }

  .bb-agent-checkpoints li.is-complete {
    color: var(--primary-light);
  }

  .bb-agent-checkpoints li.is-complete i {
    border-color: var(--primary);
    background: var(--primary);
  }

  .bb-agent-checkpoints li.is-complete i::after {
    width: 4px;
    height: 7px;
    margin-top: -2px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    content: '';
    transform: rotate(45deg);
  }

  @keyframes bb-agent-invitation {
    50% {
      background: var(--primary-soft);
    }
  }

  .bb-agent-workspace {
    --text: var(--cast-text);
    --text-muted: var(--cast-ui-text);
    --text-soft: var(--cast-muted);
    --border: var(--cast-line);
    --border-strong: var(--cast-line-light);
    --primary: var(--cast-info);
    --primary-soft: var(--cast-tab-selected);
    --primary-border: var(--cast-tab-underline);
    --success: var(--cast-success);
    --warning: var(--cast-warning);
    --error: var(--cast-error);
    --info: var(--cast-info);
    order: 1;
    overflow: hidden;
    border: 0;
    border-radius: 0;
    background: var(--cast-bg);
    box-shadow: none;
  }

  .bb-agent-workspace__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 42px;
    align-items: center;
    padding: 0 14px;
    border-bottom: 1px solid var(--cast-line);
    color: var(--text-soft);
    background: var(--cast-bg);
    font-family: var(--font-interface);
    font-size: 0.66rem;
  }

  .bb-agent-workspace__dots {
    display: flex;
    gap: 6px;
  }

  .bb-agent-workspace__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--cast-muted);
  }

  .bb-agent-workspace__dots i:first-child {
    background: var(--cast-ui-error);
  }

  .bb-agent-workspace__dots i:nth-child(2) {
    background: var(--cast-ui-warning);
  }

  .bb-agent-workspace__dots i:last-child {
    background: var(--cast-ui-success);
  }

  .bb-agent-workspace__title {
    color: var(--text-muted);
  }

  .bb-agent-workspace__state {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
  }

  .bb-agent-workspace__state i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cast-ui-info);
  }

  .bb-agent-workspace__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 300px 326px;
    min-width: 0;
  }

  .bb-agent-editor,
  .bb-agent-terminal {
    transition:
      opacity 520ms var(--ui-transition-ease),
      filter 520ms var(--ui-transition-ease);
  }

  .bb-agent-cast.is-enhanced .bb-agent-workspace__main[data-focus='editor'] .bb-agent-terminal {
    opacity: 0.28;
    filter: saturate(0.42) brightness(0.78);
  }

  .bb-agent-cast.is-enhanced .bb-agent-workspace__main[data-focus='terminal'] .bb-agent-editor {
    opacity: 0.3;
    filter: saturate(0.38) brightness(0.82);
  }

  .bb-agent-editor {
    grid-column: 1;
    grid-row: 2;
    min-width: 0;
    overflow: hidden;
    background: var(--cast-panel);
  }

  .bb-agent-tabs {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    border-bottom: 1px solid var(--cast-line);
    background: var(--cast-panel);
    scrollbar-width: none;
  }

  .bb-agent-tabs::-webkit-scrollbar {
    display: none;
  }

  .bb-agent-tab {
    appearance: none;
    flex: 0 0 auto;
    margin: 0;
    padding: 10px 12px;
    border: 0;
    border-right: 1px solid var(--cast-line);
    color: var(--text-soft);
    background: transparent;
    font-family: var(--font-interface);
    font-size: 0.84rem;
    font-weight: 600;
    text-align: left;
    white-space: nowrap;
  }

  .bb-agent-tab:disabled {
    opacity: 1;
    cursor: default;
  }

  .bb-agent-cast[data-player-state='complete'] .bb-agent-tab:not(:disabled) {
    cursor: pointer;
  }

  .bb-agent-cast[data-player-state='complete'] .bb-agent-tab:not(:disabled):hover {
    color: var(--cast-ui-text);
    background: var(--cast-tab-hover);
  }

  .bb-agent-tab:focus-visible {
    outline: 2px solid var(--cast-focus);
    outline-offset: -2px;
  }

  .bb-agent-tab.is-active {
    color: var(--text);
    background: var(--cast-tab-selected);
    box-shadow: inset 0 2px var(--cast-tab-underline);
  }

  .bb-agent-editor__viewport {
    position: relative;
    height: 289px;
    overflow: hidden;
  }

  .bb-agent-frame {
    position: absolute;
    inset: 0;
    min-width: 0;
    overflow: auto;
    background: var(--cast-panel);
  }

  .bb-agent-frame[hidden] {
    display: none;
  }

  .bb-agent-frame > header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 30px;
    padding: 0 12px;
    border-bottom: 1px solid var(--cast-line);
    color: var(--text-muted);
    font-family: var(--font-interface);
    font-size: 0.64rem;
  }

  .bb-agent-frame > header small {
    color: var(--text-soft);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bb-agent-frame > header small.is-verified {
    color: var(--cast-success);
  }

  .bb-agent-frame > header small.is-finding {
    color: var(--cast-error);
  }

  .bb-agent-frame pre {
    min-width: max-content;
    margin: 0;
    padding: 8px 10px 10px;
    color: color-mix(in oklab, var(--text) 90%, var(--text-muted));
    background: transparent;
    font-family: Menlo, Monaco, Consolas, monospace;
    font-size: 0;
    line-height: 0;
    tab-size: 2;
  }

  .bb-agent-frame .line {
    display: block;
    min-height: 1.2em;
    padding: 0 4px;
    border-left: 2px solid transparent;
    font-size: 0.96rem;
    line-height: 1.2;
    white-space: pre;
  }

  .bb-agent-frame--test-suite pre,
  .bb-agent-frame--test-suite .line {
    width: max-content;
    min-width: 100%;
    white-space: pre;
  }

  .bb-agent-frame .is-suspect {
    border-left-color: var(--cast-error);
    background: color-mix(in oklab, var(--error) 10%, transparent);
  }

  .bb-agent-frame .is-fixed {
    border-left-color: var(--cast-success);
    background: color-mix(in oklab, var(--success) 8%, transparent);
  }

  .tok-heading,
  .tok-tag {
    color: var(--cast-annotation);
    font-style: normal;
  }

  .tok-call {
    color: var(--cast-function);
    font-style: normal;
  }

  .tok-keyword {
    color: var(--cast-accent);
    font-style: normal;
  }

  .bb-agent-frame[data-file-name='features/checkout.feature'] .tok-keyword {
    color: var(--cast-accent);
  }

  .bb-agent-frame[data-file-name='effects.yaml'] .tok-keyword {
    color: var(--cast-property);
  }

  .tok-string {
    color: var(--cast-string);
    font-style: normal;
  }

  .tok-number {
    color: var(--cast-number);
    font-style: normal;
  }

  .bb-agent-frame pre.is-diff {
    padding-top: 24px;
  }

  .bb-agent-frame .line--remove {
    border-left-color: var(--cast-error);
    color: color-mix(in oklab, var(--text) 86%, var(--cast-error));
    background: color-mix(in oklab, var(--error) 11%, transparent);
  }

  .bb-agent-frame .line--remove i {
    color: var(--cast-error);
    font-style: normal;
    font-weight: 900;
  }

  .bb-agent-diff-summary {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 24px;
    color: var(--text-soft);
    font-family: var(--font-interface);
    font-size: 0.64rem;
  }

  .bb-agent-diff-summary b {
    color: var(--cast-error);
  }

  .bb-agent-terminal {
    grid-column: 1 / -1;
    grid-row: 1;
    min-width: 0;
    overflow: hidden;
    border-bottom: 1px solid var(--cast-line);
    background: var(--cast-terminal);
  }

  .bb-agent-terminal__bar {
    display: flex;
    min-height: 34px;
    align-items: center;
    justify-content: space-between;
    padding: 0 14px;
    border-bottom: 1px solid var(--cast-line);
    color: var(--cast-terminal-soft);
    background: var(--cast-terminal);
    font-family: var(--font-interface);
    font-size: 0.59rem;
    letter-spacing: 0.06em;
  }

  .bb-agent-terminal__body {
    height: 266px;
    overflow: auto;
    padding: 13px 16px 18px;
    color: var(--cast-terminal-text);
    font-family: Menlo, Monaco, Consolas, monospace;
    font-size: 0.9rem;
    line-height: 1.1;
    scroll-behavior: auto;
  }

  .bb-agent-terminal__line {
    display: flex;
    min-height: 1.35em;
    align-items: baseline;
    gap: 1ch;
    white-space: pre-wrap;
  }

  .bb-agent-terminal__line--phase-start {
    margin-top: 12px;
  }

  .bb-agent-terminal__line--developer {
    align-items: flex-start;
    gap: 0.9ch;
    margin: 8px 0 10px;
    padding: 7px 3px 8px;
    border-top: 1px solid color-mix(in oklab, var(--cast-terminal-soft) 54%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--cast-terminal-soft) 54%, transparent);
    background: transparent;
  }

  .bb-agent-terminal__line--developer > i {
    flex: 0 0 auto;
    color: var(--cast-terminal-magenta);
    font-style: normal;
    font-weight: 850;
  }

  .bb-agent-terminal__line--developer > span {
    min-width: 0;
    flex: 1;
    color: var(--cast-terminal-bright);
  }

  .bb-agent-terminal__line--approval {
    display: block;
    margin: 9px 0 11px;
    padding: 11px 0 10px;
    border-top: 1px solid var(--cast-line-light);
    border-bottom: 1px solid var(--cast-line-light);
    color: var(--cast-terminal-text);
    white-space: normal;
  }

  .bb-agent-terminal__line--approval > strong {
    display: block;
    margin-bottom: 10px;
    color: var(--cast-terminal-bright);
    font-weight: 750;
  }

  .bb-agent-terminal__line--approval > div {
    display: grid;
    gap: 3px;
    margin: 0 0 11px 3ch;
  }

  .bb-agent-terminal__line--approval > div code {
    padding: 0;
    color: var(--cast-terminal-bright);
    background: transparent;
    font: inherit;
  }

  .bb-agent-terminal__line--approval > div small {
    color: var(--cast-terminal-soft);
  }

  .bb-agent-terminal__line--approval p {
    margin: 0 0 8px;
  }

  .bb-agent-terminal__line--approval ol {
    display: grid;
    gap: 4px;
    margin: 2px 0 0;
    padding: 0;
    list-style: none;
  }

  .bb-agent-terminal__line--approval li {
    display: grid;
    grid-template-columns: 2ch minmax(0, 1fr);
    gap: 0.6ch;
    color: var(--cast-terminal-text);
  }

  .bb-agent-terminal__line--approval li b {
    color: var(--cast-terminal-magenta);
  }

  .bb-agent-terminal__line--approval li:first-child {
    color: var(--cast-terminal-bright);
    font-weight: 700;
  }

  .bb-agent-terminal__line--approval.is-approved li:first-child,
  .bb-agent-terminal__line--approval.is-approved li:first-child b {
    color: var(--cast-terminal-green);
  }

  .bb-agent-terminal__line--approval.is-approved li:last-child {
    opacity: 0.48;
  }

  .bb-agent-terminal__line--agent b {
    color: var(--cast-terminal-blue);
  }

  .bb-agent-terminal__line--agent > span {
    color: var(--cast-terminal-text);
  }

  .bb-agent-terminal__line--agent > strong {
    color: var(--cast-terminal-bright);
  }

  .bb-agent-terminal__file-ref {
    padding: 0;
    color: var(--cast-terminal-cyan);
    background: transparent;
    font: inherit;
    font-weight: 700;
  }

  .bb-agent-terminal__line--skill b {
    color: var(--cast-terminal-blue);
  }

  .bb-agent-terminal__line--skill span {
    color: var(--cast-terminal-text);
  }

  .bb-agent-terminal__line--skill span strong {
    color: var(--cast-terminal-bright);
  }

  .bb-agent-terminal__line--review b {
    color: var(--cast-warning);
  }

  .bb-agent-terminal__line--review span {
    color: var(--cast-warning);
  }

  .bb-agent-terminal__line--success b,
  .bb-agent-terminal__line--success {
    color: var(--cast-terminal-green);
  }

  .bb-agent-terminal__line--success strong {
    color: var(--cast-terminal-bright);
  }

  .bb-agent-terminal__line--success span {
    color: var(--cast-terminal-green);
  }

  .bb-agent-terminal__line--edited > b {
    color: var(--cast-terminal-blue);
  }

  .bb-agent-terminal__line--edited > strong {
    color: var(--cast-terminal-bright);
    font-weight: 850;
  }

  .bb-agent-terminal__line--edited > span {
    color: var(--cast-terminal-text);
  }

  .bb-agent-terminal__line--command {
    margin-top: 7px;
    color: var(--cast-terminal-text);
    font-weight: 650;
    white-space: nowrap;
  }

  .bb-agent-terminal__line--command > b {
    color: var(--cast-terminal-blue);
  }

  .bb-agent-terminal__line--command > span {
    color: var(--cast-terminal-text);
    font-weight: 500;
  }

  .bb-agent-terminal__line--command > span strong {
    color: var(--cast-terminal-bright);
    font-weight: 850;
  }

  .bb-agent-terminal__line--command code {
    padding: 0;
    color: inherit;
    background: transparent;
    font: inherit;
  }

  .bb-agent-terminal__line--tool-output {
    gap: 0.8ch;
    padding-left: 2ch;
    color: var(--cast-terminal-soft);
  }

  .bb-agent-terminal__line--tool-output > b {
    width: 2ch;
    flex: 0 0 2ch;
    color: var(--cast-terminal-soft);
    text-align: center;
  }

  .bb-agent-terminal__line--tool-output > span {
    min-width: 0;
    color: var(--cast-terminal-text);
  }

  .bb-agent-terminal__line--tool-output > span > strong:not(.is-pass) {
    color: var(--cast-terminal-cyan);
  }

  .bb-agent-terminal__line--generated {
    min-width: max-content;
    white-space: nowrap;
  }

  .bb-agent-terminal__line--duration {
    gap: 0.8ch;
    margin: 7px 0 8px;
    color: var(--cast-terminal-soft);
    font-size: 0.92em;
  }

  .bb-agent-terminal__line--duration > b {
    color: var(--cast-terminal-yellow);
  }

  .bb-agent-terminal__line--diff {
    gap: 0;
    padding-left: 2ch;
    color: var(--cast-terminal-text);
  }

  .bb-agent-terminal__line--diff > span {
    width: 4ch;
    flex: 0 0 4ch;
    color: var(--cast-terminal-soft);
    text-align: right;
  }

  .bb-agent-terminal__line--diff > i {
    width: 3ch;
    flex: 0 0 3ch;
    color: var(--cast-terminal-soft);
    font-style: normal;
    text-align: center;
  }

  .bb-agent-terminal__line--diff > code {
    padding: 0;
    color: inherit;
    background: transparent;
    font: inherit;
  }

  .bb-agent-terminal__line--diff-add {
    color: var(--cast-terminal-green);
    background: color-mix(in oklab, var(--cast-terminal-green) 9%, transparent);
  }

  .bb-agent-terminal__line--diff-add > i {
    color: var(--cast-terminal-green);
  }

  .bb-agent-terminal__line--diff-remove {
    color: var(--cast-terminal-red);
    background: color-mix(in oklab, var(--cast-terminal-red) 12%, transparent);
  }

  .bb-agent-terminal__line--diff-remove > i {
    color: var(--cast-terminal-red);
  }

  .bb-agent-terminal__line--result,
  .bb-agent-terminal__line--observation {
    display: grid;
    grid-template-columns: 13ch 12ch minmax(0, 1fr);
    column-gap: 1ch;

---
import { Code } from 'astro-expressive-code/components';
import Aside from '@/components/mdx/Aside.astro';
import QuickstartTrackDiagram from './QuickstartTrackDiagram.astro';

const existingSteps = [
  'Add wrapper',
  'Run command',
  'Review catalog',
  'Tighten catalog',
  'Read coverage',
];

const newSteps = [
  'Run showcase',
  'Inspect proof',
  'Copy test shape',
  'Write one flow',
  'Read coverage',
];

const existingTestSnippet = `import { expect, test } from './testbed.js';

test.system('checkout-flow', 'customer completes checkout', () => {
  test('existing checkout test', async ({ capture, request, system }) => {
    const response = await request.post(\`\${system.app.hostBaseUrl}/checkout\`, {
      data: { cartId: 'cart-123', paymentMethodId: 'pm_card_visa' },
    });

    expect(response.status()).toBe(201);

    await expect(capture).toMatchCatalog();
  });
});`;

const showcaseTestSnippet = `import { expect, test } from './testbed.js';

test.system('subscribe-flow', 'subscribing a user to the pro tier', () => {
  test('alice subscribes', async ({ capture, request, system }) => {
    const response = await request.post(\`\${system.bff.hostBaseUrl}/subscriptions\`, {
      data: { userId: 'alice', paymentMethodId: 'pm_card_visa' },
    });

    expect(response.status()).toBe(201);

    await expect(capture).toMatchCatalog();
  });
});`;

const existingCatalogSnippet = `specVersion: "0.1"

checkout-flow:
  requires:
    - { boundary: postgres, op: INSERT, key: orders }
    - { boundary: http, op: POST, key: /payments }
    - { boundary: sqs, op: SendMessage }`;

const existingReviewedCatalogSnippet = `specVersion: "0.1"

checkout-flow:
  requires:
    - { boundary: postgres, op: INSERT, key: orders }
  forbids:
    - { boundary: http, op: POST, key: /refunds }`;

const showcaseCatalogSnippet = `specVersion: "0.1"

subscribe-flow:
  requires:
    - { boundary: redis, op: GET, key: "user:*:tier" }
    - { boundary: postgres, op: INSERT, key: subscriptions }
    - { boundary: sqs, op: SendMessage }
  forbids:
    - { boundary: postgres, op: DELETE }
    - { boundary: http, op: POST, key: /v1/refunds }`;

const playwrightExampleCommand = `npx playwright test --config ./e2e/playwright.config.ts`;

const showcaseRunCommand = `pnpm test:system`;

const baselineMessage = `toMatchCatalog: no catalog entry for "checkout-flow"; baseline pending.
Will be written at fixture teardown.`;

const generatedCatalogPath = `created: e2e/tests/__effects__/checkout-flow.system.effects.yaml
next: review requires and forbids before committing`;

const coverageRows = [
  { metric: 'catalog entries', value: '1', tone: 'neutral' },
  { metric: 'satisfied', value: '1 (100%)', tone: 'good' },
  { metric: 'failed', value: '0', tone: 'quiet' },
  { metric: 'uncovered', value: '0', tone: 'quiet' },
];

const coverageJsonSnippet = `{
  "catalog": { "entries": 1 },
  "summary": { "satisfied": 1, "failed": 0, "uncovered": 0 },
  "perEntry": {
    "checkout-flow": { "state": "satisfied", "runs": 1 }
  }
}`;

const showcaseRunOutput = `✓ subscribe-flow › alice subscribes

captured effects
  redis       GET user:alice:tier
  postgres   INSERT subscriptions
  http        POST /v1/payment_intents
  sqs         SendMessage subscription.created

written: e2e/tests/__effects__/00-baseline-subscribe.system.effects.yaml
written: e2e/.blackbox-coverage/catalog/coverage.json`;

const showcaseProofArtifacts = `e2e/tests/__effects__/00-baseline-subscribe.system.effects.yaml
e2e/.blackbox-coverage/catalog/coverage.json
e2e/.blackbox-coverage/omcdc/verdict.md`;

const featureCommands = `pnpm exec blackbox features emit ./e2e/tests --out ./e2e/features
pnpm exec blackbox features check --features ./e2e/features --tests ./e2e/tests`;

const featureOutput = `emitted: e2e/features/subscribe-flow.feature
checked: 1 feature file, 1 source test
status: in sync`;
---

<section class="bb-quickstart" id="quickstart-track" data-active-track="existing">
  <div class="bb-track-pick" aria-label="Choose a quickstart track">
    <a class="bb-track-option is-active" href="?track=existing#quickstart-track" data-track-choice="existing" aria-controls="track-existing" aria-current="true">
      <span>Existing tests</span>
      <strong>Add Blackbox to one flow</strong>
      <em>Add Blackbox to one flow, review its effect catalog, and rerun until one catalog entry is covered.</em>
      <b>Start with an existing test</b>
    </a>
    <a class="bb-track-option" href="?track=new#quickstart-track" data-track-choice="new" aria-controls="track-new">
      <span>No system tests yet</span>
      <strong>Run the showcase first</strong>
      <em>Run the Blackbox showcase, inspect the proof trail, then copy the smallest system-test shape.</em>
      <b>Start with the showcase</b>
    </a>
  </div>

  <div class="bb-preflight" aria-label="Quickstart success criteria">
    <div class="bb-preflight-panel">
      <span>Start with</span>
      <strong>One runnable system flow</strong>
      <p>Use an existing test command or the showcase SUT. You only need one place to write artifacts.</p>
    </div>
    <div class="bb-preflight-panel is-success">
      <span>Stop at</span>
      <strong>One satisfied coverage entry</strong>
      <p>Run once, review one catalog entry, rerun, and see effect coverage turn green.</p>
    </div>
  </div>

  <nav class="bb-track-progress" aria-label="Quickstart track progress">
    <div class="bb-track-progress-head">
      <strong data-progress-title>Progress</strong>
      <span data-progress-count>Step 1 of 5</span>
    </div>
    <div class="bb-track-rail" aria-hidden="true">
      <span></span>
    </div>
    <ol data-progress-list="existing">
      {existingSteps.map((step, index) => (
        <li data-progress-index={index}>
          <a href={`#existing-step-${index + 1}`}>
            <span>{index + 1}</span>
            {step}
          </a>
        </li>
      ))}
    </ol>
    <ol data-progress-list="new" hidden>
      {newSteps.map((step, index) => (
        <li data-progress-index={index}>
          <a href={`#new-step-${index + 1}`}>
            <span>{index + 1}</span>
            {step}
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <article class="bb-track-panel is-active" id="track-existing" data-track-panel="existing">
    <h2>Existing Tests: Add Effect Coverage To One Flow</h2>
    <p>Use this path when you already have a system or E2E test that exercises a valuable flow. The first win is not a new suite. It is evidence for behavior your existing test already drives.</p>
    <QuickstartTrackDiagram kind="existing" />

    <section id="existing-step-1" data-track-section="existing">
      <h3><span aria-hidden="true">1</span>Add the Blackbox wrapper and matcher</h3>
      <p>Keep the request and response assertions you already trust. Add the Blackbox system boundary and <code>toMatchCatalog()</code> at the end of one valuable flow.</p>
      <Code code={existingTestSnippet} lang="ts" />
    </section>

    <section id="existing-step-2" data-track-section="existing">
      <h3><span aria-hidden="true">2</span>Run your normal system-test command</h3>
      <p>Blackbox does not need to replace your runner. Use the command your project already uses; the Playwright command below is only an example.</p>
      <Code code={playwrightExampleCommand} lang="bash" />
      <Aside type="note" title="Expected first-run signal">
        You should see a baseline-pending message the first time the catalog entry does not exist.
      </Aside>
      <p>That message means Blackbox has seen this flow, but there is no reviewed effect contract for it yet. The run continues, records the observed effects, and writes a draft catalog entry for you to review before the next run enforces it.</p>
      <Code code={baselineMessage} lang="text" />
      <Code code={generatedCatalogPath} lang="text" />
    </section>

    <section id="existing-step-3" data-track-section="existing">
      <h3><span aria-hidden="true">3</span>Review the effect catalog</h3>
      <p>The first useful artifact is the generated catalog. It starts as observed behavior, not a trusted contract. Review it before committing it.</p>
      <Code code={existingCatalogSnippet} lang="yaml" />
      <Aside type="info" title="Catalogs are contracts after review">
        Keep effects that define correctness, delete noise, and add forbids for behavior that would make the flow unsafe. See <a href="/docs/blackbox/reference/catalog-schema">Catalog Schema</a> for the durable format.
      </Aside>
    </section>

    <section id="existing-step-4" data-track-section="existing">
      <h3><span aria-hidden="true">4</span>Tighten the catalog to one meaningful contract</h3>
      <p><code>toMatchCatalog()</code> is already the matcher. Your job here is to edit the catalog: keep one required effect that proves useful behavior and add one forbid for behavior that must not happen.</p>
      <Code code={existingReviewedCatalogSnippet} lang="yaml" />
      <Aside type="note" title="Start intentionally small">
        One required effect and one forbidden effect are enough for the first loop. Broaden the catalog after the team trusts the signal.
      </Aside>
    </section>

    <section id="existing-step-5" data-track-section="existing">
      <h3><span aria-hidden="true">5</span>Rerun and read effect coverage</h3>
      <p>On the next run, the terminal should show whether the reviewed catalog entry was satisfied, failed, or uncovered.</p>
      <figure class="bb-coverage-output" aria-label="Effect coverage output for checkout-flow">
        <div class="bb-coverage-head">
          <span>effect coverage</span>
          <strong>1 satisfied</strong>
        </div>
        <div class="bb-coverage-table" role="table" aria-label="Effect coverage summary">
          <div class="bb-coverage-row is-header" role="row">
            <span role="columnheader">metric</span>
            <span role="columnheader">value</span>
          </div>
          {coverageRows.map((row) => (
            <div class={`bb-coverage-row is-${row.tone}`} role="row">
              <span role="cell">{row.metric}</span>
              <strong role="cell">{row.value}</strong>
            </div>
          ))}
        </div>
        <div class="bb-coverage-entry">
          <span aria-hidden="true">✓</span>
          <code>checkout-flow</code>
          <strong>satisfied</strong>
          <em>1/1 runs</em>
        </div>
        <figcaption>written: &lt;coverage-dir&gt;/catalog/coverage.json</figcaption>
      </figure>
      <p>The same run also writes a machine-readable summary for CI, dashboards, and agent context.</p>
      <Code code={coverageJsonSnippet} lang="json" />
      <Aside type="tip" title="First quickstart win">
        The same flow now proves something about the behavior inside the system, not only its response. Read <a href="/docs/blackbox/concepts/system-effects">System Effects</a> when you want the mental model behind catalog coverage and OMC/DC.
      </Aside>
    </section>
  </article>

  <article class="bb-track-panel" id="track-new" data-track-panel="new" hidden>
    <h2>Showcase First: Learn The Proof Loop</h2>
    <p>Use this path when you do not yet have a useful system test. First learn the proof loop in the Blackbox showcase, then write one narrow flow in your own system.</p>
    <Aside type="info" title="The showcase SUT">
      The example system under test is a small subscription backend. The test calls the BFF, and the BFF touches Redis, Postgres, a payment HTTP boundary, and SQS. That gives the quickstart enough behavior to show required effects, forbidden effects, catalog coverage, and OMC/DC reports.
    </Aside>
    <QuickstartTrackDiagram kind="showcase-sut" />

    <section id="new-step-1" data-track-section="new">
      <h3><span aria-hidden="true">1</span>Run the showcase</h3>
      <p>From the Blackbox showcase repo root, run the system-test script. The subscription flow is intentionally small but effect-rich: Redis, Postgres, HTTP, and SQS all participate.</p>
      <Code code={showcaseRunCommand} lang="bash" />
      <Code code={showcaseRunOutput} lang="text" />
    </section>

    <section id="new-step-2" data-track-section="new">
      <h3><span aria-hidden="true">2</span>Inspect the proof trail</h3>
      <p>A successful showcase run should produce a catalog and coverage artifacts. Start with these three; spans and V8 payloads are diagnostics for later.</p>
      <Code code={showcaseProofArtifacts} lang="text" />
      <Aside type="info" title="What to inspect first">
        Open the effect catalog before the OMC/DC report. The catalog tells you what behavior the test observed; OMC/DC tells you where decision evidence is still thin. See <a href="/docs/blackbox/reference/files-and-artifacts">Files and Artifacts</a> for the full inventory.
      </Aside>
    </section>

    <section id="new-step-3" data-track-section="new">
      <h3><span aria-hidden="true">3</span>Copy the smallest test shape</h3>
      <p>The important shape is <code>test.system(...)</code> plus <code>toMatchCatalog()</code>. The matcher seeds a baseline when no catalog entry exists, then enforces the reviewed catalog on later runs.</p>
      <Code code={showcaseTestSnippet} lang="ts" />
      <Aside type="note" title="Use your runner, not a new testing religion">
        Blackbox is the evidence layer around a system flow. Today this quickstart assumes Playwright for the runnable system-test path.
      </Aside>
    </section>

    <section id="new-step-4" data-track-section="new">
      <h3><span aria-hidden="true">4</span>Write one narrow flow in your system</h3>
      <p>Pick a flow where input/output success is not enough: checkout, signup, webhook handling, account deletion, refund prevention, or another side-effect-heavy path.</p>
      <Aside type="tip" title="Keep it narrow">
        The goal is not a broad journey. The goal is one controlled system flow whose effects matter.
      </Aside>
    </section>

    <section id="new-step-5" data-track-section="new">
      <h3><span aria-hidden="true">5</span>Review the catalog and read coverage</h3>
      <p>The first custom catalog begins as observed behavior. Keep the effects that define correctness, add forbids for dangerous behavior, then rerun to see effect coverage.</p>
      <Code code={showcaseCatalogSnippet} lang="yaml" />
      <figure class="bb-coverage-output" aria-label="Effect coverage output for subscribe-flow">
        <div class="bb-coverage-head">
          <span>effect coverage</span>
          <strong>1 satisfied</strong>
        </div>
        <div class="bb-coverage-table" role="table" aria-label="Effect coverage summary">
          <div class="bb-coverage-row is-header" role="row">
            <span role="columnheader">metric</span>
            <span role="columnheader">value</span>
          </div>
          {coverageRows.map((row) => (
            <div class={`bb-coverage-row is-${row.tone}`} role="row">
              <span role="cell">{row.metric}</span>
              <strong role="cell">{row.value}</strong>
            </div>
          ))}
        </div>
        <div class="bb-coverage-entry">
          <span aria-hidden="true">✓</span>
          <code>subscribe-flow</code>
          <strong>satisfied</strong>
          <em>1/1 runs</em>
        </div>
        <figcaption>written: &lt;coverage-dir&gt;/catalog/coverage.json</figcaption>
      </figure>
      <Aside type="tip" title="You now have the same loop as Track 1">
        The showcase path should end with the same proof shape: one reviewed catalog entry and one satisfied coverage signal. From here, the next choices are the same for both tracks.
      </Aside>
    </section>
  </article>

  <section class="bb-after-success" aria-label="After first success">
    <div class="bb-after-success-head">
      <span>After first success</span>
      <h2 id="after-first-success">Pick one next signal</h2>
      <p>The first loop proves Blackbox can observe your system and enforce one reviewed effect contract. Most teams should add readable behavior specs next. Add OMC/DC or CI gates when a specific review needs them.</p>
    </div>

    <div class="bb-next-signal">
      <a class="bb-next-primary" href="/docs/blackbox/quickstart/feature-files-from-tests">
        <span class="bb-next-kicker">Recommended next</span>
        <strong>Continue to Feature Files From Tests</strong>
        <p>Turn the proven system test into a readable behavior spec, then drift-check that the feature file and test source still describe the same behavior.</p>
        <span class="bb-next-link">Open guide</span>
      </a>

      <details class="bb-next-command">
        <summary>Show command preview</summary>
        <Code code={featureCommands} lang="bash" />
        <Code code={featureOutput} lang="text" />
      </details>

      <div class="bb-next-secondary" aria-label="Optional next signals">
        <a href="/docs/blackbox/concepts/omc-dc-coverage">
          <span class="bb-next-kicker">When branch risk matters</span>
          <strong>Inspect OMC/DC coverage</strong>
          <p>Use it for feature flags, authorization, compensation paths, retries, and forbidden side effects.</p>
          <span class="bb-next-link">Read OMC/DC guide</span>
        </a>
        <a href="/docs/blackbox/guides/ci-behavioral-gates">
          <span class="bb-next-kicker">When review needs a gate</span>
          <strong>Publish CI evidence</strong>
          <p>Archive the catalog coverage summary and OMC/DC reports where reviewers can inspect failures.</p>
          <span class="bb-next-link">Open CI guide</span>
        </a>
      </div>
    </div>

    <p class="bb-after-note">
      <strong>Keep the next step narrow.</strong> Add one more valuable signal, not every possible report. Bring in OMC/DC, feature files, and CI publishing when the team has a concrete review or merge-gate need.
    </p>
  </section>
</section>

<script>
  const root = document.querySelector('.bb-quickstart');

  if (root instanceof HTMLElement) {
    const choices = Array.from(root.querySelectorAll('[data-track-choice]'));
    const panels = Array.from(root.querySelectorAll('[data-track-panel]'));
    const progressLists = Array.from(root.querySelectorAll('[data-progress-list]'));
    const title = root.querySelector('[data-progress-title]');
    const count = root.querySelector('[data-progress-count]');
    const rail = root.querySelector('.bb-track-rail span');

    let activeTrack = 'existing';
    let activeStep = 0;

    const setProgress = (index) => {
      const list = root.querySelector(`[data-progress-list="${activeTrack}"]`);
      const items = list === null ? [] : Array.from(list.querySelectorAll('li'));
      activeStep = Math.max(0, Math.min(index, items.length - 1));

      items.forEach((item, i) => {
        item.classList.toggle('is-done', i < activeStep);
        item.classList.toggle('is-active', i === activeStep);
        const link = item.querySelector('a');
        if (link !== null) {
          if (i === activeStep) {
            link.setAttribute('aria-current', 'step');
          } else {
            link.removeAttribute('aria-current');
          }
        }
      });

      if (count !== null) {
        count.textContent = `Step ${activeStep + 1} of ${items.length}`;
      }

      if (rail instanceof HTMLElement) {
        const pct = items.length <= 1 ? 100 : (activeStep / (items.length - 1)) * 100;
        rail.style.width = `${pct}%`;
      }
    };

    const setTrack = (track, push, hash) => {
      activeTrack = track === 'new' ? 'new' : 'existing';
      root.dataset.activeTrack = activeTrack;

      choices.forEach((choice) => {
        const isActive = choice.getAttribute('data-track-choice') === activeTrack;
        choice.classList.toggle('is-active', isActive);
        if (isActive) {
          choice.setAttribute('aria-current', 'true');
        } else {
          choice.removeAttribute('aria-current');
        }
      });

      panels.forEach((panel) => {
        const isActive = panel.getAttribute('data-track-panel') === activeTrack;
        panel.classList.toggle('is-active', isActive);
        if (panel instanceof HTMLElement) {
          panel.hidden = !isActive;
        }
      });

      progressLists.forEach((list) => {
        if (list instanceof HTMLElement) {
          list.hidden = list.getAttribute('data-progress-list') !== activeTrack;
        }
      });

      if (title !== null) {
        title.textContent = activeTrack === 'new' ? 'Showcase track' : 'Existing-tests track';
      }

      if (push) {
        const url = new URL(window.location.href);
        url.searchParams.set('track', activeTrack);
        const nextHash = hash ?? url.hash;
        window.history.replaceState({}, '', `${url.pathname}?${url.searchParams.toString()}${nextHash}`);
      }

      setProgress(0);
      updateFromScroll();
    };

    const updateFromScroll = () => {
      const sections = Array.from(root.querySelectorAll(`[data-track-section="${activeTrack}"]`));
      const offset = 150;
      let current = 0;

      sections.forEach((section, index) => {
        const rect = section.getBoundingClientRect();
        if (rect.top <= offset) {
          current = index;
        }
      });

      setProgress(current);
    };

    choices.forEach((choice) => {
      choice.addEventListener('click', (event) => {
        event.preventDefault();
        const next = choice.getAttribute('data-track-choice') === 'new' ? 'new' : 'existing';
        setTrack(next, true);
        requestAnimationFrame(() => {
          const activePanel = root.querySelector(`[data-track-panel="${next}"]`);
          if (activePanel instanceof HTMLElement) {
            activePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });
    });

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const anchor = target.closest('a[href^="#"]');
      if (!(anchor instanceof HTMLAnchorElement)) return;

      const hash = anchor.hash;
      const track = hash.startsWith('#new-step-') || hash === '#track-new'
        ? 'new'
        : hash.startsWith('#existing-step-') || hash === '#track-existing'
          ? 'existing'
          : null;

      if (track === null) return;

      event.preventDefault();
      setTrack(track, true, hash);

      requestAnimationFrame(() => {
        document.querySelector(hash)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });

    window.addEventListener('scroll', updateFromScroll, { passive: true });
    window.addEventListener('resize', updateFromScroll);

    const initial = new URL(window.location.href).searchParams.get('track');
    const initialHash = window.location.hash;
    const initialTrack = initialHash.startsWith('#new-step-') || initialHash === '#track-new'
      ? 'new'
      : initial === 'new'
        ? 'new'
        : 'existing';
    setTrack(initialTrack, false);
  }
</script>

<style>
  .bb-quickstart {
    margin: 18px 0 48px;
  }

  .bb-preflight {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin: 16px 0 22px;
  }

  .bb-preflight-panel {
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.02);
  }

  .bb-preflight-panel {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 14px 16px;
  }

  .bb-preflight-panel.is-success {
    border-color: rgba(134, 239, 172, 0.24);
    background: rgba(134, 239, 172, 0.04);
  }

  .bb-preflight-panel > span,
  .bb-after-success-head > span,
  .bb-next-kicker {
    width: fit-content;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(96, 165, 250, 0.12);
    color: #93c5fd;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .bb-preflight-panel.is-success > span {
    background: rgba(134, 239, 172, 0.12);
    color: #86efac;
  }

  .bb-preflight-panel strong,
  .bb-next-primary strong,
  .bb-next-secondary strong {
    display: block;
    color: var(--text);
    font-size: 16px;
    line-height: 1.3;
  }

  .bb-preflight-panel p,
  .bb-next-primary p,
  .bb-next-secondary p {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.55;
  }

  .bb-track-pick {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 18px 0 0;
  }

  .bb-track-option {
    display: flex;
    min-height: 176px;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.035);
    color: var(--text);
    text-decoration: none;
  }

  .bb-track-option:hover,
  .bb-track-option:focus-visible,
  .bb-track-option.is-active {
    border-color: #60a5fa;
    background: rgba(96, 165, 250, 0.08);
  }

  .bb-track-option span {
    width: fit-content;
    padding: 4px 8px;
    border-radius: 6px;
    background: rgba(96, 165, 250, 0.12);
    color: #93c5fd;
    font-size: 12px;
    font-weight: 800;
  }

  .bb-track-option strong {
    font-size: 20px;
    line-height: 1.25;
  }

  .bb-track-option em {
    color: var(--text-muted);
    font-style: normal;

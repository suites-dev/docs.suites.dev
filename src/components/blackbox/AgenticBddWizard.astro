---
const steps = [
  {
    label: 'Intent',
    title: 'A person describes the obligation',
    body: 'The workflow begins with product intent and constraints. The source can be Markdown, a ticket, Kiro, OpenSpec, Spec Kit, or another planning artifact.',
    artifact: 'Product intent',
    snippet: 'Reject subscription requests for unknown users before payment, persistence, or publication.',
  },
  {
    label: 'EARS',
    title: 'A Skill proposes requirements',
    body: 'The requirements Skill proposes atomic EARS. The CLI validates structure. A person approves meaning.',
    artifact: 'Approved requirements',
    snippet: `REQ-004: When an unknown user requests a subscription, the billing system shall reject the subscription.
REQ-005: When an unknown user requests a subscription, the billing system shall not request payment.`,
  },
  {
    label: 'Gherkin',
    title: 'A Skill proposes readable behavior',
    body: 'The Gherkin Skill proposes a feature file with flow and requirement tags. A person accepts the scenario language.',
    artifact: 'Accepted feature',
    snippet: `@flow:subscribe-unknown-user
@requirement:REQ-004
@requirement:REQ-005
Feature: Reject an unknown subscriber

  Scenario: request stops before payment
    When the unknown user posts a subscription request
    Then the response status is 404
    And no payment request is sent`,
  },
  {
    label: 'Suite',
    title: 'A Skill proposes a Playwright patch',
    body: 'The Playwright Skill uses native Playwright APIs. A person approves the exact suite patch before it is applied.',
    artifact: 'Approved Playwright flow',
    snippet: `test.describe(
  'Reject an unknown subscriber',
  { tag: '@flow:subscribe-unknown-user' },
  () => {
    test('request stops before payment', async ({ request, capture }) => {
      const response = await request.post('/subscriptions', {
        data: { userId: 'ghost-user', tier: 'pro' },
      });

      expect(response.status()).toBe(404);
      await expect(capture).toMatchCatalog();
    });
  },
);`,
  },
  {
    label: 'Effects',
    title: 'Runtime evidence informs the effect contract',
    body: 'The effects Skill reads captured evidence and proposes required and forbidden effects. A person accepts the contract.',
    artifact: 'Accepted effect contract',
    snippet: `specVersion: "0.1"
flow: subscribe-unknown-user
requires:
  - { boundary: postgres, op: SELECT, key: users }
forbids:
  - { boundary: http, op: POST, key: /v1/payment_intents }
  - { boundary: postgres, op: INSERT, key: subscriptions }`,
  },
  {
    label: 'Verdict',
    title: 'The CLI computes separate verdicts',
    body: 'The agent repairs implementation from deterministic findings. It stops when passing would require changing accepted behavior.',
    artifact: 'Verification results',
    snippet: `Playwright              passed
feature check           in sync
effect contract         satisfied
REQ-004                 proven
REQ-005                 proven
decision evidence       propagating`,
  },
];
---

<section class="bb-agent-wizard" aria-label="Spec-driven verification workflow" data-agent-wizard>
  <div class="bb-agent-wizard-head">
    <div>
      <strong>Interactive workflow</strong>
      <h2>From Intent To Runtime Verdict</h2>
      <p>Click through the harness: Skills propose, the CLI computes, and humans approve accepted behavior.</p>
    </div>
    <div class="bb-agent-wizard-count" aria-live="polite">
      <span data-wizard-count>Step 1 of {steps.length}</span>
    </div>
  </div>

  <ol class="bb-agent-wizard-tabs" aria-label="Agentic workflow steps">
    {steps.map((step, index) => (
      <li>
        <button
          type="button"
          class={index === 0 ? 'is-active' : ''}
          data-wizard-step={index}
          aria-current={index === 0 ? 'step' : undefined}
        >
          <span>{index + 1}</span>
          {step.label}
        </button>
      </li>
    ))}
  </ol>

  <div class="bb-agent-wizard-stage">
    <div class="bb-agent-wizard-copy">
      <span data-wizard-artifact>{steps[0].artifact}</span>
      <h3 data-wizard-title>{steps[0].title}</h3>
      <p data-wizard-body>{steps[0].body}</p>
    </div>
    <pre class="bb-agent-wizard-code" aria-label="Current workflow artifact"><code data-wizard-snippet>{steps[0].snippet}</code></pre>
  </div>

  <div class="bb-agent-wizard-actions">
    <button type="button" data-wizard-prev disabled>Previous</button>
    <button type="button" data-wizard-next>Next</button>
  </div>
</section>

<script is:inline define:vars={{ steps }}>
  const wizards = Array.from(document.querySelectorAll('[data-agent-wizard]'));

  wizards.forEach((wizard) => {
    const buttons = Array.from(wizard.querySelectorAll('[data-wizard-step]'));
    const count = wizard.querySelector('[data-wizard-count]');
    const artifact = wizard.querySelector('[data-wizard-artifact]');
    const title = wizard.querySelector('[data-wizard-title]');
    const body = wizard.querySelector('[data-wizard-body]');
    const snippet = wizard.querySelector('[data-wizard-snippet]');
    const previous = wizard.querySelector('[data-wizard-prev]');
    const next = wizard.querySelector('[data-wizard-next]');
    let active = 0;

    const render = (index) => {
      active = Math.max(0, Math.min(index, steps.length - 1));
      const step = steps[active];

      buttons.forEach((button, i) => {
        const isActive = i === active;
        button.classList.toggle('is-active', isActive);
        if (isActive) {
          button.setAttribute('aria-current', 'step');
        } else {
          button.removeAttribute('aria-current');
        }
      });

      if (count !== null) count.textContent = `Step ${active + 1} of ${steps.length}`;
      if (artifact !== null) artifact.textContent = step.artifact;
      if (title !== null) title.textContent = step.title;
      if (body !== null) body.textContent = step.body;
      if (snippet !== null) snippet.textContent = step.snippet;

      if (previous instanceof HTMLButtonElement) previous.disabled = active === 0;
      if (next instanceof HTMLButtonElement) next.disabled = active === steps.length - 1;
    };

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.getAttribute('data-wizard-step'));
        render(index);
      });
    });

    previous?.addEventListener('click', () => render(active - 1));
    next?.addEventListener('click', () => render(active + 1));
  });
</script>

<style>
  .bb-agent-wizard {
    margin: 32px 0;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(17, 24, 39, 0.92));
  }

  .bb-agent-wizard-head {
    display: flex;
    gap: 20px;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 18px;
  }

  .bb-agent-wizard-head strong,
  .bb-agent-wizard-copy span {
    color: #93c5fd;
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .bb-agent-wizard-head h2,
  .bb-agent-wizard-copy h3 {
    margin: 6px 0;
    color: #f8fafc;
  }

  .bb-agent-wizard-head p,
  .bb-agent-wizard-copy p,
  .bb-agent-wizard-count {
    color: #cbd5e1;
  }

  .bb-agent-wizard-tabs {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
    padding: 0;
    margin: 0 0 18px;
    list-style: none;
  }

  .bb-agent-wizard-tabs button {
    width: 100%;
    min-height: 56px;
    padding: 8px;
    border: 1px solid #334155;
    border-radius: 8px;
    background: #0f172a;
    color: #cbd5e1;
    font: inherit;
    cursor: pointer;
  }

  .bb-agent-wizard-tabs button span {
    display: block;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 800;
  }

  .bb-agent-wizard-tabs button.is-active {
    border-color: #60a5fa;
    background: #172554;
    color: #eff6ff;
  }

  .bb-agent-wizard-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 18px;
    align-items: stretch;
  }

  .bb-agent-wizard-copy {
    padding: 18px;
    border: 1px solid #334155;
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.75);
  }

  .bb-agent-wizard-code {
    margin: 0;
    padding: 18px;
    overflow: auto;
    border: 1px solid #334155;
    border-radius: 8px;
    background: #020617;
    color: #e2e8f0;
    font-size: 13px;
    line-height: 1.55;
  }

  .bb-agent-wizard-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 16px;
  }

  .bb-agent-wizard-actions button {
    padding: 8px 12px;
    border: 1px solid #475569;
    border-radius: 8px;
    background: #111827;
    color: #e5e7eb;
    font: inherit;
  }

  .bb-agent-wizard-actions button:disabled {
    opacity: 0.45;
  }

  @media (max-width: 800px) {
    .bb-agent-wizard-head,
    .bb-agent-wizard-stage {
      grid-template-columns: 1fr;
      display: block;
    }

    .bb-agent-wizard-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bb-agent-wizard-code {
      margin-top: 14px;
    }
  }
</style>

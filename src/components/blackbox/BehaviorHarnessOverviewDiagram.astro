      <rect x="168" y="150" width="84" height="48" rx="6" fill="#1f2937" stroke="#94a3b8"></rect>
      <text x="210" y="179" text-anchor="middle" fill="#f8fafc" font-size="11" font-weight="700">Compute</text>
      <line x1="252" y1="174" x2="278" y2="174" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-framework-mobile-arrow)"></line>

      <rect x="288" y="150" width="84" height="48" rx="6" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="330" y="171" text-anchor="middle" fill="#fef3c7" font-size="11" font-weight="700">Human</text>
      <text x="330" y="186" text-anchor="middle" fill="#fde68a" font-size="10">review</text>
      <text x="48" y="226" fill="#93c5fd" font-size="10" font-weight="700">HUMANS CONTROL WHAT SUCCESS MEANS</text>

      <line x1="210" y1="248" x2="210" y2="282" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-framework-mobile-arrow)"></line>
      <text x="224" y="271" fill="#cbd5e1" font-size="9" font-weight="700">ACCEPTED TARGET</text>

      <rect x="28" y="292" width="364" height="224" rx="8" fill="#12251e" stroke="#4ade80"></rect>
      <text x="48" y="322" fill="#86efac" font-size="10" font-weight="800">RUNTIME VERIFICATION LOOP</text>
      <text x="48" y="350" fill="#f0fdf4" font-size="16" font-weight="800">Verify the running system</text>

      <rect x="48" y="374" width="92" height="50" rx="6" fill="#111827" stroke="#64748b"></rect>
      <text x="94" y="404" text-anchor="middle" fill="#e2e8f0" font-size="11" font-weight="700">Execute</text>
      <line x1="140" y1="399" x2="156" y2="399" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-framework-mobile-arrow)"></line>

      <rect x="164" y="374" width="92" height="50" rx="6" fill="#111827" stroke="#64748b"></rect>
      <text x="210" y="404" text-anchor="middle" fill="#e2e8f0" font-size="11" font-weight="700">Observe</text>
      <line x1="256" y1="399" x2="272" y2="399" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-framework-mobile-arrow)"></line>

      <rect x="280" y="374" width="92" height="50" rx="6" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="326" y="404" text-anchor="middle" fill="#fef3c7" font-size="11" font-weight="700">Verdict</text>

      <path d="M326 434 C326 478 94 478 94 434" fill="none" stroke="#4ade80" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#bb-framework-mobile-loop-arrow)"></path>
      <text x="210" y="480" text-anchor="middle" fill="#bbf7d0" font-size="10" font-weight="700">repair implementation and rerun</text>
      <text x="210" y="502" text-anchor="middle" fill="#fda4af" font-size="10" font-weight="700">target changes return to human review</text>
    </svg>
  </div>
  <figcaption>Behavior governance establishes the target and effect policy. Runtime execution produces observations and deterministic verdicts.</figcaption>
</figure>


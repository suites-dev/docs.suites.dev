        </marker>
        <marker id="bb-framework-loop-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" fill="#4ade80"></path>
        </marker>
      </defs>

      <rect x="8" y="8" width="944" height="344" rx="10" fill="#0b1120" stroke="#334155"></rect>
      <text x="36" y="48" fill="#f8fafc" font-size="20" font-weight="800">The Blackbox verification model</text>

      <rect x="44" y="86" width="310" height="188" rx="8" fill="#172554" stroke="#60a5fa"></rect>
      <text x="68" y="119" fill="#93c5fd" font-size="11" font-weight="800">BEHAVIOR GOVERNANCE LIFECYCLE</text>
      <text x="68" y="153" fill="#eff6ff" font-size="17" font-weight="800">Define and approve the target</text>
      <text x="68" y="183" fill="#bfdbfe" font-size="13">propose behavior</text>
      <text x="68" y="207" fill="#bfdbfe" font-size="13">validate and align artifacts</text>
      <text x="68" y="231" fill="#bfdbfe" font-size="13">review the actual diffs</text>
      <text x="68" y="257" fill="#93c5fd" font-size="11" font-weight="700">HUMANS CONTROL WHAT SUCCESS MEANS</text>

      <line x1="354" y1="180" x2="430" y2="180" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-framework-arrow)"></line>
      <text x="392" y="163" text-anchor="middle" fill="#cbd5e1" font-size="10" font-weight="700">ACCEPTED HARNESS</text>

      <rect x="440" y="86" width="476" height="188" rx="8" fill="#12251e" stroke="#4ade80"></rect>
      <text x="464" y="119" fill="#86efac" font-size="11" font-weight="800">RUNTIME VERIFICATION LOOP</text>
      <text x="464" y="153" fill="#f0fdf4" font-size="17" font-weight="800">Verify the running system</text>

      <rect x="464" y="178" width="112" height="56" rx="6" fill="#111827" stroke="#64748b"></rect>
      <text x="520" y="211" text-anchor="middle" fill="#e2e8f0" font-size="12" font-weight="700">Execute</text>

      <line x1="576" y1="206" x2="616" y2="206" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-framework-arrow)"></line>

      <rect x="626" y="178" width="112" height="56" rx="6" fill="#111827" stroke="#64748b"></rect>
      <text x="682" y="211" text-anchor="middle" fill="#e2e8f0" font-size="12" font-weight="700">Observe</text>

      <line x1="738" y1="206" x2="778" y2="206" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-framework-arrow)"></line>

      <rect x="788" y="178" width="104" height="56" rx="6" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="840" y="202" text-anchor="middle" fill="#fef3c7" font-size="12" font-weight="700">Verdict</text>
      <text x="840" y="219" text-anchor="middle" fill="#fde68a" font-size="10">deterministic</text>

      <path d="M840 242 C840 306 520 306 520 244" fill="none" stroke="#4ade80" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#bb-framework-loop-arrow)"></path>
      <text x="680" y="307" text-anchor="middle" fill="#bbf7d0" font-size="11" font-weight="700">repair implementation and rerun</text>

      <text x="480" y="257" fill="#fda4af" font-size="11" font-weight="700">CHANGING THE TARGET RETURNS TO HUMAN REVIEW</text>
    </svg>


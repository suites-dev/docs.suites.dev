    </defs>

    <text x="20" y="34" fill="#f8fafc" font-size="18" font-weight="800">Your Blackbox quickstart</text>
    <text x="20" y="56" fill="#cbd5e1" font-size="11">Preview the loop, then prove one flow.</text>

    <text x="110" y="92" fill="#93c5fd" font-size="10" font-weight="800">OPTIONAL PREVIEW</text>
    <rect x="110" y="103" width="200" height="64" rx="7" fill="#172554" stroke="#60a5fa"></rect>
    <text x="210" y="130" text-anchor="middle" fill="#eff6ff" font-size="13" font-weight="800">Run the demo</text>

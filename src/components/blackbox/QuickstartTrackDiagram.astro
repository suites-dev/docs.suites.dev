      </marker>
      <marker id="bb-quickstart-fail-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0 0 L10 5 L0 10 z" fill="#fb7185"></path>
      </marker>
    </defs>

    <text x="20" y="34" fill="#f8fafc" font-size="20" font-weight="800">Your Blackbox quickstart</text>
    <text x="20" y="58" fill="#cbd5e1" font-size="12">Preview the loop, then prove one flow in your project.</text>

    <text x="20" y="101" fill="#93c5fd" font-size="10" font-weight="800">OPTIONAL PREVIEW</text>

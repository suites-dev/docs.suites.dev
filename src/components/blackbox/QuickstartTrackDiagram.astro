    <rect x="238" y="122" width="142" height="72" rx="7" fill="#172554" stroke="#60a5fa"></rect>
    <text x="309" y="150" text-anchor="middle" fill="#eff6ff" font-size="13" font-weight="800">1. Connect</text>
    <text x="309" y="172" text-anchor="middle" fill="#bfdbfe" font-size="11">one passing test</text>

    <line x1="380" y1="158" x2="407" y2="158" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-quickstart-arrow)"></line>

    <rect x="418" y="122" width="142" height="72" rx="7" fill="#12251e" stroke="#4ade80"></rect>
    <text x="489" y="150" text-anchor="middle" fill="#f0fdf4" font-size="13" font-weight="800">2. Capture</text>
    <text x="489" y="172" text-anchor="middle" fill="#bbf7d0" font-size="11">runtime effects</text>

    <line x1="560" y1="158" x2="587" y2="158" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-quickstart-arrow)"></line>

    <rect x="598" y="122" width="142" height="72" rx="7" fill="#3b2f0b" stroke="#fbbf24"></rect>
    <text x="669" y="150" text-anchor="middle" fill="#fef3c7" font-size="13" font-weight="800">3. Approve</text>
    <text x="669" y="172" text-anchor="middle" fill="#fde68a" font-size="11">effect contract</text>

    <line x1="740" y1="158" x2="767" y2="158" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-quickstart-arrow)"></line>

    <rect x="778" y="122" width="142" height="72" rx="7" fill="#12251e" stroke="#4ade80"></rect>
    <text x="849" y="150" text-anchor="middle" fill="#f0fdf4" font-size="13" font-weight="800">4. Verify</text>
    <text x="849" y="172" text-anchor="middle" fill="#bbf7d0" font-size="11">enforce verdict</text>

    <path d="M849 194 V256 H683" fill="none" stroke="#4ade80" stroke-width="2" marker-end="url(#bb-quickstart-arrow)"></path>
    <rect x="512" y="236" width="160" height="42" rx="7" fill="#12251e" stroke="#4ade80"></rect>
    <text x="592" y="262" text-anchor="middle" fill="#bbf7d0" font-size="11" font-weight="800">PASS · human review</text>

    <path d="M849 194 V310 H309 V205" fill="none" stroke="#fb7185" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#bb-quickstart-fail-arrow)"></path>
    <rect x="496" y="291" width="192" height="42" rx="7" fill="#3f1724" stroke="#fb7185"></rect>
    <text x="592" y="317" text-anchor="middle" fill="#ffe4e6" font-size="11" font-weight="800">FAIL · repair and rerun</text>
  </svg>


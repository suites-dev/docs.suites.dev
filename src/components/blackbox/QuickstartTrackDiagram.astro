    <rect x="110" y="232" width="200" height="64" rx="7" fill="#172554" stroke="#60a5fa"></rect>
    <text x="210" y="259" text-anchor="middle" fill="#eff6ff" font-size="13" font-weight="800">1. Connect</text>
    <text x="210" y="280" text-anchor="middle" fill="#bfdbfe" font-size="11">one passing test</text>
    <line x1="210" y1="296" x2="210" y2="322" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-quickstart-mobile-arrow)"></line>

    <rect x="110" y="333" width="200" height="64" rx="7" fill="#12251e" stroke="#4ade80"></rect>
    <text x="210" y="360" text-anchor="middle" fill="#f0fdf4" font-size="13" font-weight="800">2. Capture</text>
    <text x="210" y="381" text-anchor="middle" fill="#bbf7d0" font-size="11">runtime effects</text>
    <line x1="210" y1="397" x2="210" y2="423" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-quickstart-mobile-arrow)"></line>

    <rect x="110" y="434" width="200" height="64" rx="7" fill="#3b2f0b" stroke="#fbbf24"></rect>
    <text x="210" y="461" text-anchor="middle" fill="#fef3c7" font-size="13" font-weight="800">3. Approve</text>
    <text x="210" y="482" text-anchor="middle" fill="#fde68a" font-size="11">effect contract</text>
    <line x1="210" y1="498" x2="210" y2="524" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-quickstart-mobile-arrow)"></line>

    <rect x="110" y="535" width="200" height="64" rx="7" fill="#12251e" stroke="#4ade80"></rect>
    <text x="210" y="562" text-anchor="middle" fill="#f0fdf4" font-size="13" font-weight="800">4. Verify</text>
    <text x="210" y="583" text-anchor="middle" fill="#bbf7d0" font-size="11">enforce verdict</text>

    <path d="M210 599 V632 H100" fill="none" stroke="#4ade80" stroke-width="2" marker-end="url(#bb-quickstart-mobile-arrow)"></path>
    <rect x="24" y="643" width="168" height="48" rx="7" fill="#12251e" stroke="#4ade80"></rect>
    <text x="108" y="672" text-anchor="middle" fill="#bbf7d0" font-size="10" font-weight="800">PASS · human review</text>

    <path d="M210 599 V632 H320" fill="none" stroke="#fb7185" stroke-width="2" stroke-dasharray="6 5" marker-end="url(#bb-quickstart-mobile-fail-arrow)"></path>
    <rect x="228" y="643" width="168" height="48" rx="7" fill="#3f1724" stroke="#fb7185"></rect>
    <text x="312" y="672" text-anchor="middle" fill="#ffe4e6" font-size="10" font-weight="800">FAIL · repair + rerun</text>
  </svg>

  <figcaption>The demo is optional. The project journey starts with one passing system test and ends with a verdict backed by reviewed runtime behavior.</figcaption>
</figure>

<style>
  .bb-quickstart-journey {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 24px 0 32px;
    overflow: hidden;
  }

  .bb-quickstart-journey svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .bb-quickstart-journey__mobile {
    display: none !important;
  }

  .bb-quickstart-journey figcaption {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 640px) {
    .bb-quickstart-journey__desktop {
      display: none;
    }

    .bb-quickstart-journey__mobile {
      display: block !important;
    }
  }
</style>

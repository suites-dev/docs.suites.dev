  >
    <title id="bb-quickstart-title">Your Blackbox quickstart journey</title>
    <desc id="bb-quickstart-desc">Optionally run the demo, then connect one passing system test, capture its runtime effects, approve an effect contract, and enforce the verdict. Failed verdicts return for repair and passing evidence goes to human review.</desc>
    <defs>
      <marker id="bb-quickstart-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">

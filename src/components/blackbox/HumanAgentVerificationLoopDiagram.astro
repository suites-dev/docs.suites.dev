<figure class="bb-agent-loop" aria-label="Human-accountable engineering loop with autonomous coding-agent repair">
  <div class="bb-agent-loop__viewport">
    <svg
      class="bb-agent-loop__desktop"
      viewBox="0 0 960 340"
      role="img"
      aria-labelledby="bb-agent-loop-title bb-agent-loop-desc"
      font-family="Inter, ui-sans-serif, system-ui, sans-serif"
    >
      <title id="bb-agent-loop-title">The Blackbox engineering loop</title>
      <desc id="bb-agent-loop-desc">A person defines the behavior, a coding agent changes the software, and the Blackbox verification loop executes the flow, observes the running system, and computes a verdict. Failures return to the agent for repair. A person accepts or returns passing work after review.</desc>
      <defs>
        <marker id="bb-agent-loop-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" fill="#94a3b8"></path>
        </marker>
        <marker id="bb-agent-loop-repair-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" fill="#4ade80"></path>
        </marker>
        <marker id="bb-agent-loop-human-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" fill="#fbbf24"></path>
        </marker>
      </defs>

      <rect x="8" y="8" width="944" height="324" rx="10" fill="#0b1120" stroke="#334155"></rect>
      <text x="36" y="48" fill="#f8fafc" font-size="20" font-weight="800">The Blackbox engineering loop</text>
      <text x="36" y="72" fill="#cbd5e1" font-size="12">Human judgment surrounds an autonomous agent feedback loop.</text>

      <rect x="36" y="112" width="136" height="76" rx="7" fill="#172554" stroke="#60a5fa"></rect>
      <text x="104" y="141" text-anchor="middle" fill="#eff6ff" font-size="14" font-weight="800">Human</text>
      <text x="104" y="164" text-anchor="middle" fill="#bfdbfe" font-size="12">Define behavior</text>

      <line x1="172" y1="150" x2="216" y2="150" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-arrow)"></line>

      <rect x="226" y="112" width="150" height="76" rx="7" fill="#1f2937" stroke="#94a3b8"></rect>
      <text x="301" y="141" text-anchor="middle" fill="#f8fafc" font-size="14" font-weight="800">Coding agent</text>
      <text x="301" y="164" text-anchor="middle" fill="#cbd5e1" font-size="12">Change software</text>

      <line x1="376" y1="150" x2="420" y2="150" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-arrow)"></line>

      <rect x="430" y="94" width="326" height="112" rx="8" fill="#12251e" stroke="#4ade80"></rect>
      <text x="450" y="120" fill="#86efac" font-size="11" font-weight="800">BLACKBOX VERIFICATION LOOP</text>

      <rect x="450" y="136" width="82" height="48" rx="6" fill="#111827" stroke="#64748b"></rect>
      <text x="491" y="165" text-anchor="middle" fill="#e2e8f0" font-size="11" font-weight="700">Execute</text>

      <line x1="532" y1="160" x2="548" y2="160" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-arrow)"></line>

      <rect x="556" y="136" width="82" height="48" rx="6" fill="#111827" stroke="#64748b"></rect>
      <text x="597" y="165" text-anchor="middle" fill="#e2e8f0" font-size="11" font-weight="700">Observe</text>

      <line x1="638" y1="160" x2="654" y2="160" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-arrow)"></line>

      <rect x="662" y="136" width="74" height="48" rx="6" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="699" y="165" text-anchor="middle" fill="#fef3c7" font-size="11" font-weight="700">Verdict</text>

      <line x1="756" y1="150" x2="800" y2="150" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-arrow)"></line>
      <text x="778" y="137" text-anchor="middle" fill="#bbf7d0" font-size="9" font-weight="700">PASS</text>

      <rect x="810" y="112" width="114" height="76" rx="7" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="867" y="145" text-anchor="middle" fill="#fef3c7" font-size="13" font-weight="800">Human Review</text>
      <text x="867" y="169" text-anchor="middle" fill="#fde68a" font-size="10">accept or return</text>

      <path d="M867 112 V84 H301 V102" fill="none" stroke="#fbbf24" stroke-width="2" stroke-dasharray="5 5" marker-end="url(#bb-agent-loop-human-arrow)"></path>
      <text x="584" y="78" text-anchor="middle" fill="#fde68a" font-size="10" font-weight="700">return with feedback</text>

      <path d="M699 206 C699 284 301 284 301 198" fill="none" stroke="#4ade80" stroke-width="2" stroke-dasharray="7 5" marker-end="url(#bb-agent-loop-repair-arrow)"></path>
      <text x="500" y="306" text-anchor="middle" fill="#bbf7d0" font-size="12" font-weight="700">failure: repair implementation and rerun</text>
    </svg>

    <svg
      class="bb-agent-loop__mobile"
      viewBox="0 0 420 650"
      role="img"
      aria-labelledby="bb-agent-loop-mobile-title bb-agent-loop-mobile-desc"
      font-family="Inter, ui-sans-serif, system-ui, sans-serif"
    >
      <title id="bb-agent-loop-mobile-title">The Blackbox engineering loop</title>
      <desc id="bb-agent-loop-mobile-desc">A person defines the behavior before the coding agent and accepts or returns the reviewed result at the end. Between them, the agent uses Blackbox verdicts to repair implementation and rerun.</desc>
      <defs>
        <marker id="bb-agent-loop-mobile-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" fill="#94a3b8"></path>
        </marker>
        <marker id="bb-agent-loop-mobile-repair-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" fill="#4ade80"></path>
        </marker>
        <marker id="bb-agent-loop-mobile-human-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M0 0 L10 5 L0 10 z" fill="#fbbf24"></path>
        </marker>
      </defs>

      <rect x="8" y="8" width="404" height="634" rx="10" fill="#0b1120" stroke="#334155"></rect>
      <text x="28" y="43" fill="#f8fafc" font-size="18" font-weight="800">The Blackbox engineering loop</text>

      <rect x="58" y="72" width="200" height="64" rx="7" fill="#172554" stroke="#60a5fa"></rect>
      <text x="158" y="98" text-anchor="middle" fill="#eff6ff" font-size="13" font-weight="800">Human</text>
      <text x="158" y="119" text-anchor="middle" fill="#bfdbfe" font-size="11">Define behavior</text>

      <line x1="158" y1="136" x2="158" y2="168" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-mobile-arrow)"></line>

      <rect x="58" y="178" width="200" height="64" rx="7" fill="#1f2937" stroke="#94a3b8"></rect>
      <text x="158" y="204" text-anchor="middle" fill="#f8fafc" font-size="13" font-weight="800">Coding agent</text>
      <text x="158" y="225" text-anchor="middle" fill="#cbd5e1" font-size="11">Change software</text>

      <line x1="158" y1="242" x2="158" y2="274" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-mobile-arrow)"></line>

      <rect x="28" y="284" width="330" height="144" rx="8" fill="#12251e" stroke="#4ade80"></rect>
      <text x="48" y="313" fill="#86efac" font-size="10" font-weight="800">BLACKBOX VERIFICATION LOOP</text>

      <rect x="48" y="334" width="80" height="52" rx="6" fill="#111827" stroke="#64748b"></rect>
      <text x="88" y="365" text-anchor="middle" fill="#e2e8f0" font-size="11" font-weight="700">Execute</text>
      <line x1="128" y1="360" x2="146" y2="360" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-mobile-arrow)"></line>

      <rect x="154" y="334" width="80" height="52" rx="6" fill="#111827" stroke="#64748b"></rect>
      <text x="194" y="365" text-anchor="middle" fill="#e2e8f0" font-size="11" font-weight="700">Observe</text>
      <line x1="234" y1="360" x2="252" y2="360" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-mobile-arrow)"></line>

      <rect x="260" y="334" width="78" height="52" rx="6" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="299" y="365" text-anchor="middle" fill="#fef3c7" font-size="11" font-weight="700">Verdict</text>

      <path d="M299 386 C386 410 396 210 268 210" fill="none" stroke="#4ade80" stroke-width="2" stroke-dasharray="7 5" marker-end="url(#bb-agent-loop-mobile-repair-arrow)"></path>
      <text x="309" y="267" text-anchor="middle" fill="#bbf7d0" font-size="10" font-weight="700">failure: repair + rerun</text>

      <line x1="193" y1="428" x2="193" y2="498" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-agent-loop-mobile-arrow)"></line>
      <text x="207" y="472" fill="#bbf7d0" font-size="9" font-weight="700">PASS + EVIDENCE</text>

      <rect x="110" y="508" width="200" height="76" rx="7" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="210" y="542" text-anchor="middle" fill="#fef3c7" font-size="13" font-weight="800">Human Review</text>
      <text x="210" y="567" text-anchor="middle" fill="#fde68a" font-size="10">accept or return</text>

      <path d="M110 546 H18 V210 H48" fill="none" stroke="#fbbf24" stroke-width="2" stroke-dasharray="5 5" marker-end="url(#bb-agent-loop-mobile-human-arrow)"></path>
      <text x="74" y="490" text-anchor="middle" fill="#fde68a" font-size="9" font-weight="700">human feedback</text>

      <text x="210" y="612" text-anchor="middle" fill="#cbd5e1" font-size="10">Target changes leave the autonomous loop.</text>
    </svg>
  </div>
  <figcaption>The agent repeats the inner loop. A person defines behavior at the beginning and accepts or returns the reviewed result at the end.</figcaption>
</figure>

<style>
  .bb-agent-loop {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 24px 0 32px;
    padding: 16px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
  }

  .bb-agent-loop__viewport {
    max-width: 100%;
    overflow-x: auto;
  }

  .bb-agent-loop__desktop {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
  }

  .bb-agent-loop__mobile {
    display: none;
    width: 100%;
    height: auto;
  }

  .bb-agent-loop figcaption {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 640px) {
    .bb-agent-loop {
      padding: 10px;
    }

    .bb-agent-loop__desktop {
      display: none;
    }

    .bb-agent-loop__mobile {
      display: block;
    }
  }
</style>

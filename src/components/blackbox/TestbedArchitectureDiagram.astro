    overflow-x: auto;
  }

  .bb-overview-diagram svg {
    display: block;
    width: 100%;
    min-width: 680px;
    height: auto;
  }

  .bb-overview-diagram figcaption {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 760px) {
    .bb-overview-diagram {
      padding: 12px;
    }
  }
</style>

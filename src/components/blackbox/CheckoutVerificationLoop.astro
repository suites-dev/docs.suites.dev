          <div class="bb-agent-terminal__line bb-agent-terminal__line--tool-output" data-from="43200"><b aria-hidden="true">⎿</b><span><strong>FLOW</strong> checkout-completion</span></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--result" data-from="44000"><span>tests</span><b class="is-pass">PASS</b><small>201 Created</small></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--result" data-from="44800"><span>integrity</span><b class="is-pass">PASS</b><small>evidence sealed</small></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--result" data-from="45600"><span>effects</span><b class="is-pass">SATISFIED</b></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--observation" data-from="46400"><span>HTTP POST /payments/charges</span><b class="is-pass">observed 1</b></div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--success" data-from="47500">
            <b aria-hidden="true">⏺</b><span data-terminal-type>Verified. The approved behavior now observes exactly one charge request.</span>
          </div>
          <div class="bb-agent-terminal__line bb-agent-terminal__line--duration" data-from="48200">
            <b aria-hidden="true">✻</b><span>Baked for 42s</span>
          </div>

          <div class="bb-agent-terminal__idle" data-idle-prompt>
            <b>❯</b><span aria-hidden="true"></span>
          </div>
        </div>
      </section>
      </div>
    </div>
  </div>
</figure>

<script>
  const stages = [
    { start: 0, label: 'Review the requirement' },
    { start: 600, label: 'Developer request' },
    { start: 2800, label: 'Load Blackbox Skill' },
    { start: 4000, label: 'Propose behavior' },
    { start: 8900, label: 'Validate generated Gherkin' },
    { start: 11300, label: 'Developer approval' },
    { start: 13000, label: 'Create verification files' },
    { start: 17000, label: 'Implement checkout' },
    { start: 23000, label: 'Run Blackbox' },
    { start: 30000, label: 'Analyze sealed evidence' },
    { start: 35000, label: 'Repair implementation' },
    { start: 41000, label: 'Verify the repair' },
  ] as const;

  const casts = document.querySelectorAll<HTMLElement>('[data-agent-cast]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  casts.forEach((cast) => {
    const storyDuration = 49000;
    const duration = Number(cast.dataset.duration) || 94000;
    const storyHolds = [
      { at: 1900, duration: 1200 },
      { at: 3800, duration: 1000 },
      { at: 8850, duration: 1100 },
      { at: 9350, duration: 900 },
      { at: 12100, duration: 1500 },
      { at: 12850, duration: 1300 },
      { at: 22550, duration: 1100 },
      { at: 22920, duration: 900 },
      { at: 29950, duration: 900 },
      { at: 35100, duration: 800 },
      { at: 39500, duration: 700 },
      { at: 40970, duration: 1000 },
    ] as const;
    const heldPlaybackTime = storyHolds.reduce((total, hold) => total + hold.duration, 0);
    const activePlaybackTime = Math.max(1, duration - heldPlaybackTime);
    const playbackMsPerStoryMs = activePlaybackTime / storyDuration;
    const getStoryTime = (playbackTime: number) => {
      let elapsedHolds = 0;

      for (const hold of storyHolds) {
        const holdStartsAt = hold.at * playbackMsPerStoryMs + elapsedHolds;
        if (playbackTime < holdStartsAt) break;
        if (playbackTime < holdStartsAt + hold.duration) return hold.at;
        elapsedHolds += hold.duration;
      }

      return Math.min(storyDuration, (playbackTime - elapsedHolds) / playbackMsPerStoryMs);
    };
    const playButton = cast.querySelector<HTMLButtonElement>('[data-agent-play]');
    const playLabel = cast.querySelector<HTMLElement>('[data-agent-play-label]');
    const status = cast.querySelector<HTMLElement>('[data-agent-status]');
    const progress = cast.querySelector<HTMLElement>('[data-agent-progress]');
    const stageLabel = cast.querySelector<HTMLElement>('[data-agent-stage]');
    const stepLabel = cast.querySelector<HTMLElement>('[data-agent-step]');
    const workspace = cast.querySelector<HTMLElement>('.bb-agent-workspace');
    const workspaceState = cast.querySelector<HTMLElement>('[data-workspace-state]');
    const workspaceMain = cast.querySelector<HTMLElement>('[data-workspace-main]');
    const terminalBody = cast.querySelector<HTMLElement>('[data-terminal-body]');
    const frames = Array.from(cast.querySelectorAll<HTMLElement>('[data-editor-frame]'));
    const tabs = Array.from(cast.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const files = Array.from(cast.querySelectorAll<HTMLElement>('[data-file]'));
    const timedElements = Array.from(cast.querySelectorAll<HTMLElement>('[data-from]'));
    const commands = Array.from(cast.querySelectorAll<HTMLElement>('[data-command]'));
    const terminalMessages = Array.from(
      cast.querySelectorAll<HTMLElement>('[data-terminal-type]'),
    ).map((element) => ({
      element,
      text: element.textContent ?? '',
      from: Number(element.closest<HTMLElement>('[data-from]')?.dataset.from) || 0,
      speed: Number(element.dataset.terminalSpeed) || 12,
    }));
    const typedCode = Array.from(cast.querySelectorAll<HTMLElement>('[data-type]')).map(
      (element) => ({
        element,
        text: element.textContent ?? '',
        html: element.innerHTML,
        from: Number(element.dataset.from) || 0,
        speed: Number(element.dataset.typeSpeed) || 24,
      }),
    );
    const idlePrompt = cast.querySelector<HTMLElement>('[data-idle-prompt]');
    const featureLock = cast.querySelector<HTMLElement>('[data-feature-lock]');
    const approvalChoices = cast.querySelector<HTMLElement>('[data-approval-choices]');
    const suspectLine = cast.querySelector<HTMLElement>('[data-suspect-line]');
    const implementationState = cast.querySelector<HTMLElement>('[data-implementation-state]');

    if (!playButton || !playLabel || !status || !progress || !stageLabel || !stepLabel) return;

    let state: 'idle' | 'playing' | 'paused' | 'complete' = 'idle';
    let elapsed = 0;
    let startedAt = 0;
    let animationFrame = 0;
    let isVisible = false;
    let isAutoSuspended = false;
    let hasAutoplayed = false;

    const setControls = () => {
      cast.dataset.playerState = state;
      const canBrowseFiles = state === 'complete';
      workspace?.setAttribute('aria-hidden', String(!canBrowseFiles));
      tabs.forEach((tab) => {
        tab.disabled = !canBrowseFiles;
        tab.setAttribute('aria-pressed', String(tab.classList.contains('is-active')));
      });

      if (state === 'playing') {
        playLabel.textContent = 'Pause session';
        status.textContent = 'Agent session playing';
      } else if (state === 'paused') {
        playLabel.textContent = 'Resume session';
        status.textContent = 'Agent session paused';
      } else if (state === 'complete') {
        playLabel.textContent = 'Replay session';
        status.textContent = 'Agent session complete';
      } else {
        playLabel.textContent = 'Play session';
        status.textContent = 'Session ready';
      }
    };

    const render = (playbackTime: number) => {
      const time = getStoryTime(playbackTime);
      let stageIndex = 0;
      stages.forEach((stage, index) => {
        if (time >= stage.start) stageIndex = index;
      });
      const currentStage = stages[stageIndex] ?? stages[0];
      stageLabel.textContent = currentStage.label;
      stepLabel.textContent = `${stageIndex + 1} / ${stages.length}`;
      progress.style.transform = `scaleX(${Math.min(1, playbackTime / duration)})`;

      const activeFrame =
        frames.find((frame) => {
          const start = Number(frame.dataset.start) || 0;
          const end = Number(frame.dataset.end) || storyDuration + 1;
          return time >= start && time < end;
        }) ?? frames[frames.length - 1];

      frames.forEach((frame) => {
        const active = frame === activeFrame;
        frame.hidden = !active;
        frame.classList.toggle('is-active', active);
      });

      const activeFile = activeFrame?.dataset.fileName ?? '';
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === activeFile;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-pressed', String(active));
      });
      files.forEach((file) => file.classList.toggle('is-active', file.dataset.file === activeFile));

      timedElements.forEach((element) => {
        const from = Number(element.dataset.from) || 0;
        element.classList.toggle('is-visible', time >= from);
      });

      typedCode.forEach((target) => {
        const characters = Math.max(0, Math.floor((time - target.from) / target.speed));
        const isTyping = time >= target.from && characters < target.text.length;

        if (time < target.from) {
          target.element.textContent = '';
        } else if (isTyping) {
          target.element.textContent = target.text.slice(0, characters);
        } else if (target.element.innerHTML !== target.html) {
          target.element.innerHTML = target.html;
        }

        target.element.classList.toggle('is-typing', isTyping);
      });

      commands.forEach((command) => {
        const line = command.closest<HTMLElement>('[data-from]');
        const from = Number(line?.dataset.from) || 0;
        const text = command.dataset.text ?? '';
        const characters = Math.max(0, Math.floor((time - from) / 24));
        command.textContent = text.slice(0, characters);
        command.classList.toggle('is-typing', time >= from && characters < text.length);
      });

      terminalMessages.forEach((message) => {
        const characters = Math.max(0, Math.floor((time - message.from) / message.speed));
        message.element.textContent = message.text.slice(0, characters);
        message.element.classList.toggle(
          'is-typing',
          time >= message.from && characters < message.text.length,
        );
      });

      const terminalIsIdle =
        (time >= 4500 && time < 8850) ||
        (time >= 13000 && time < 22600) ||
        (time >= 36200 && time < 37800) ||
        time >= 48200;
      idlePrompt?.classList.toggle('is-visible', terminalIsIdle);

      const approved = time >= 12900;
      featureLock?.classList.toggle('is-visible', approved);
      approvalChoices?.classList.toggle('is-approved', approved);

      const findingVisible = time >= 27500;
      suspectLine?.classList.toggle('is-suspect', findingVisible);
      if (implementationState) {
        implementationState.textContent = findingVisible ? 'finding points here' : 'implementation';
        implementationState.classList.toggle('is-finding', findingVisible);
      }

      if (workspaceState) {
        workspaceState.textContent = time < 8900
          ? 'agent working'
          : time < 11300
            ? 'validating Gherkin'
            : time < 12900
            ? 'review required'
            : time < 27500
              ? 'behavior locked'
              : time < 41000
                ? 'repairing'
                : 'verified';
      }

      const introductionFocus = time < 600;
      const fileIsBeingWritten =
        (time >= 4000 && time < 8900) ||
        (time >= 13000 && time < 22600) ||
        (time >= 36200 && time < 37800);
      const paneFocus =
        time >= 48500 ? 'both' : introductionFocus || fileIsBeingWritten ? 'editor' : 'terminal';
      if (workspaceMain) workspaceMain.dataset.focus = paneFocus;

      if (terminalBody && state === 'playing' && paneFocus === 'terminal') {
        terminalBody.scrollTop = terminalBody.scrollHeight;
      }
    };

    const finish = () => {
      elapsed = duration;
      render(elapsed);
      state = 'complete';
      animationFrame = 0;
      setControls();
    };

    const tick = (now: number) => {
      if (state !== 'playing') return;
      elapsed = Math.min(duration, now - startedAt);
      render(elapsed);

      if (elapsed >= duration) {
        finish();
        return;
      }

      animationFrame = window.requestAnimationFrame(tick);
    };

    const startFrameLoop = () => {
      if (!isVisible || document.hidden) {
        isAutoSuspended = true;
        return;
      }

      isAutoSuspended = false;
      startedAt = performance.now() - elapsed;
      animationFrame = window.requestAnimationFrame(tick);
    };

    const play = (restart = false) => {
      if (restart) elapsed = 0;
      state = 'playing';
      render(elapsed);
      setControls();
      startFrameLoop();
    };

    const pause = () => {
      if (state !== 'playing') return;
      elapsed = Math.min(duration, performance.now() - startedAt);
      window.cancelAnimationFrame(animationFrame);
      animationFrame = 0;
      isAutoSuspended = false;
      state = 'paused';
      render(elapsed);
      setControls();
    };

    const suspendAutomatically = () => {
      if (state !== 'playing' || isAutoSuspended) return;
      elapsed = Math.min(duration, performance.now() - startedAt);
      window.cancelAnimationFrame(animationFrame);
      animationFrame = 0;
      isAutoSuspended = true;
      render(elapsed);
    };

    const resumeAutomatically = () => {
      if (state !== 'playing' || !isAutoSuspended || !isVisible || document.hidden) return;
      startFrameLoop();
    };

    const selectCompletedFile = (fileName: string) => {
      if (state !== 'complete') return;

      const selectedFrame = frames
        .filter((frame) => frame.dataset.fileName === fileName)
        .sort((first, second) => Number(second.dataset.start) - Number(first.dataset.start))[0];

      if (!selectedFrame) return;

      frames.forEach((frame) => {
        const active = frame === selectedFrame;
        frame.hidden = !active;
        frame.classList.toggle('is-active', active);
      });
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === fileName;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-pressed', String(active));
      });
      files.forEach((file) => file.classList.toggle('is-active', file.dataset.file === fileName));
      if (workspaceMain) workspaceMain.dataset.focus = 'both';
      status.textContent = `Opened ${fileName}`;
    };

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => selectCompletedFile(tab.dataset.tab ?? ''));
    });

    cast.classList.add('is-enhanced');

    if (prefersReducedMotion) {
      elapsed = duration;
      state = 'complete';
      render(elapsed);
      setControls();
      if (terminalBody) terminalBody.scrollTop = terminalBody.scrollHeight;
      return;
    }

    render(0);
    setControls();

    playButton.addEventListener('click', () => {
      if (state === 'playing') pause();
      else {
        hasAutoplayed = true;
        play(state === 'idle' || state === 'complete');
      }
    });

    const observer = new IntersectionObserver(
      ([entry]) => {
        isVisible = Boolean(entry?.isIntersecting && entry.intersectionRatio >= 0.45);

        if (isVisible && !hasAutoplayed) {
          hasAutoplayed = true;
          play(true);
        } else if (isVisible) {
          resumeAutomatically();
        } else {
          suspendAutomatically();
        }
      },
      { threshold: [0, 0.45] },
    );

    observer.observe(cast);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) suspendAutomatically();
      else resumeAutomatically();
    });
  });
</script>


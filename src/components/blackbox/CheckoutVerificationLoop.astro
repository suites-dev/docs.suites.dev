---
import { Code } from 'astro-expressive-code/components';

const requirementCode = `# Checkout

A customer is charged when checkout completes.`;

const testCode = `test.describe("Checkout payment", { tag: ["@flowid:checkout-completion"] }, () => {
  test("charges the customer when checkout completes", async ({ request }) => {
    const response = await request.post("/checkout");

    expect(response.status()).toBe(201);
  });
});`;

const effectsCode = `flow: checkout-completion

requires:
  - { boundary: http, op: POST, key: "/payments/charges", service: payment-service }`;
---

<figure
  class="bb-checkout-loop"
  aria-label="An approved checkout requirement becomes an executable test, runtime evidence, and a Blackbox finding"
>
  <div class="bb-checkout-loop__files">
    <section class="bb-snippet" aria-label="Product requirement file">
      <Code
        code={requirementCode}
        lang="md"
        meta={'title="product-requirements.md" wrap'}
      />
    </section>

    <div class="bb-checkout-loop__step" aria-hidden="true">
      <span>translated into</span>
      <strong>↓</strong>
    </div>

    <section class="bb-snippet" aria-label="Executable end-to-end test file">
      <Code
        code={testCode}
        lang="ts"
        meta={'title="checkout.e2e.spec.ts" wrap'}
      />
      <footer class="bb-snippet__meta bb-snippet__meta--pass">
        <span>TEST RESULT</span>
        <strong>PASS</strong>
        <span>201 Created</span>
      </footer>
    </section>
  </div>

  <div class="bb-checkout-loop__down" aria-hidden="true">
    <span>automatically outputs observations</span>
    <strong>↓</strong>
  </div>

  <div class="bb-checkout-loop__comparison">
    <section class="bb-snippet bb-snippet--catalog" aria-label="Illustrative generated effects file">
      <Code
        code={effectsCode}
        lang="yaml"
        meta={'title="effects.yaml" wrap'}
      />
      <footer class="bb-snippet__meta bb-snippet__meta--catalog">
        <strong>AUTO-GENERATED EFFECTS</strong>
      </footer>
    </section>

    <section class="bb-snippet bb-snippet--terminal" aria-label="Conceptual Blackbox terminal output">
      <div class="bb-terminal">
        <header class="bb-terminal__titlebar" aria-hidden="true">
          <span class="bb-terminal__dots">
            <i></i><i></i><i></i>
          </span>
          <span>Terminal</span>
        </header>

        <div class="bb-terminal__body" role="log" aria-label="Blackbox verification result">
          <div class="bb-terminal__command">
            <span class="bb-terminal__prompt">$</span>
            <span>pnpm exec blackbox test</span>
          </div>

          <div class="bb-terminal__row bb-terminal__row--test">
            <strong>SYSTEM TEST</strong>
            <span>PASS</span>
            <span>201 Created</span>
          </div>

          <div class="bb-terminal__heading">RUNTIME EFFECTS</div>
          <div class="bb-terminal__row bb-terminal__row--effect bb-terminal__row--nested">
            <strong><i aria-hidden="true">├─</i> DATABASE</strong>
            <span>INSERT</span>
            <span>orders <b>× 1</b></span>
          </div>
          <div class="bb-terminal__row bb-terminal__row--effect bb-terminal__row--excess bb-terminal__row--nested">
            <strong><i aria-hidden="true">└─</i> HTTP</strong>
            <span>POST</span>
            <span>/payments/charges <b>× 2</b></span>
          </div>

          <div class="bb-terminal__row bb-terminal__row--finding">
            <strong>BLACKBOX FINDING</strong>
            <span>VIOLATED</span>
          </div>
          <div class="bb-terminal__row bb-terminal__row--approved bb-terminal__row--nested">
            <strong><i aria-hidden="true">├─</i> APPROVED</strong>
            <span>AT MOST 1</span>
            <span>charge request</span>
          </div>
          <div class="bb-terminal__row bb-terminal__row--observed bb-terminal__row--nested">
            <strong><i aria-hidden="true">└─</i> OBSERVED</strong>
            <span>2</span>
            <span>charge requests</span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="bb-checkout-loop__repair">
    <span aria-hidden="true">↳</span>
    <strong>Coding agent repairs the implementation</strong>
    <span>and runs the same requirement again</span>
  </div>

</figure>

<style>
  .bb-checkout-loop {
    --figure-accent: var(--primary-light);
    --figure-info: color-mix(in oklab, var(--info) 52%, var(--text));
    --figure-evidence: color-mix(
      in oklab,
      color-mix(in oklab, var(--brand-mid) 52%, var(--info)) 55%,
      var(--text)
    );
    --figure-success: color-mix(in oklab, var(--success) 44%, var(--text));
    --figure-error: color-mix(in oklab, var(--error) 64%, var(--text));
    width: 100%;
    min-width: 0;
    margin: 24px 0 28px;
  }

  .bb-checkout-loop__files {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
  }

  .bb-checkout-loop__comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: stretch;
  }

  .bb-snippet {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .bb-snippet :global(.expressive-code) {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0;
  }

  .bb-snippet :global(.expressive-code figure) {
    display: flex;
    flex: 1;
    flex-direction: column;
    margin: 0;
  }

  .bb-snippet :global(.expressive-code pre) {
    flex: 1;
  }

  .bb-snippet__meta {
    display: flex;
    min-height: 28px;
    align-items: center;
    gap: 9px;
    margin: 7px 4px 0;
    color: var(--text-soft);
    font-family: var(--font-technical);
    font-size: 0.65rem;
    line-height: 1.4;
    letter-spacing: 0.025em;
  }

  .bb-snippet__meta strong {
    font-weight: 800;
  }

  .bb-snippet__meta--pass strong {
    color: var(--figure-success);
  }

  .bb-snippet__meta--catalog strong {
    color: var(--figure-evidence);
  }

  .bb-snippet--catalog :global(.expressive-code pre) {
    border-bottom-right-radius: 0 !important;
    border-bottom-left-radius: 0 !important;
  }

  .bb-snippet__meta--catalog {
    min-height: 36px;
    margin: -1px 0 0;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-top-color: var(--border);
    border-radius: 0 0 8px 8px;
    background: var(--code-bg);
  }

  .bb-terminal {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--border) 45%, #000);
    border-radius: 8px;
    background: #08090c;
    box-shadow: 0 12px 28px rgb(0 0 0 / 18%);
  }

  .bb-terminal__titlebar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 38px;
    align-items: center;
    padding: 0 13px;
    border-bottom: 1px solid #242730;
    color: #9aa2b1;
    background: #121419;
    font-family: var(--font-interface);
    font-size: 0.69rem;
  }

  .bb-terminal__dots {
    display: flex;
    gap: 6px;
  }

  .bb-terminal__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--text-soft) 55%, #121419);
  }

  .bb-terminal__dots i:first-child {
    background: color-mix(in oklab, var(--error) 82%, white);
  }

  .bb-terminal__dots i:nth-child(2) {
    background: color-mix(in oklab, var(--warning) 78%, white);
  }

  .bb-terminal__dots i:last-child {
    background: color-mix(in oklab, var(--success) 75%, white);
  }

  .bb-terminal__body {
    flex: 1;
    overflow-x: auto;
    padding: 16px 18px 18px;
    color: #d8dee9;
    background: #08090c;
    font-family: var(--font-technical);
    font-size: 0.74rem;
    line-height: 1.65;
  }

  .bb-terminal__command {
    display: flex;
    gap: 1ch;
    margin-bottom: 13px;
    color: #eef2f8;
  }

  .bb-terminal__prompt {
    color: color-mix(in oklab, var(--success) 72%, white);
    font-weight: 800;
  }

  .bb-terminal__row {
    display: grid;
    grid-template-columns: 18ch 11ch minmax(0, 1fr);
    column-gap: 1ch;
    min-width: 0;
  }

  .bb-terminal__row > span:last-child {
    overflow-wrap: anywhere;
  }

  .bb-terminal__row--nested {
    padding-left: 2ch;
  }

  .bb-terminal__row i {
    color: #596273;
    font-style: normal;
  }

  .bb-terminal__row--test {
    margin-bottom: 12px;
  }

  .bb-terminal__row--test > span:nth-child(2) {
    color: color-mix(in oklab, var(--success) 72%, white);
    font-weight: 800;
  }

  .bb-terminal__heading {
    color: color-mix(in oklab, var(--brand-mid) 66%, white);
    font-weight: 800;
  }

  .bb-terminal__row--effect strong {
    color: color-mix(in oklab, var(--info) 65%, white);
  }

  .bb-terminal__row--effect > span:nth-child(2) {
    color: color-mix(in oklab, var(--warning) 70%, white);
  }

  .bb-terminal__row--effect b {
    color: color-mix(in oklab, var(--success) 72%, white);
  }

  .bb-terminal__row--excess b {
    color: color-mix(in oklab, var(--error) 78%, white);
  }

  .bb-terminal__row--finding {
    margin-top: 12px;
  }

  .bb-terminal__row--finding strong,
  .bb-terminal__row--finding > span:nth-child(2),
  .bb-terminal__row--observed > span:nth-child(2) {
    color: color-mix(in oklab, var(--error) 80%, white);
    font-weight: 800;
  }

  .bb-terminal__row--approved strong,
  .bb-terminal__row--approved > span:nth-child(2) {
    color: color-mix(in oklab, var(--brand-mid) 62%, white);
  }

  .bb-terminal__row--observed strong {
    color: color-mix(in oklab, var(--error) 65%, white);
  }

  .bb-checkout-loop__step,
  .bb-checkout-loop__down {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-soft);
    font-family: var(--font-interface);
  }

  .bb-checkout-loop__step {
    flex-direction: column;
    gap: 2px;
    min-height: 52px;
    font-size: 0.62rem;
  }

  .bb-checkout-loop__step strong {
    color: var(--figure-info);
    font-size: 1.1rem;
  }

  .bb-checkout-loop__down {
    flex-direction: column;
    gap: 1px;
    min-height: 52px;
    font-size: 0.69rem;
  }

  .bb-checkout-loop__down strong {
    color: var(--figure-evidence);
    font-size: 1rem;
  }

  .bb-checkout-loop__repair {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    align-items: baseline;
    margin-top: 12px;
    padding: 11px 13px;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text-muted);
    background: color-mix(in oklab, var(--primary-soft) 32%, transparent);
    font-family: var(--font-interface);
    font-size: 0.8rem;
  }

  .bb-checkout-loop__repair > span:first-child,
  .bb-checkout-loop__repair strong {
    color: var(--figure-accent);
  }

  @media (max-width: 720px) {
    .bb-checkout-loop__comparison {
      grid-template-columns: minmax(0, 1fr);
    }

    .bb-checkout-loop__step {
      min-height: 48px;
    }
  }

  @media (max-width: 440px) {
    .bb-snippet__meta {
      flex-wrap: wrap;
    }

    .bb-terminal__body {
      padding: 14px;
      font-size: 0.68rem;
    }

    .bb-terminal__row {
      grid-template-columns: 16ch 9ch minmax(0, 1fr);
    }

    .bb-checkout-loop__repair {
      padding: 10px 12px;
    }
  }
</style>

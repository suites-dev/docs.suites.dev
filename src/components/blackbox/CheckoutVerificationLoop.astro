<script>
  const LOOP_DURATION = 75000;
  const STAGE_DURATION = LOOP_DURATION / 6;

  function initializeBlackboxLoop(root: HTMLElement) {
    if (root.dataset.loopReady === "true") return;
    root.dataset.loopReady = "true";

    const stages = [...root.querySelectorAll<HTMLElement>("[data-loop-stage]")];
    const nav = [...root.querySelectorAll<HTMLButtonElement>("[data-loop-nav]")];
    const play = root.querySelector<HTMLButtonElement>("[data-loop-play]")!;
    const playLabel = root.querySelector<HTMLElement>("[data-loop-play-label]")!;
    const progress = root.querySelector<HTMLElement>("[data-loop-progress]")!;
    const status = root.querySelector<HTMLElement>("[data-loop-status]")!;
    const labels = ["Intent", "Authoring", "Approval", "Test realization", "Evidence and finding", "Repair and rerun"];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    let active = 0;
    let startedAt = 0;
    let pausedAt = 0;
    let frame = 0;
    let playing = false;

    const showStage = (index: number) => {
      active = Math.max(0, Math.min(stages.length - 1, index));
      stages.forEach((stage, stageIndex) => {
        stage.hidden = stageIndex !== active;
      });
      nav.forEach((button, buttonIndex) => {
        if (buttonIndex === active) button.setAttribute("aria-current", "step");
        else button.removeAttribute("aria-current");
      });
      status.textContent = `${labels[active]} · ${active + 1} of ${stages.length}`;
    };

    const stop = (complete = false) => {
      playing = false;
      window.cancelAnimationFrame(frame);
      frame = 0;
      play.removeAttribute("data-playing");
      playLabel.textContent = complete ? "Replay walkthrough" : "Resume walkthrough";
    };

    const tick = (now: number) => {
      const elapsed = Math.min(LOOP_DURATION, now - startedAt);
      const nextStage = Math.min(stages.length - 1, Math.floor(elapsed / STAGE_DURATION));
      showStage(nextStage);
      progress.style.width = `${(elapsed / LOOP_DURATION) * 100}%`;

      if (elapsed >= LOOP_DURATION) {
        pausedAt = LOOP_DURATION;
        stop(true);
        return;
      }
      frame = window.requestAnimationFrame(tick);
    };

    const start = () => {
      if (reducedMotion.matches) {
        const next = (active + 1) % stages.length;
        showStage(next);
        progress.style.width = `${(next / (stages.length - 1)) * 100}%`;
        playLabel.textContent = active === stages.length - 1 ? "Return to intent" : "Next checkpoint";
        return;
      }

      if (active === stages.length - 1 && pausedAt >= LOOP_DURATION) {
        active = 0;
        pausedAt = 0;
        progress.style.width = "0%";
      }
      playing = true;
      startedAt = performance.now() - pausedAt;
      play.setAttribute("data-playing", "true");
      playLabel.textContent = "Pause walkthrough";
      frame = window.requestAnimationFrame(tick);
    };

    play.addEventListener("click", () => {
      if (playing) {
        pausedAt = Math.min(LOOP_DURATION, performance.now() - startedAt);
        stop(false);
      } else {
        start();
      }
    });

    nav.forEach((button, index) => {
      button.addEventListener("click", () => {
        pausedAt = index * STAGE_DURATION;
        showStage(index);
        progress.style.width = `${(index / (stages.length - 1)) * 100}%`;
        if (playing) {
          startedAt = performance.now() - pausedAt;
        } else {
          playLabel.textContent = index === stages.length - 1 ? "Replay walkthrough" : "Play from here";
        }
      });
    });

    showStage(0);
  }

  document.querySelectorAll<HTMLElement>("[data-bb-loop]").forEach(initializeBlackboxLoop);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-bb-loop]").forEach(initializeBlackboxLoop);
  });
</script>


    <text x="197" y="306" text-anchor="middle" fill="#fef3c7" font-size="11" font-weight="800">Contract change? Return to a person for approval.</text>
    <path class="bb-chain-return" d="M936 201C900 310 480 301 374 301" fill="none" stroke="#fbbf24" marker-end="url(#bb-chain-gold-arrow)" />

<figure
  class="bb-evidence-chain"
  aria-label="Blackbox verification chain from accepted intent to runtime evidence and findings"
>
  <svg
    class="bb-evidence-chain__desktop"
    viewBox="0 0 1100 430"
    role="img"
    aria-labelledby="bb-chain-title bb-chain-desc"
    font-family="Inter, ui-sans-serif, system-ui, sans-serif"
  >
    <title id="bb-chain-title">From accepted intent to runtime evidence</title>
    <desc id="bb-chain-desc">
      Human-approved intent expressed in Gherkin becomes accepted meaning in a
      SuitePlan. A system suite provides the declared realization through a RunnerBundle and
      RunPlan. Runtime correlates OpenTelemetry observations with a fresh
      attempt, normalizes eligible effects, and seals the evidence with its
      integrity facts. The Analyzer returns separate findings, which guide
      implementation repair while changes to accepted meaning return to a person.
    </desc>
    <defs>
      <marker
        id="bb-chain-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="#94a3b8"></path>
      </marker>
    </defs>

    <rect x="1" y="1" width="1098" height="428" rx="14" fill="#0b1120" stroke="#334155"></rect>
    <text x="30" y="39" fill="#f8fafc" font-size="19" font-weight="800">
      Accepted intent becomes runtime evidence
    </text>
    <text x="30" y="62" fill="#cbd5e1" font-size="11.5">
      Each stage keeps one responsibility from silently changing another.
    </text>

    <g>
      <rect x="28" y="92" width="184" height="142" rx="10" fill="#1e1b4b" stroke="#a78bfa"></rect>
      <text x="120" y="119" text-anchor="middle" fill="#c4b5fd" font-size="9.5" font-weight="800">
        ACCEPTED BEHAVIOR
      </text>
      <text x="120" y="151" text-anchor="middle" fill="#f8fafc" font-size="15" font-weight="800">
        Gherkin
      </text>
      <text x="120" y="176" text-anchor="middle" fill="#ddd6fe" font-size="11.5" font-weight="700">
        SuitePlan
      </text>
      <text x="120" y="202" text-anchor="middle" fill="#cbd5e1" font-size="9.5">
        person approves meaning
      </text>
    </g>

    <line x1="212" y1="163" x2="238" y2="163" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-arrow)"></line>

    <g>
      <rect x="244" y="92" width="184" height="142" rx="10" fill="#172554" stroke="#60a5fa"></rect>
      <text x="336" y="119" text-anchor="middle" fill="#93c5fd" font-size="9.5" font-weight="800">
        DECLARED REALIZATION
      </text>
      <text x="336" y="151" text-anchor="middle" fill="#f8fafc" font-size="14" font-weight="800">
        System suite
      </text>
      <text x="336" y="176" text-anchor="middle" fill="#bfdbfe" font-size="10.5" font-weight="700">
        RunnerBundle
      </text>
      <text x="336" y="202" text-anchor="middle" fill="#cbd5e1" font-size="9.5">
        RunPlan selects it
      </text>
    </g>

    <line x1="428" y1="163" x2="454" y2="163" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-arrow)"></line>

    <g>
      <rect x="460" y="92" width="184" height="142" rx="10" fill="#102a23" stroke="#34d399"></rect>
      <text x="552" y="119" text-anchor="middle" fill="#6ee7b7" font-size="9.5" font-weight="800">
        FRESH EXECUTION
      </text>
      <text x="552" y="151" text-anchor="middle" fill="#f8fafc" font-size="15" font-weight="800">
        Runtime attempt
      </text>
      <text x="552" y="176" text-anchor="middle" fill="#a7f3d0" font-size="10" font-weight="700">
        OpenTelemetry observations
      </text>
      <text x="552" y="202" text-anchor="middle" fill="#cbd5e1" font-size="9.5">
        fresh capture + identity
      </text>
    </g>

    <line x1="644" y1="163" x2="670" y2="163" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-arrow)"></line>

    <g>
      <rect x="676" y="92" width="184" height="142" rx="10" fill="#12251e" stroke="#4ade80"></rect>
      <text x="768" y="119" text-anchor="middle" fill="#86efac" font-size="9.5" font-weight="800">
        SEALED EVIDENCE
      </text>
      <text x="768" y="151" text-anchor="middle" fill="#f8fafc" font-size="15" font-weight="800">
        Normalized effects
      </text>
      <text x="768" y="176" text-anchor="middle" fill="#bbf7d0" font-size="10.5" font-weight="700">
        raw capture + integrity
      </text>
      <text x="768" y="202" text-anchor="middle" fill="#cbd5e1" font-size="9.5">
        facts before judgment
      </text>
    </g>

    <line x1="860" y1="163" x2="886" y2="163" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-arrow)"></line>

    <g>
      <rect x="892" y="92" width="180" height="142" rx="10" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="982" y="119" text-anchor="middle" fill="#fde68a" font-size="9.5" font-weight="800">
        FINDINGS
      </text>
      <text x="982" y="151" text-anchor="middle" fill="#f8fafc" font-size="15" font-weight="800">
        Analyzer
      </text>
      <text x="982" y="176" text-anchor="middle" fill="#fef3c7" font-size="10.5" font-weight="700">
        integrity + effects
      </text>
      <text x="982" y="202" text-anchor="middle" fill="#cbd5e1" font-size="9.5">
        ODC is experimental
      </text>
    </g>

    <rect x="66" y="276" width="968" height="56" rx="9" fill="#102a23" stroke="#22c55e"></rect>
    <text x="550" y="299" text-anchor="middle" fill="#bbf7d0" font-size="11.5" font-weight="800">
      Finding → agent repairs implementation → run the same accepted behavior again
    </text>
    <text x="550" y="319" text-anchor="middle" fill="#cbd5e1" font-size="9.5">
      The repair loop moves quickly because the target stays fixed.
    </text>

    <rect x="66" y="350" width="968" height="52" rx="9" fill="#2e1065" stroke="#8b5cf6"></rect>
    <text x="550" y="381" text-anchor="middle" fill="#ede9fe" font-size="11" font-weight="800">
      Change accepted behavior or analysis policy → return to a person
    </text>
  </svg>

  <svg
    class="bb-evidence-chain__mobile"
    viewBox="0 0 420 900"
    role="img"
    aria-labelledby="bb-chain-mobile-title bb-chain-mobile-desc"
    font-family="Inter, ui-sans-serif, system-ui, sans-serif"
  >
    <title id="bb-chain-mobile-title">From accepted intent to runtime evidence</title>
    <desc id="bb-chain-mobile-desc">
      Accepted Gherkin becomes a SuitePlan, then a declared system realization,
      OpenTelemetry observations from a fresh runtime attempt, normalized and
      sealed effect evidence, and Analyzer findings. Findings guide agent repair
      while changes to accepted meaning return to a person.
    </desc>
    <defs>
      <marker
        id="bb-chain-mobile-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="#94a3b8"></path>
      </marker>
    </defs>

    <rect x="1" y="1" width="418" height="898" rx="14" fill="#0b1120" stroke="#334155"></rect>
    <text x="24" y="34" fill="#f8fafc" font-size="16" font-weight="800">
      Intent becomes evidence
    </text>
    <text x="24" y="55" fill="#cbd5e1" font-size="9.5">
      One responsibility at every stage
    </text>

    <g>
      <rect x="24" y="78" width="372" height="104" rx="9" fill="#1e1b4b" stroke="#a78bfa"></rect>
      <text x="44" y="104" fill="#c4b5fd" font-size="9" font-weight="800">ACCEPTED BEHAVIOR</text>
      <text x="44" y="133" fill="#f8fafc" font-size="14" font-weight="800">Gherkin → SuitePlan</text>
      <text x="44" y="158" fill="#cbd5e1" font-size="9.5">A person approves the meaning.</text>
    </g>
    <line x1="210" y1="182" x2="210" y2="204" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-mobile-arrow)"></line>

    <g>
      <rect x="24" y="210" width="372" height="104" rx="9" fill="#172554" stroke="#60a5fa"></rect>
      <text x="44" y="236" fill="#93c5fd" font-size="9" font-weight="800">DECLARED REALIZATION</text>
      <text x="44" y="265" fill="#f8fafc" font-size="14" font-weight="800">System suite → RunnerBundle</text>
      <text x="44" y="290" fill="#cbd5e1" font-size="9.5">RunPlan selects the declared realization.</text>
    </g>
    <line x1="210" y1="314" x2="210" y2="336" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-mobile-arrow)"></line>

    <g>
      <rect x="24" y="342" width="372" height="104" rx="9" fill="#102a23" stroke="#34d399"></rect>
      <text x="44" y="368" fill="#6ee7b7" font-size="9" font-weight="800">FRESH EXECUTION</text>
      <text x="44" y="397" fill="#f8fafc" font-size="14" font-weight="800">OpenTelemetry observations</text>
      <text x="44" y="422" fill="#cbd5e1" font-size="9.5">One fresh runtime attempt and identity.</text>
    </g>
    <line x1="210" y1="446" x2="210" y2="468" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-mobile-arrow)"></line>

    <g>
      <rect x="24" y="474" width="372" height="104" rx="9" fill="#12251e" stroke="#4ade80"></rect>
      <text x="44" y="500" fill="#86efac" font-size="9" font-weight="800">SEALED EVIDENCE</text>
      <text x="44" y="529" fill="#f8fafc" font-size="14" font-weight="800">Normalized effects + integrity</text>
      <text x="44" y="554" fill="#cbd5e1" font-size="9.5">Raw capture is sealed before judgment.</text>
    </g>
    <line x1="210" y1="578" x2="210" y2="600" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-mobile-arrow)"></line>

    <g>
      <rect x="24" y="606" width="372" height="104" rx="9" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="44" y="632" fill="#fde68a" font-size="9" font-weight="800">FINDINGS</text>
      <text x="44" y="661" fill="#f8fafc" font-size="14" font-weight="800">Analyzer</text>
      <text x="44" y="686" fill="#cbd5e1" font-size="9.5">Integrity + effects; ODC is experimental.</text>
    </g>

    <rect x="24" y="742" width="372" height="64" rx="9" fill="#102a23" stroke="#22c55e"></rect>
    <text x="210" y="769" text-anchor="middle" fill="#bbf7d0" font-size="10" font-weight="800">
      Finding → agent repair → run again
    </text>
    <text x="210" y="791" text-anchor="middle" fill="#cbd5e1" font-size="8.5">
      The accepted target stays fixed.
    </text>

    <rect x="24" y="824" width="372" height="52" rx="9" fill="#2e1065" stroke="#8b5cf6"></rect>
    <text x="210" y="855" text-anchor="middle" fill="#ede9fe" font-size="9.5" font-weight="800">
      Change the target → return to a person
    </text>
  </svg>

  <figcaption>
    <strong>SuitePlan</strong> preserves accepted meaning. <strong>RunnerBundle</strong>
    realizes it. <strong>RunPlan</strong> selects it. Runtime correlates
    OpenTelemetry observations with one fresh execution, normalizes eligible
    effects, and seals the evidence before the Analyzer computes findings.
  </figcaption>
</figure>

<style>
  .bb-evidence-chain {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 24px 0 32px;
  }

  .bb-evidence-chain__desktop {
    display: block;
    width: 100%;
    height: auto;
  }

  .bb-evidence-chain__mobile {
    display: none;
    width: 100%;
    height: auto;
  }

  .bb-evidence-chain figcaption {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.55;
    text-align: center;
  }

  @media (max-width: 680px) {
    .bb-evidence-chain__desktop {
      display: none;
    }

    .bb-evidence-chain__mobile {
      display: block;
    }
  }
</style>

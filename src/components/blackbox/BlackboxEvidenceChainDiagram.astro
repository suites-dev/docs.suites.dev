<style>
  .bb-evidence-chain {
    width: 100%;
    min-width: 0;
    margin: 24px 0 32px;
  }

  .bb-evidence-chain svg {
    width: 100%;
    height: auto;
    font-family: "Hanken Grotesk Local", "Hanken Grotesk", Inter, ui-sans-serif, system-ui, sans-serif;
  }

  .bb-evidence-chain__desktop { display: block; }
  .bb-evidence-chain__mobile { display: none; }

  .bb-chain-flow,
  .bb-chain-return {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .bb-chain-flow {
    stroke-dasharray: 4 4;
    animation: bb-chain-drift 1.7s linear infinite;
  }

  .bb-chain-return {
    stroke-dasharray: 7 6;
    animation: bb-chain-drift 2.3s linear infinite;
  }

  .bb-evidence-chain figcaption {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 13px;
    line-height: 1.5;
    text-align: center;
  }

  @keyframes bb-chain-drift {
    to { stroke-dashoffset: -16; }
  }

  @media (max-width: 680px) {
    .bb-evidence-chain__desktop { display: none; }
    .bb-evidence-chain__mobile { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .bb-evidence-chain * {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

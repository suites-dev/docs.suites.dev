<figure
  class="bb-evidence-chain"
  aria-label="Blackbox verification chain from approved behavior to a deterministic finding"
>
  <svg
    class="bb-evidence-chain__desktop"
    viewBox="0 0 1100 144"
    role="img"
    aria-labelledby="bb-chain-title bb-chain-desc"
    font-family="'Hanken Grotesk Local', 'Hanken Grotesk', Inter, ui-sans-serif, system-ui, sans-serif"
  >
    <title id="bb-chain-title">One Blackbox verification chain</title>
    <desc id="bb-chain-desc">
      Person-approved behavior expressed through Gherkin or direct declarations
      guides a selected system or end-to-end test. Each execution gets a fresh
      capture boundary. OpenTelemetry observations and assurance control facts
      become eligible evidence. Analysis returns the same finding when its
      approved inputs and evidence are unchanged.
    </desc>
    <defs>
      <marker
        id="bb-chain-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="#94a3b8"></path>
      </marker>
    </defs>

    <g>
      <rect x="1" y="1" width="200" height="142" rx="10" fill="#421622" stroke="#db486f"></rect>
      <text x="101" y="29" text-anchor="middle" fill="#ef9dab" font-size="11" font-weight="800">
        APPROVED INTENT
      </text>
      <text x="101" y="63" text-anchor="middle" fill="#f8fafc" font-size="17" font-weight="800">
        Approved behavior
      </text>
      <text x="101" y="91" text-anchor="middle" fill="#f6c9d1" font-size="13" font-weight="700">
        Gherkin or direct
      </text>
      <text x="101" y="117" text-anchor="middle" fill="#cbd5e1" font-size="11">
        approved by a person
      </text>
    </g>

    <line x1="201" y1="72" x2="219" y2="72" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-arrow)"></line>

    <g>
      <rect x="225" y="1" width="200" height="142" rx="10" fill="#172554" stroke="#60a5fa"></rect>
      <text x="325" y="29" text-anchor="middle" fill="#93c5fd" font-size="11" font-weight="800">
        EXECUTABLE FLOW
      </text>
      <text x="325" y="63" text-anchor="middle" fill="#f8fafc" font-size="16" font-weight="800">
        System or E2E test
      </text>
      <text x="325" y="91" text-anchor="middle" fill="#bfdbfe" font-size="13" font-weight="700">
        concrete actions
      </text>
      <text x="325" y="117" text-anchor="middle" fill="#cbd5e1" font-size="11">
        declared test is selected
      </text>
    </g>

    <line x1="425" y1="72" x2="443" y2="72" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-arrow)"></line>

    <g>
      <rect x="449" y="1" width="200" height="142" rx="10" fill="#102a23" stroke="#34d399"></rect>
      <text x="549" y="29" text-anchor="middle" fill="#6ee7b7" font-size="11" font-weight="800">
        FRESH ATTEMPT
      </text>
      <text x="549" y="63" text-anchor="middle" fill="#f8fafc" font-size="16" font-weight="800">
        Traces + control
      </text>
      <text x="549" y="91" text-anchor="middle" fill="#a7f3d0" font-size="13" font-weight="700">
        observed work + lifecycle
      </text>
      <text x="549" y="117" text-anchor="middle" fill="#cbd5e1" font-size="11">
        one capture boundary
      </text>
    </g>

    <line x1="649" y1="72" x2="667" y2="72" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-arrow)"></line>

    <g>
      <rect x="673" y="1" width="200" height="142" rx="10" fill="#12251e" stroke="#4ade80"></rect>
      <text x="773" y="29" text-anchor="middle" fill="#86efac" font-size="11" font-weight="800">
        ELIGIBLE EVIDENCE
      </text>
      <text x="773" y="63" text-anchor="middle" fill="#f8fafc" font-size="17" font-weight="800">
        Effects + limits
      </text>
      <text x="773" y="91" text-anchor="middle" fill="#bbf7d0" font-size="13" font-weight="700">
        evidence fixed for analysis
      </text>
      <text x="773" y="117" text-anchor="middle" fill="#cbd5e1" font-size="11">
        limits are recorded
      </text>
    </g>

    <line x1="873" y1="72" x2="891" y2="72" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-arrow)"></line>

    <g>
      <rect x="897" y="1" width="202" height="142" rx="10" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="998" y="29" text-anchor="middle" fill="#fde68a" font-size="11" font-weight="800">
        ANALYSIS
      </text>
      <text x="998" y="63" text-anchor="middle" fill="#f8fafc" font-size="17" font-weight="800">
        Finding
      </text>
      <text x="998" y="91" text-anchor="middle" fill="#fef3c7" font-size="13" font-weight="700">
        same inputs, same result
      </text>
      <text x="998" y="117" text-anchor="middle" fill="#cbd5e1" font-size="11">
        one of five verdicts
      </text>
    </g>
  </svg>

  <svg
    class="bb-evidence-chain__mobile"
    viewBox="0 0 420 634"
    role="img"
    aria-labelledby="bb-chain-mobile-title bb-chain-mobile-desc"
    font-family="'Hanken Grotesk Local', 'Hanken Grotesk', Inter, ui-sans-serif, system-ui, sans-serif"
  >
    <title id="bb-chain-mobile-title">One Blackbox verification chain</title>
    <desc id="bb-chain-mobile-desc">
      Person-approved behavior expressed through Gherkin or direct declarations
      guides a selected system or end-to-end test. A fresh attempt produces
      OpenTelemetry observations and assurance control facts. Blackbox records
      eligible effects and evidence limits, then returns a deterministic finding.
    </desc>
    <defs>
      <marker
        id="bb-chain-mobile-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto"
      >
        <path d="M0 0 L10 5 L0 10 z" fill="#94a3b8"></path>
      </marker>
    </defs>

    <g>
      <rect x="1" y="1" width="418" height="104" rx="9" fill="#421622" stroke="#db486f"></rect>
      <text x="20" y="28" fill="#ef9dab" font-size="11" font-weight="800">APPROVED INTENT</text>
      <text x="20" y="59" fill="#f8fafc" font-size="17" font-weight="800">Approved behavior</text>
      <text x="20" y="84" fill="#cbd5e1" font-size="12">Gherkin or direct declarations reviewed by a person.</text>
    </g>
    <line x1="210" y1="105" x2="210" y2="127" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-mobile-arrow)"></line>

    <g>
      <rect x="1" y="133" width="418" height="104" rx="9" fill="#172554" stroke="#60a5fa"></rect>
      <text x="20" y="160" fill="#93c5fd" font-size="11" font-weight="800">EXECUTABLE FLOW</text>
      <text x="20" y="191" fill="#f8fafc" font-size="16" font-weight="800">Selected system or E2E test</text>
      <text x="20" y="216" fill="#cbd5e1" font-size="12">Concrete actions against the running system.</text>
    </g>
    <line x1="210" y1="237" x2="210" y2="259" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-mobile-arrow)"></line>

    <g>
      <rect x="1" y="265" width="418" height="104" rx="9" fill="#102a23" stroke="#34d399"></rect>
      <text x="20" y="292" fill="#6ee7b7" font-size="11" font-weight="800">FRESH ATTEMPT</text>
      <text x="20" y="323" fill="#f8fafc" font-size="16" font-weight="800">Traces and control facts</text>
      <text x="20" y="348" fill="#cbd5e1" font-size="12">Observed work and lifecycle in one fresh boundary.</text>
    </g>
    <line x1="210" y1="369" x2="210" y2="391" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-mobile-arrow)"></line>

    <g>
      <rect x="1" y="397" width="418" height="104" rx="9" fill="#12251e" stroke="#4ade80"></rect>
      <text x="20" y="424" fill="#86efac" font-size="11" font-weight="800">ELIGIBLE EVIDENCE</text>
      <text x="20" y="455" fill="#f8fafc" font-size="17" font-weight="800">Effects + limits</text>
      <text x="20" y="480" fill="#cbd5e1" font-size="12">Evidence is fixed and its limits are recorded.</text>
    </g>
    <line x1="210" y1="501" x2="210" y2="523" stroke="#94a3b8" stroke-width="2" marker-end="url(#bb-chain-mobile-arrow)"></line>

    <g>
      <rect x="1" y="529" width="418" height="104" rx="9" fill="#3b2f0b" stroke="#fbbf24"></rect>
      <text x="20" y="556" fill="#fde68a" font-size="11" font-weight="800">ANALYSIS</text>
      <text x="20" y="587" fill="#f8fafc" font-size="17" font-weight="800">Deterministic finding</text>
      <text x="20" y="612" fill="#cbd5e1" font-size="12">The same approved inputs and evidence return the same result.</text>
    </g>
  </svg>
</figure>

<style>
  .bb-evidence-chain {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    margin: 24px 0 32px;
  }

  .bb-evidence-chain__desktop {
    display: block;
    width: 100%;
    height: auto;
  }

  .bb-evidence-chain__mobile {
    display: none;
    width: 100%;
    height: auto;
  }

  @media (max-width: 680px) {
    .bb-evidence-chain__desktop {
      display: none;
    }

    .bb-evidence-chain__mobile {
      display: block;
    }
  }
</style>

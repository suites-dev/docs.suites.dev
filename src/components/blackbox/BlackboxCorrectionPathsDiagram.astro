<figure
  class="bb-correction-paths"
  aria-label="Blackbox correction paths for implementation repair and changes to the behavioral contract"
>
  <svg
    class="bb-correction-paths__desktop"
    viewBox="0 0 1100 126"
    role="img"
    aria-labelledby="bb-correction-paths-title bb-correction-paths-desc"
    font-family="'Hanken Grotesk Local', 'Hanken Grotesk', Inter, ui-sans-serif, system-ui, sans-serif"
  >
    <title id="bb-correction-paths-title">Two Blackbox correction paths</title>
    <desc id="bb-correction-paths-desc">
      Findings return to the agent for implementation repair and another run of
      the same behavioral contract. Changes to the behavioral contract or analysis
      policy return to a person.
    </desc>

    <rect x="1" y="1" width="1098" height="66" rx="9" fill="#102a23" stroke="#22c55e"></rect>
    <text x="550" y="28" text-anchor="middle" fill="#bbf7d0" font-size="15.5" font-weight="800">
      Finding → agent repairs implementation → run the same behavioral contract again
    </text>
    <text x="550" y="52" text-anchor="middle" fill="#cbd5e1" font-size="12">
      The repair loop moves quickly because the target stays fixed.
    </text>

    <rect x="1" y="80" width="1098" height="44" rx="9" fill="#421622" stroke="#db486f"></rect>
    <text x="550" y="108" text-anchor="middle" fill="#fbe6ea" font-size="14.5" font-weight="800">
      Change the behavioral contract or analysis policy → return to a person
    </text>
  </svg>

  <svg
    class="bb-correction-paths__mobile"
    viewBox="0 0 420 190"
    role="img"
    aria-labelledby="bb-correction-paths-mobile-title bb-correction-paths-mobile-desc"
    font-family="'Hanken Grotesk Local', 'Hanken Grotesk', Inter, ui-sans-serif, system-ui, sans-serif"
  >
    <title id="bb-correction-paths-mobile-title">Two Blackbox correction paths</title>
    <desc id="bb-correction-paths-mobile-desc">
      Findings return to the agent for implementation repair and another run of
      the same behavioral contract. Changes to the behavioral contract or analysis
      policy return to a person.
    </desc>

    <rect x="1" y="1" width="418" height="98" rx="9" fill="#102a23" stroke="#22c55e"></rect>
    <text x="210" y="31" text-anchor="middle" fill="#bbf7d0" font-size="15.5" font-weight="800">
      <tspan x="210">Finding → agent repairs implementation →</tspan>
      <tspan x="210" dy="22">run the same behavioral contract again</tspan>
    </text>
    <text x="210" y="84" text-anchor="middle" fill="#cbd5e1" font-size="12">
      The target stays fixed during repair.
    </text>

    <rect x="1" y="112" width="418" height="76" rx="9" fill="#421622" stroke="#db486f"></rect>
    <text x="210" y="143" text-anchor="middle" fill="#fbe6ea" font-size="15" font-weight="800">
      <tspan x="210">Change the behavioral contract or analysis policy →</tspan>
      <tspan x="210" dy="22">return to a person</tspan>
    </text>
  </svg>
</figure>

